{
  "name": "mailu-mcp",
  "description": "Mailu mail MCP server — IMAP/SMTP/Admin via HTTP transport",
  "category": "app",
  "docker": {
    "image": "mailu-mcp",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/mailu-mcp"
  },
  "proxy": {
    "upstream": "mailu-mcp.app:3103",
    "streaming": true,
    "type": "path",
    "parent_domain": "mcp.diegonmarcos.com",
    "base_path": "/mailu-mcp"
  }
}
