{
  "name": "ollama",
  "description": "Ollama LLM Server — DeepSeek/Qwen 14B on GCP Spot T4 + Vast.ai fallback",
  "category": "agi",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "gcp-t4",
    "remote_path": "/opt/containers/ollama",
    "fallback_host": "vast-ollama",
    "compose_flags": "--build"
  },
  "ports": {
    "app": 11434
  },
  "dns": "ollama.app",
  "models": [
    "deepseek-r1:14b",
    "qwen2.5:14b"
  ],
  "notes": "Primary: GCP Spot T4. Fallback: Vast.ai on-demand. WireGuard only (10.0.0.8).",
  "containers": {
    "app": {
      "container_name": "ollama",
      "image": "ollama/ollama:latest",
      "port": 11434,
      "port_env": "OLLAMA_HOST",
      "dns": "ollama.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "ollama_data:/root/.ollama"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "gpu": {
          "driver": "nvidia",
          "count": 1,
          "capabilities": [
            "gpu"
          ]
        }
      },
      "read_only": false,
      "port_format": "host",
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "ollama",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "endpoint_count": 16,
    "display_name": "Ollama LLM API (gcp-t4)",
    "description": "REST API for LLM inference, embeddings, model management, and version information.",
    "auth": "none"
  }
}
