FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssh-client iputils-ping curl git python3 build-essential dnsutils openssl netcat-openbsd && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY code /app
RUN npm ci --omit=dev



LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud"
CMD ["./entrypoint.sh"]
