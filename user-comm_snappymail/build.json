{
  "name": "snappymail",
  "description": "SnappyMail webmail client (mail.diegonmarcos.com/webmail)",
  "dns": "snappymail.app",
  "ports": {
    "app": 8888
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "webmail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/snappymail",
    "excludes": [
      "data/**"
    ],
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "configs/init.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "snappymail-binaries",
    "dockerfile": "code/amd64/Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "_repromoted_2026-07-09": "webmail.diegonmarcos.com re-promoted to SnappyMail. It was demoted 2026-04-27 for a Cypht (user-comm_cypht) handoff that was never finished — Cypht has no build.json/src, so no route was ever emitted and the domain orphaned to the Caddy catch-all (200 wormhole). SnappyMail is healthy on oci-mail; restored primary per the demote note.",
    "primary": {
      "domain": "webmail.diegonmarcos.com",
      "auth": "two_factor",
      "landing_page": "mymail"
    }
  },
  "containers": {
    "app": {
      "container_name": "snappymail",
      "image": "djmaze/snappymail:latest",
      "port": 8888,
      "port_env": null,
      "dns": "snappymail.app",
      "public": true,
      "proxy": null,
      "healthcheck": "/",
      "monitoring": null,
      "volumes": [
        "./data:/var/lib/snappymail"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M",
        "mem_reservation": "16M"
      },
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/var/lib/snappymail"
        }
      ]
    }
  },
  "upstream_image": "djmaze/snappymail:latest",
  "resources": {
    "mem_limit": "64M",
    "mem_reservation": "16M"
  }
}
