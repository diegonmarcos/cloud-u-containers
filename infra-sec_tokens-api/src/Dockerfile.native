FROM python:3.11-slim

WORKDIR /app
COPY code /app
COPY build.json /app/build.json
RUN pip install --no-cache-dir -r requirements.txt
RUN id -u appuser >/dev/null 2>&1 || useradd -r -m -u 10001 appuser
RUN mkdir -p /data && chown appuser /data
USER appuser
ENV HOME=/home/appuser

LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud-u-containers"
CMD ["gunicorn","--bind","127.0.0.1:4184","--workers","1","--threads","4","--timeout","30","main:app"]
