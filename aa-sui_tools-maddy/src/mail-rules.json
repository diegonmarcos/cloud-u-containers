{
  "sieve_require": ["fileinto", "imap4flags", "mailbox", "envelope", "mime"],
  "account": "me@diegonmarcos.com",

  "folders": {
    "development": "\ud83c\udf93 Development & Tech",
    "career": "\ud83d\udcbc Career & Network",
    "lifestyle": "\u2708\ufe0f Lifestyle & Logistics",
    "admin": "\ud83d\udee1\ufe0f Admin & Finance",
    "information": "\ud83d\udcf0 Information & Feeds",
