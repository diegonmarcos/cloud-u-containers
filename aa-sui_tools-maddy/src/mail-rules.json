  "routing_default": "\ud83d\udce6 Others",

  "tags": [
    {
      "id": "B1",
      "name": "\ud83c\udf93 Development, Education & Tools",
      "rules": [
        { "type": "from_domain", "values": ["42berlin.de"], "flag": "Dev_context:42Berlin" },
        { "type": "header_contains", "header": "Subject", "values": ["evaluation", "evaluaci", "peer review", "correction"], "flag": "Dev_context:42Evaluations" },
        { "type": "from_domain", "values": ["github.com"], "flag": "Dev_platform:GitHub" },
        { "type": "from_domain", "values": ["gitlab.com"], "flag": "Dev_platform:GitLab" },
        { "type": "header_contains", "header": "Subject", "values": ["pull request", "merge request", "[PR]", "Review requested"], "flag": "Dev_type:PullRequest" },
        { "type": "from_domain", "values": ["vercel.com", "netlify.com", "railway.app", "heroku.com", "notion.so", "figma.com", "miro.com"], "flag": "SaaS_Productivity" },
        { "type": "from_domain", "values": ["jetbrains.com", "adobe.com", "canva.com"], "flag": "SaaS_Creative" },
        { "type": "from_domain", "values": ["duolingo.com", "babbel.com", "busuu.com"], "flag": "Edu_Languages" },
        { "type": "from_domain", "values": ["udemy.com", "coursera.org", "edx.org", "skillshare.com", "pluralsight.com"], "flag": "Edu_General" }
      ]
    },
    {
      "id": "B2",
      "name": "\ud83d\udcbc Career & Networking",
      "rules": [
        { "type": "from_domain", "values": ["glassdoor.com", "xing.com", "stepstone.de", "hired.com", "wellfound.com"], "flag": "Career_JobAlerts" },
        { "type": "from_domain", "values": ["linkedin.com"], "flag": "Career_source:LinkedIn" },
        { "type": "from_domain", "values": ["indeed.com", "indeed.de"], "flag": "Career_source:Indeed" },
        { "type": "header_contains", "header": "Subject", "values": ["application", "candidatura", "Bewerbung", "your application", "application status"], "flag": "Career_type:Application_Update" },
        { "type": "header_contains", "header": "Subject", "values": ["interview", "entrevista", "Vorstellungsgespr", "schedule a call", "phone screen"], "flag": "Career_type:Interview_Invite" },
        { "type": "header_contains", "header": "Subject", "values": ["recruiter", "headhunt", "opportunity", "we found your profile", "job match", "talent"], "flag": "Career_type:Recruiter_Message" }
      ]
    },
    {
      "id": "B3",
      "name": "\u2708\ufe0f Lifestyle, Travel & Logistics",
      "rules": [
        { "type": "from_domain", "values": ["ryanair.com", "easyjet.com", "vueling.com", "flixbus.com", "renfe.com", "iberia.com", "lufthansa.com", "klm.com"], "flag": "Travel_type:Flight" },
        { "type": "from_domain", "values": ["uber.com", "bolt.eu", "freenow.com", "blablacar.com", "lyft.com"], "flag": "Travel_type:Rideshare" },
        { "type": "from_domain", "values": ["airbnb.com"], "flag": "Lodging_from:Airbnb" },
        { "type": "from_domain", "values": ["hostelworld.com"], "flag": "Lodging_from:Hostelworld" },
        { "type": "from_domain", "values": ["idealista.com", "immobilienscout24.de", "immowelt.de", "fotocasa.es", "pisos.com"], "flag": "Housing_RealEstate" },
        { "type": "from_domain", "values": ["dhl.com", "dhl.de", "ups.com", "fedex.com", "correos.es", "dpd.com", "gls-group.com", "seur.com", "mrw.es"], "flag": "Logistics_Postal_Courier" },
        { "type": "from_domain", "values": ["deliveroo.com", "ubereats.com", "glovo.com", "justeat.com", "lieferando.de", "doordash.com"], "flag": "Lifestyle_FoodDelivery" },
        { "type": "from_domain", "values": ["doctolib.de", "doctolib.com", "gympass.com", "freeletics.com", "strava.com"], "flag": "Lifestyle_Wellness_Sports" },
        { "type": "from_domain", "values": ["eventbrite.com", "meetup.com", "ticketmaster.com", "dice.fm", "stubhub.com"], "flag": "Lifestyle_Leisure" },
        { "type": "from_domain", "values": ["tinder.com", "bumble.com", "hinge.co", "okcupid.com"], "flag": "Social_Dating" }
      ]
    },
    {
      "id": "B4",
      "name": "\ud83d\udee1\ufe0f Admin, Finance & E-commerce",
      "rules": [
        { "type": "from_domain", "values": ["paypal.com", "stripe.com"], "flag": "Fin_type:Receipt" },
        { "type": "header_contains", "header": "Subject", "values": ["invoice", "factura", "Rechnung", "billing statement"], "flag": "Fin_type:Invoice" },
        { "type": "from_domain", "values": ["apple.com", "spotify.com", "netflix.com", "adobe.com"], "flag": "Fin_type:Subscription" },
        { "type": "from_domain", "values": ["allianz.com", "axa.com", "mapfre.com", "huk.de"], "flag": "Fin_type:Insurance" },
        { "type": "from_domain", "values": ["n26.com", "revolut.com", "wise.com", "ing.es", "ing.de", "commerzbank.de", "deutschebank.de"], "flag": "Fin_entity:Bank" },
        { "type": "from_domain", "values": ["elster.de", "agenciatributaria.es", "tax.service.gov.uk"], "flag": "Fin_entity:Tax" },
        { "type": "from_domain", "values": ["amazon.com", "amazon.de", "amazon.es", "ebay.com", "ebay.de", "aliexpress.com", "zalando.de"], "flag": "Shopping_Online" },
        { "type": "from_domain", "values": ["bitwarden.com", "1password.com", "accounts.google.com", "noreply.github.com"], "flag": "Sec_type:Login_Alert" },
        { "type": "header_contains", "header": "Subject", "values": ["GDPR", "Datenschutz", "privacy policy", "data protection", "data subject"], "flag": "Admin_Compliance:GDPR" },
        { "type": "header_contains", "header": "Subject", "values": ["review requested", "action required", "requires your attention", "please review"], "flag": "Action_ReviewRequested" }
      ]
    },
    {
      "id": "B5",
      "name": "\ud83d\udcf0 Information, Media & Feeds",
      "rules": [
        { "type": "from_domain", "values": ["dev.to", "hashnode.com", "hackernews.com", "theregister.com", "arstechnica.com"], "flag": "Read_topic:Tech" },
        { "type": "from_domain", "values": ["bbc.com", "reuters.com", "elpais.com", "spiegel.de", "theguardian.com", "nytimes.com"], "flag": "Read_type:News" },
        { "type": "from_domain", "values": ["substack.com", "medium.com", "beehiiv.com", "revue.email"], "flag": "Read_type:Magazine" },
        { "type": "from_domain", "values": ["spotify.com", "soundcloud.com", "bandcamp.com"], "flag": "Media_Music" },
        { "type": "from_domain", "values": ["netflix.com", "youtube.com", "twitch.tv", "hbomax.com", "disneyplus.com", "primevideo.com"], "flag": "Media_TV" },
        { "type": "from_domain", "values": ["goodreads.com", "kindle.amazon.com", "audible.com"], "flag": "Media_Books" },
        { "type": "from_domain", "values": ["steampowered.com", "epicgames.com", "gog.com", "playstation.com", "xbox.com", "nintendo.com"], "flag": "Media_Games" },
        { "type": "from_domain", "values": ["twitter.com", "x.com", "mastodon.social", "facebook.com", "instagram.com", "whatsapp.com", "reddit.com"], "flag": "Social_Notification" },
        { "type": "header_contains", "header": "Subject", "values": ["% off", "sale", "discount", "promo", "deal", "oferta", "descuento", "Rabatt"], "flag": "Promo_Occasional" }
      ]
    },
    {
      "id": "B6",
      "name": "\u2601\ufe0f Cloud (Homelab) Management",
      "rules": [
        { "type": "header_contains", "header": "Subject", "values": ["[alert]", "[warning]", "is down", "unreachable", "uptime"], "flag": "Cloud_Ops:Uptime_Alert" },
        { "type": "header_contains", "header": "Subject", "values": ["backup", "restic", "snapshot", "restore"], "flag": "Cloud_Ops:Backup_Status" },
        { "type": "header_contains", "header": "Subject", "values": ["disk full", "storage", "quota", "low space", "inode"], "flag": "Cloud_Ops:Storage_Warning" },
        { "type": "header_contains", "header": "Subject", "values": ["login attempt", "auth", "unauthorized", "suspicious sign"], "flag": "Cloud_Sec:Auth_Alert" },
        { "type": "header_contains", "header": "Subject", "values": ["blocked", "threat", "intrusion", "fail2ban", "banned"], "flag": "Cloud_Sec:Threat_Blocked" },
        { "type": "from_domain", "values": ["letsencrypt.org"], "flag": "Cloud_Sec:Cert_Renewal" },
        { "type": "from_domain", "values": ["namecheap.com", "gandi.net", "name.com", "godaddy.com"], "flag": "Cloud_Cost:Domain_Renewal" },
        { "type": "from_domain", "values": ["hetzner.com", "hetzner.de", "dell.com", "lenovo.com"], "flag": "Cloud_Cost:Hardware_Asset" },
        { "type": "from_domain", "values": ["oraclecloud.com", "oracle.com", "cloud.google.com", "google.cloud", "cloudflare.com", "digitalocean.com"], "flag": "Cloud_Cost:External_SaaS" }
      ]
    },
    {
      "id": "B7",
      "name": "\ud83d\udcce Meta Size & Attachment Types",
      "rules": [
        { "type": "size_over", "bytes": 10485760, "flag": "Meta_Size:Large_10MB+" },
        { "type": "content_type", "value": "application/pdf", "flag": "Meta_Attach:PDF" },
        { "type": "content_type", "value": "image/jpeg", "flag": "Meta_Attach:Image" },
        { "type": "content_type", "value": "image/png", "flag": "Meta_Attach:Image" },
        { "type": "content_type", "value": "image/heic", "flag": "Meta_Attach:Image" },
        { "type": "content_type", "value": "application/msword", "flag": "Meta_Attach:Document" },
        { "type": "content_type", "value": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "flag": "Meta_Attach:Document" },
        { "type": "content_type", "value": "text/plain", "flag": "Meta_Attach:Document" },
        { "type": "content_type", "value": "application/vnd.ms-excel", "flag": "Meta_Attach:Spreadsheet" },
        { "type": "content_type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "flag": "Meta_Attach:Spreadsheet" },
        { "type": "content_type", "value": "text/csv", "flag": "Meta_Attach:Spreadsheet" },
        { "type": "content_type", "value": "application/zip", "flag": "Meta_Attach:Archive" },
        { "type": "content_type", "value": "application/x-rar-compressed", "flag": "Meta_Attach:Archive" },
        { "type": "content_type", "value": "application/gzip", "flag": "Meta_Attach:Archive" },
        { "type": "content_type", "value": "application/x-tar", "flag": "Meta_Attach:Archive" },
        { "type": "content_type", "value": "audio/mpeg", "flag": "Meta_Attach:Media" },
        { "type": "content_type", "value": "audio/wav", "flag": "Meta_Attach:Media" },
        { "type": "content_type", "value": "video/mp4", "flag": "Meta_Attach:Media" },
        { "type": "content_type", "value": "video/quicktime", "flag": "Meta_Attach:Media" }
      ]
    },
    {
      "id": "B8",
      "name": "\ud83d\udcce Meta Routing & Sender Properties",
      "rules": [
        { "type": "has_cc", "flag": "Meta_Route:CC" },
        { "type": "self_sent", "flag": "Meta_Route:SelfSent" },
        { "type": "list_header", "flag": "Meta_Route:BCC_MailingList" },
        { "type": "header_exists", "header": "X-Auto-Response-Suppress", "flag": "Meta_Sender:Automated" },
        { "type": "header_exists", "header": "Auto-Submitted", "flag": "Meta_Sender:Automated" },
        { "type": "header_contains", "header": "Precedence", "values": ["bulk", "list", "junk"], "flag": "Meta_Sender:Automated" },
        { "type": "header_contains", "header": "From", "values": ["noreply", "no-reply", "donotreply", "mailer-daemon", "postmaster"], "flag": "Meta_Sender:Unusual" }
      ]
    }
  ],

