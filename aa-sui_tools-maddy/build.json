{
  "name": "maddy",
  "description": "Maddy Mail Server (mail.diegonmarcos.com)",
  "dns": "maddy.app",
  "category": "app",
  "domain": "mail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/maddy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "configs/init.sh"
  },
  "lifecycle": {
    "cleanup": [
      {
        "action": "ssh_run",
        "vm": "oci-mail",
        "script": "/opt/containers/maddy/assets/cleanup-stale-mailboxes.sh"
      }
    ],
    "dedupe": [
      {
        "action": "ssh_run",
        "vm": "oci-mail",
        "script": "/opt/containers/maddy/assets/dedupe-inbox.sh"
      }
    ],
    "dedupe-folders": [
      {
        "action": "ssh_run",
        "vm": "oci-mail",
        "script": "/opt/containers/maddy/assets/dedupe-folders.sh"
      }
    ]
  },
  "proxy": {
    "primary": {
      "domain": "mail.diegonmarcos.com",
      "auth": "two_factor",
      "tls_skip_verify": true,
      "l4_ports": [
        {
          "port": 993,
          "upstream": "130.110.251.193:993",
          "comment": "IMAPS",
          "protocol": "tls"
        },
        {
          "port": 465,
          "upstream": "130.110.251.193:465",
          "comment": "SMTPS",
          "protocol": "tls"
        },
        {
          "port": 587,
          "upstream": "130.110.251.193:587",
          "comment": "SMTP Submission",
          "protocol": "starttls"
        }
      ]
    },
    "app_hub": false,
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/maddy",
      "type": "static"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "maddy_data"
    ]
  },
  "ports": {
    "app": 993,
    "smtp": 465,
    "imap": 993
  },
  "containers": {
    "app": {
      "container_name": "maddy",
      "image": "ghcr.io/diegonmarcos/maddy:latest",
      "port": null,
      "extra_ports": [
        { "port": 25,  "protocol": "tcp",      "bind": "0.0.0.0",   "desc": "MX (inbound — must be public)" },
        { "port": 465, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "SMTPS — WG-only" },
        { "port": 587, "protocol": "starttls", "bind": "10.0.0.3",  "desc": "Submission — WG-only" },
        { "port": 993, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "IMAPS — WG-only" },
        { "port": 143, "protocol": "tcp",      "bind": "10.0.0.3",  "desc": "IMAP plain — WG-only" }
      ],
      "dns": "maddy.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "maddy_data:/data",
        "./dkim:/data/dkim:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "32M"
        }
      },
      "read_only": false,
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/imapsql.db"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "maddy-binaries",
    "dockerfile": "code/amd64/Dockerfile",
    "arch": "amd64",
    "runtime_packages": {
      "apk": "jq"
    }
  },
  "upstream_image": "foxcpp/maddy:0.9",
  "oci_relay": {
    "host": "smtp.email.eu-marseille-1.oci.oraclecloud.com",
    "port": "587"
  }
}
