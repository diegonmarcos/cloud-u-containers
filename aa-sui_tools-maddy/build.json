{
  "name": "maddy",
  "description": "Maddy Mail Server (mail.diegonmarcos.com)",
  "dns": "maddy.app",
  "category": "app",
  "domain": "mail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/maddy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "configs/init.sh"
  },
  "lifecycle": {
    "_doc": "Operator-triggered post-hoc maintenance via mail-sieve-subset-post-hoc.sh. SQL-direct on /data/imapsql.db using the actual go-imap-sql schema (msgs.extBodyKey ↔ extKeys.id, cachedHeader carries headers). Sub-second on 30k rows. Pre-SQL scripts archived in src/z-archive/ during transition. recover-headers stays intentionally NOT a subcommand: if the body blob is missing the BODY is unrecoverable and integrity-fix is the right action. apply-rules IS a subcommand — it pipes each INBOX row's cachedHeader through mail-sieve-subset-delivery-time (single SoT for evaluation) and batches the moves via maddy imap-msgs (correct IMAP UID + uidvalidity). Use it after a delivery-time outage to redistribute the INBOX backlog into the rule-defined folders.",
    "post-hoc-integrity-check": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc integrity-check" }
    ],
    "post-hoc-integrity-fix": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc integrity-fix" }
    ],
    "post-hoc-dedupe": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc dedupe" }
    ],
    "post-hoc-cleanup-mailboxes": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc cleanup-mailboxes" }
    ],
    "post-hoc-apply-rules-dry-run": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc apply-rules --dry-run" }
    ],
    "post-hoc-apply-rules": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc apply-rules" }
    ],
    "post-hoc-all": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc all" }
    ]
  },
  "proxy": {
    "primary": {
      "domain": "mail.diegonmarcos.com",
      "auth": "two_factor",
      "tls_skip_verify": true,
      "l4_ports": [
        {
          "port": 993,
          "upstream": "130.110.251.193:993",
          "comment": "IMAPS",
          "protocol": "tls"
        },
        {
          "port": 465,
          "upstream": "130.110.251.193:465",
          "comment": "SMTPS",
          "protocol": "tls"
        },
        {
          "port": 587,
          "upstream": "130.110.251.193:587",
          "comment": "SMTP Submission",
          "protocol": "starttls"
        }
      ]
    },
    "app_hub": false,
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/maddy",
      "type": "static"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "maddy_data"
    ]
  },
  "ports": {
    "app": 993,
    "smtp": 465,
    "imap": 993
  },
  "users": {
    "admin": {
      "name": "me",
      "pass_env": "ME_PASSWORD"
    },
    "noreply": {
      "name": "no-reply",
      "pass_env": "NOREPLY_PASSWORD",
      "aliases": ["noreply"]
    }
  },
  "containers": {
    "app": {
      "container_name": "maddy",
      "image": "ghcr.io/diegonmarcos/maddy:latest",
      "port": null,
      "extra_ports": [
        { "port": 25,  "protocol": "tcp",      "bind": "0.0.0.0", "service": "smtp_mx",       "desc": "MX (inbound — must be public)" },
        { "port": 465, "protocol": "tls",      "bind": "10.0.0.3","service": "smtp_ssl",      "desc": "SMTPS — wg0 bind, reached via Caddy L4 from gcp-proxy" },
        { "port": 587, "protocol": "starttls", "bind": "10.0.0.3","service": "smtp_starttls", "desc": "Submission — wg0 bind, reached via Caddy L4 from gcp-proxy" },
        { "port": 993, "protocol": "tls",      "bind": "10.0.0.3","service": "imap_ssl",      "desc": "IMAPS — wg0 bind, reached via Caddy L4 from gcp-proxy" },
        { "port": 143, "protocol": "tcp",      "bind": "10.0.0.3","service": "imap_plain",    "desc": "IMAP plain — wg0 bind" }
      ],
      "dns": "maddy.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "maddy_data:/data",
        "./dkim:/data/dkim:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "32M"
        }
      },
      "read_only": false,
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/imapsql.db"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "maddy-binaries",
    "dockerfile": "code/amd64/Dockerfile",
    "arch": "amd64",
    "runtime_packages": {
      "apk": "jq sqlite coreutils"
    }
  },
  "upstream_image": "foxcpp/maddy:0.9",
  "oci_relay": {
    "host": "smtp.email.eu-marseille-1.oci.oraclecloud.com",
    "port": "587"
  },
  "build": {
    "headers_enforced": true
  }
}
