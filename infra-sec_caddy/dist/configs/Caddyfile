            upstream 10.0.0.3:25
          }
        }
        }
        :443 {

          # ── SNI mux (issue #294 pattern, flat) ─────────────────────────
          # IMAPS via SNI on :443 -> STALWART :2993 (2026-09-02). Maddy :993 (go-imap v1) advertises no CONDSTORE/QRESYNC/UIDPLUS, which forces clients into a full flag rescan of every synced folder each poll -- measured on-device: 9355 UID FLAGS fetches per 15-min pass, all night, phone dead at 04:49. Stalwart :2993 advertises CONDSTORE+QRESYNC+UIDPLUS+IMAP4rev2. The earlier objection to :2993 (IMAP clients see Stalwart's ENTIRE 1*-9* + A*-F* tree because JMAP and IMAP share one store) is mitigated by the subscription policy in mail-rules-profile-diego.json folder_options: only INBOX + the F* sender folders are subscribed, and clients honouring LSUB/subscriptions see the intended menu. Maddy keeps :25 inbound and its store stays intact for rollback: revert this upstream to oci-mail:993. (SNI: imap.diegonmarcos.com)
          @sni_imap_diegonmarcos_com tls sni imap.diegonmarcos.com
          route @sni_imap_diegonmarcos_com {
            proxy {
              upstream 10.0.0.3:2993
            }
          }
          # SMTPS via SNI on :443 → Stalwart :2465 (Maddy's :465 is legacy) (SNI: smtps.diegonmarcos.com)
          @sni_smtps_diegonmarcos_com tls sni smtps.diegonmarcos.com
          route @sni_smtps_diegonmarcos_com {
            proxy {
              upstream 10.0.0.3:2465
            }
          }
          # Fall-through: TLS that does NOT match any mail SNI → internal HTTPS
          # `not { tls { sni ... } }` forces ClientHello parse, avoiding the
          # bare-`tls` race condition (issue #294).
          @notmail not {
            tls {
              sni imap.diegonmarcos.com smtps.diegonmarcos.com
            }
          }
          route @notmail {
            proxy {
              # Carry the real client address across the local hop. The
              # :8443 HTTP server unwraps it via listener_wrappers
              # proxy_protocol (00-globals.caddy.tpl), so remote_ip
              # matchers (wg-only tier gate) see the true client instead
              # of 127.0.0.1 — which had every request, including genuine
              # WG clients, answered "Forbidden" (vault regression).
              proxy_protocol v2
              upstream 127.0.0.1:8443
            }
          }
        }
    }

