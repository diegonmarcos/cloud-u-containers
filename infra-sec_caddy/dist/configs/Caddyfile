  # ════════════════════════════════════════════════════════════
  # MTA-STS — enforce TLS for inbound email delivery
  # ════════════════════════════════════════════════════════════

  mta-sts.diegonmarcos.com {
    bind 0.0.0.0 10.0.0.1
import security
    import edge_auth /.well-known/acme-challenge/* /.well-known/mta-sts.txt
    tls {
      dns cloudflare {env.CF_API_TOKEN}
      resolvers 1.1.1.1 8.8.8.8
      propagation_delay 30s
      propagation_timeout 5m
    }
    handle /.well-known/mta-sts.txt {
      header Content-Type "text/plain"
      respond "version: STSv1
mode: enforce
mx: route1.mx.cloudflare.net
mx: route2.mx.cloudflare.net
mx: route3.mx.cloudflare.net
max_age: 604800
" 200
    }
    # Wrapped in handle: the global options carry `order respond before handle`, so a
    # bare site-level `respond 404` ran BEFORE the policy handle above and 404ed it.
    handle {
      respond 404
    }
  }


  # ════════════════════════════════════════════════════════════
  # HTTP :80 → HTTPS 308 redirect (mesh bind only)
  # ════════════════════════════════════════════════════════════

  # Plain HTTP :80 → HTTPS. The global block sets `auto_https
  # disable_redirects`, so Caddy opens NO :80 listener on its own and every
  # http:// client got "failed to connect" while :443 answered 200 — the
  # Mattermost Android app probes http://chat.diegonmarcos.com before
  # upgrading, so it could never reach the server. This is the only site
  # here that is deliberately plain HTTP; the `http://` scheme keeps TLS
  # (and any cert issuance) off it.
  #
  # Mesh-only bind, NOT the publicBindLine used by the :8443 vhosts: the hub
  # is a private WireGuard node behind the single public edge, and the
  # collapse-to-443 plan the globals implement keeps its public surface at
  # one port. Redirecting on 10.0.0.1 serves mesh clients without opening a
  # new public socket. Separate port, so none of the byte-identical-bind
  # server-grouping rules that govern :8443 apply here.
  http:// {
    bind 10.0.0.1
    redir https://{host}{uri} 308
  }


  # ════════════════════════════════════════════════════════════
  # CATCH-ALL — data-driven from caddyRoutes.catch_all
  # ════════════════════════════════════════════════════════════

  # ════════════════════════════════════════════════════════════
  # CATCH-ALL (landing redirect): unknown subdomains 302 to the landing hub
  # instead of the 404 error page (url-scheme.md). Any host a more specific
  # site block does not claim lands here; the wildcard cert covers the name.
  # ════════════════════════════════════════════════════════════
  *.diegonmarcos.com {
    bind 0.0.0.0 10.0.0.1
import security
    
    tls {
      dns cloudflare {env.CF_API_TOKEN}
      resolvers 1.1.1.1 8.8.8.8
      propagation_delay 30s
      propagation_timeout 5m
    }
    header X-Edge-Fallback "1"
    header X-Edge-Route "catch-all"
    # redir sorts before forward_auth: keep it inside a handle so the gate runs first.
    handle {
      redir https://diegonmarcos.com/ 302
    }
  }

