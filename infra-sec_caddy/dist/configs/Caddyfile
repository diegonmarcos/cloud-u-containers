  # Landing page + WKD (Web Key Directory for PGP)
  diegonmarcos.com, www.diegonmarcos.com {
  bind 0.0.0.0 10.0.0.1
import security
import request_limits
    # WKD — PGP public key discovery (no auth — must be public per spec)
    handle_path /.well-known/openpgpkey/* {
      root * /srv/wkd
      file_server
    }
    # JMAP autoconfig — proxies to Stalwart (preserves per-user session) (well-known — public per spec)
    handle /.well-known/jmap {
reverse_proxy https://10.0.0.3:2443 {
  transport http {
    tls_insecure_skip_verify
  }
}
    }
    # JMAP API follow-through (matches relative redirect from /.well-known/jmap) (well-known — public per spec)
    handle /jmap/* {
reverse_proxy https://10.0.0.3:2443 {
  transport http {
    tls_insecure_skip_verify
  }
}
    }
    handle {
      rewrite * /landpage{uri}
reverse_proxy https://diegonmarcos.github.io {
  header_up Host diegonmarcos.github.io
  header_up X-Real-IP {http.request.remote.host}
}

    }
      handle_errors {
      @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
