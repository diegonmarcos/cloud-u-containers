      import security_jmap
request_body {
  max_size 50MB
}
import edge_auth_offmesh /.well-known/acme-challenge/*

@not_wg {
  not remote_ip 10.0.0.0/24 fd0c:1d00::/64
        not path /.well-known/jmap /jmap/* /
}
error @not_wg "Forbidden" 403


    # JMAP discovery on jmap vhost (public per RFC 8620) (well-known — public per spec)
    handle /.well-known/jmap {
        rewrite * /jmap/session
reverse_proxy https://10.0.0.3:2443 {
  transport http {
    tls_insecure_skip_verify
  }
}
    }
    # JMAP session/api/download/upload/eventsource follow-through on jmap vhost (well-known — public per spec)
    handle /jmap/* {
reverse_proxy https://10.0.0.3:2443 {
  transport http {
    tls_insecure_skip_verify
  }
}
    }
    # Bare host → JMAP discovery URL (308 redirect) (well-known — public per spec)
    handle / {
        redir / /.well-known/jmap 308
    }
    handle {
  reverse_proxy https://10.0.0.3:2443 {
    header_up X-Real-IP {http.request.remote.host}
    transport http {
  tls_insecure_skip_verify
}
  }
}
      import edge_errors
  }

  # PhotoPrism AI-powered photo management (oci-flex-1)
  photos.diegonmarcos.com {
  bind 0.0.0.0 10.0.0.1
import security
