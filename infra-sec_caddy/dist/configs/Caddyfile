    # Same posture as (security) minus the shared global rate-limit zone: a
  # Claude session start initializes ~10 MCP servers in parallel (several
  # POSTs each, plus SSE reconnects), which drains 100/min instantly and the
  # client's own retries then keep the bucket empty -- servers "fail to
  # connect" in a slow drip. MCP gets its own bucket so a session start can
  # never starve the browser-facing sites, and vice versa.
  (security_mcp) {
    import security_headers
    import block_bots
    import block_scanners
    import rate_limiting_mcp
    import ip_block
    import access_log
  }

    # Same posture as (security) with a dedicated rate-limit zone for the JMAP
  # vhost. A syncing mail client legitimately bursts far past 100 req/min
  # (Email/query paging + Email/get batches + per-op Email/set), and the
  # shared global zone throttled it the same way it starved MCP session
  # starts (see 12e9766e / (security_mcp)).
  (security_jmap) {
    import security_headers
    # The webmail (browser, webmail.<domain>) calls JMAP cross-origin WITH the Authelia session cookie
    # that the edge gate reads: credentialed CORS needs one explicit origin (never `*`), the
    # credentials flag, and X-Fleet-Authorization allowed for fleet-token clients that preflight.
    header {
      Access-Control-Allow-Origin "https://webmail.diegonmarcos.com"
      Access-Control-Allow-Credentials "true"
      Access-Control-Allow-Headers "Authorization, Content-Type, X-Fleet-Authorization"
      Vary Origin
    }
    import block_bots
    import block_scanners
    import rate_limiting_jmap
    import ip_block
    import access_log
  }


  # ── Shared public-edge auth gate (see ea in caddyfile.nix / _shared/edge-auth.nix) ──
  # (edge_auth) -- the ONE public-edge auth gate (cloud-u-containers _shared/edge-auth.*).
  # Owner rule 2026-10-16: PUBLIC URL = fleet Bearer OR Authelia session cookie.
  #   - `Authorization: Bearer ...` -> introspect-proxy (the same door the MCP routes
  #     use); an invalid token gets the introspector's own 401/403.
  #   - `X-Fleet-Authorization: Bearer ...` -> the same introspect-proxy (the token is
  #     moved into Authorization on the sub-request only); it wins over Authorization
  #     and is stripped before proxying, so a mailbox credential in `Authorization`
  #     (Stalwart Basic/Bearer on jmap./mails.) reaches the upstream untouched.
  #   - anything else -> Authelia forward-auth: a valid session cookie passes;
  #     otherwise Authelia answers 401 to API / non-browser clients and 302 to
  #     auth. (with rd=) to browsers. Nothing reaches an upstream anonymously.
  #   - Tier c (public_open in build.json caddy_config.edge_auth) is exempted by
  #     the PATH ARGS of the import: `import edge_auth <path>...` -- always
  #     /.well-known/acme-challenge/* plus that host's own declared paths.
  #   - CORS preflight (OPTIONS + Access-Control-Request-Method) cannot carry
  #     credentials: it is answered 204 right here and never proxied. Plain
  #     OPTIONS (WebDAV) is still gated.
  # forward_auth sorts before handle / respond / reverse_proxy, so importing this
  # at the top of a site gates every handle in it. `redir` sorts BEFORE
  # forward_auth: a site-level `redir` next to this import would run ungated, so
  # it must be wrapped in `handle { }` (the CI guard rejects a bare one).
  # edge_auth: enforced for every source.
  (edge_auth) {
    @ea_pre {
      method OPTIONS
      header Access-Control-Request-Method *
    }
    @ea_fleet {
      header X-Fleet-Authorization Bearer*
      not path {args[:]}
      not {
        method OPTIONS
        header Access-Control-Request-Method *
      }
    }
    @ea_bearer {
      header Authorization Bearer*
      not header X-Fleet-Authorization Bearer*
      not host jmap.diegonmarcos.com mails.diegonmarcos.com
      not path {args[:]}
      not {
        method OPTIONS
        header Access-Control-Request-Method *
      }
    }
    @ea_session {
      not header Authorization Bearer*
      not header X-Fleet-Authorization Bearer*
      not {
        header Cookie *_diego_sso=*
        not header Cookie *authelia_session=*
      }
      not {
        header Cf-Access-Jwt-Assertion *
        not header Cookie *authelia_session=*
      }
      not path {args[:]}
      not {
        method OPTIONS
        header Access-Control-Request-Method *
      }
    }
    respond @ea_pre 204
    # Dedicated fleet-token header for clients whose Authorization carries another
    # credential (Stalwart Basic/Bearer on jmap./mails.). Wins over Authorization.
    forward_auth @ea_fleet 10.0.0.1:4182 {
      # A websocket upgrade must not reach the auth subrequest: an introspect/authelia
      # backend that gets Connection: Upgrade never answers and the edge hangs.
      header_up -Connection
      header_up -Upgrade
      method GET
      uri /auth
      header_up Authorization {http.request.header.X-Fleet-Authorization}
      copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
    }
    # Never forward the fleet token to an upstream; Authorization passes untouched.
    request_header -X-Fleet-Authorization
    forward_auth @ea_bearer 10.0.0.1:4182 {
      # A websocket upgrade must not reach the auth subrequest: an introspect/authelia
      # backend that gets Connection: Upgrade never answers and the edge hangs.
      header_up -Connection
      header_up -Upgrade
      method GET
      uri /auth
      copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
    }
    forward_auth @ea_session 172.18.0.3:9091 {
      # A websocket upgrade must not reach the auth subrequest: an introspect/authelia
      # backend that gets Connection: Upgrade never answers and the edge hangs.
      header_up -Connection
      header_up -Upgrade
      uri /api/authz/forward-auth
      header_up X-Forwarded-Uri {http.request.orig_uri}
      copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
@ea_broker {
  header Cookie *_diego_sso=*
  not header Cookie *authelia_session=*
  not header Authorization Bearer*
  not header X-Fleet-Authorization Bearer*
  not path {args[:]}
  not {
    method OPTIONS
    header Access-Control-Request-Method *
  }
}
# Broker session (Google / GitHub, allowlisted to the owner by the broker itself).
forward_auth @ea_broker 10.0.0.6:4180 {
  header_up -Connection
  header_up -Upgrade
  uri /oauth2/google/auth
  copy_headers X-Auth-Request-Email
}
# Order of the chain: Authelia session, else broker cookie (above), else Cloudflare Access JWT.
# The JWT is verified by the broker (signature, issuer, audience, expiry, owner email only).
@ea_cfaccess {
  header Cf-Access-Jwt-Assertion *
  not header Cookie *authelia_session=*
  not header Cookie *_diego_sso=*
  not header Authorization Bearer*
  not header X-Fleet-Authorization Bearer*
  not path {args[:]}
  not {
    method OPTIONS
    header Access-Control-Request-Method *
  }
}
forward_auth @ea_cfaccess 10.0.0.6:4180 {
  header_up -Connection
  header_up -Upgrade
  uri /oauth2/google/cf-auth
  copy_headers X-Auth-Request-Email
}
  }
