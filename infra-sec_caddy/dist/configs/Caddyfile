    import edge_auth /.well-known/acme-challenge/* /umami/script.js /umami/api/send /matomo/matomo.js /matomo/piwik.js /matomo/matomo.php /matomo/piwik.php /matomo/js/*
    @tracking {
      path /matomo/matomo.js /matomo/matomo.php /matomo/piwik.js /matomo/piwik.php /matomo/collect.php /matomo/api.php /matomo/track.php /matomo/js/*
