{
  "name": "google-personal-mcp",
  "description": "Google Personal Account MCP server — Gmail (IMAP/SMTP via App Password) for personal Google accounts, multi-account",
  "dns": "g-personal-mcp.app",
  "category": "app",
  "domain": "mcp.diegonmarcos.com",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "auth": {
    "mode": "app_password",
    "imap_host": "imap.gmail.com",
    "imap_port": 993,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "tls": true
  },
  "accounts": [
    {
      "alias": "diego1",
      "email": "diegonmarcos1@gmail.com",
      "secret_env": "DIEGO1_APP_PASSWORD",
      "default": true
    }
  ],
  "docker": {
    "image": "google-personal-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "app_dir": "code",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "npx tsx mcp/index.ts --http",
      "base_image": "node:22-slim",
      "apt": "dnsutils ca-certificates"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/google-personal-mcp",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/g-personal"
    },
    "app_hub": false
  },
  "ports": {
    "app": 3106
  },
  "containers": {
    "app": {
      "container_name": "google-personal-mcp",
      "image": "ghcr.io/diegonmarcos/google-personal-mcp:latest",
      "port": 3106,
      "port_env": "PORT",
      "dns": "g-personal-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/g-personal"
      },
      "healthcheck": "/health",
      "monitoring": null,
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  }
}
