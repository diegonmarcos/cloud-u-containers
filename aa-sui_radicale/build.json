{
  "name": "radicale",
  "description": "Radicale CalDAV/CardDAV server (cal.diegonmarcos.com)",
  "dns": "radicale.app",
  "upstream_image": "tomsquest/docker-radicale:latest",
  "ports": {
    "app": 5232
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "cal.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/radicale",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "cal.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/.web/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "radicale",
      "image": "tomsquest/docker-radicale:latest",
      "port": 5232,
      "port_env": null,
      "dns": "radicale.app",
      "public": true,
      "proxy": {
        "domain": "cal.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/.web/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./data:/data",
        "./config:/config:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/data/collections"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "radicale",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  }
}
