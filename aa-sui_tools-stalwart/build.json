{
  "name": "stalwart",
  "description": "Stalwart Mail Server — JMAP webmail backend (jmap.diegonmarcos.com)",
  "dns": "stalwart.app",
  "category": "app",
  "domain": "jmap.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/stalwart",
    "excludes": [
      "data/**",
      "dkim/**"
    ],
    "compose_flags": ""
  },
  "compose": {
    "custom": true,
    "post_hook": "configs/activate.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "stalwart",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "primary": {
      "domain": "jmap.diegonmarcos.com",
      "auth": "none",
      "tls_skip_verify": true,
      "_doc_l4_ports": "Stalwart is JMAP-only from the client side — clients reach it via jmap.diegonmarcos.com (HTTPS reverse_proxy to :2443). Classical IMAPS (:2993) and SMTPS (:2465) listeners still exist inside the container for legacy-tooling (mail-puller, sorter) but are NOT exposed publicly — those Caddy SNI subhostnames were removed. If you later retire maddy and want Stalwart to take over imap.* / smtps.*, flip the upstream in those maddy-side declarations instead of re-adding -stalwart suffix hostnames.",
      "l4_ports": []
    },
    "app_hub": false,
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/stalwart",
      "tls_skip_verify": true,
      "auth": "none",
      "error_redirect": "/"
    },
    "well_known": [
      {
        "path": "/.well-known/jmap",
        "target_domain": "diegonmarcos.com",
        "tls_skip_verify": true,
        "comment": "JMAP auto-discovery (RFC 8620) — proxies to Stalwart"
      }
    ]
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "stalwart_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "stalwart",
      "image": "stalwartlabs/stalwart:v0.14.1",
      "port": 2443,
      "_doc_dual_bind": "Phase 4 of public-surface collapse: each port dual-binds on wg0 (10.0.0.3) AND wg-public (10.1.0.3). Caddy on oci-analytics reaches mail ports via wg-public mesh; legacy clients on wg0 keep working unchanged. compose.nix expands `bind` arrays into one host-port mapping per IP.",
      "extra_ports": [
        { "port": 2025, "protocol": "starttls", "bind": ["10.0.0.3", "10.1.0.3"], "service": "smtp_shadow",   "desc": "SMTP shadow (http-to-smtp-proxy-api on gcp-proxy → WG → :2025)" },
        { "port": 2443, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "jmap_tls",      "desc": "HTTPS admin/JMAP — dual-bind wg0+wg-public, reached via Caddy L4" },
        { "port": 2465, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "smtp_ssl",      "desc": "SMTPS — dual-bind wg0+wg-public, reached via Caddy L4" },
        { "port": 2993, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "imap_ssl",      "desc": "IMAPS — dual-bind wg0+wg-public, reached via Caddy L4" },
        { "port": 6190, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "manage_sieve",  "desc": "ManageSieve — dual-bind wg0+wg-public, reached via Caddy L4" }
      ],
      "port_env": null,
      "dns": "stalwart.app",
      "public": true,
      "proxy": {
        "domain": "jmap.diegonmarcos.com",
        "auth": "none",
        "tls_skip_verify": true
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "stalwart_data:/opt/stalwart-mail/data",
        "./tls:/opt/stalwart-mail/tls:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "32M"
        }
      },
      "read_only": false,
      "dump_cmd": "sh -c 'stalwart-mail --export /tmp/stalwart-export && tar cf - -C /tmp stalwart-export && rm -rf /tmp/stalwart-export'",
      "protocol": "https",
      "embedded_dbs": [
        {
          "engine": "rocksdb",
          "path": "/opt/stalwart-mail/data"
        }
      ]
    },
    "sorter": {
      "container_name": "stalwart-sorter",
      "image": "python:3-alpine",
      "resources": {
        "mem_limit": "64M",
        "mem_reservation": "16M"
      }
    }
  },
  "upstream_image": "stalwartlabs/stalwart:v0.14.1",
  "timezone": "Europe/Madrid",
  "users": {
    "admin": {
      "name": "me",
      "pass_env": "ME_PASSWORD"
    },
    "noreply": {
      "name": "no-reply",
      "pass_env": "NOREPLY_PASSWORD",
      "aliases": ["noreply"]
    }
  },
  "build": {
    "headers_enforced": true
  }
}
