{
  "name": "stalwart",
  "description": "Stalwart Mail Server — shadow mode (mail-stalwart.diegonmarcos.com)",
  "dns": "stalwart.app",
  "category": "app",
  "domain": "mail-stalwart.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/stalwart",
    "excludes": [
      "data/**",
      "dkim/**"
    ],
    "compose_flags": ""
  },
  "compose": {
    "custom": true,
    "post_hook": "activate.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "stalwart",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "primary": {
      "domain": "mail-stalwart.diegonmarcos.com",
      "auth": "none",
      "tls_skip_verify": true,
      "l4_ports": [
        {
          "port": 2993,
          "upstream": "130.110.251.193:2993",
          "comment": "IMAPS (Stalwart)",
          "protocol": "tls"
        },
        {
          "port": 2465,
          "upstream": "130.110.251.193:2465",
          "comment": "SMTPS (Stalwart)",
          "protocol": "tls"
        },
        {
          "port": 2587,
          "upstream": "130.110.251.193:2587",
          "comment": "SMTP Submission (Stalwart)",
          "protocol": "starttls"
        }
      ]
    },
    "app_hub": false,
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/stalwart",
      "tls_skip_verify": true,
      "auth": "none",
      "error_redirect": "/"
    },
    "well_known": [
      {
        "path": "/.well-known/jmap",
        "target_domain": "diegonmarcos.com",
        "tls_skip_verify": true,
        "comment": "JMAP auto-discovery (RFC 8620) — proxies to Stalwart"
      }
    ]
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "stalwart_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "stalwart",
      "image": "stalwartlabs/stalwart:latest",
      "port": 2443,
      "extra_ports": [
        { "port": 2025, "protocol": "starttls", "bind": "127.0.0.1", "desc": "SMTP shadow (smtp-proxy → localhost, loopback-only)" },
        { "port": 2443, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "HTTPS admin/JMAP — WG-only" },
        { "port": 2465, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "SMTPS — WG-only" },
        { "port": 2587, "protocol": "starttls", "bind": "10.0.0.3",  "desc": "Submission — WG-only" },
        { "port": 2993, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "IMAPS — WG-only" },
        { "port": 6190, "protocol": "tls",      "bind": "10.0.0.3",  "desc": "ManageSieve — WG-only" }
      ],
      "port_env": null,
      "dns": "stalwart.app",
      "public": true,
      "proxy": {
        "domain": "mail-stalwart.diegonmarcos.com",
        "auth": "none",
        "tls_skip_verify": true
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "stalwart_data:/opt/stalwart-mail/data",
        "./tls:/opt/stalwart-mail/tls:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "32M"
        }
      },
      "read_only": false,
      "dump_cmd": "sh -c 'stalwart-mail --export /tmp/stalwart-export && tar cf - -C /tmp stalwart-export && rm -rf /tmp/stalwart-export'",
      "protocol": "https",
      "embedded_dbs": [
        {
          "engine": "rocksdb",
          "path": "/opt/stalwart-mail/data"
        }
      ]
    },
    "sorter": {
      "container_name": "stalwart-sorter",
      "image": "python:3-alpine",
      "resources": {
        "mem_limit": "64M",
        "mem_reservation": "16M"
      }
    }
  },
  "upstream_image": "stalwartlabs/stalwart:latest",
  "timezone": "Europe/Madrid",
  "admin_user": "me",
  "noreply_user": "no-reply"
}
