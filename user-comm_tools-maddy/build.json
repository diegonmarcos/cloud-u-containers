{
  "name": "maddy",
  "description": "Maddy Mail Server (mail.diegonmarcos.com)",
  "dns": "maddy.app",
  "category": "app",
  "domain": "mail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/maddy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "configs/init.sh"
  },
  "lifecycle": {
    "_doc": "Operator-triggered post-hoc maintenance via mail-sieve-subset-post-hoc.sh. SQL-direct on /data/imapsql.db using the actual go-imap-sql schema. UNIFIED-INBOX delivery model: maddy delivery-time always places mail in INBOX (with \\Seen via inbox_copy_flags from mail-rules.json); apply-rules then SQL-direct COPIES (NOT moves) into matched category folders with rule-derived keywords (no \\Seen — copies are unread). INBOX is the chronological archive; category folders are the unread working set. apply-rules is idempotent via the $distributed keyword on the INBOX original — Dagu can run it on a 2-min cron without duplicating work. reseed-inbox-archive is a one-shot history backfill that COPIES every existing non-system folder msg back into INBOX as \\Seen + $distributed (Message-Id deduped). recover-headers stays intentionally NOT a subcommand: missing-blob bodies are unrecoverable, integrity-fix is the right action.",
    "post-hoc-integrity-check": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc integrity-check" }
    ],
    "post-hoc-integrity-fix": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc integrity-fix" }
    ],
    "post-hoc-dedupe": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc dedupe" }
    ],
    "post-hoc-cleanup-mailboxes": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc cleanup-mailboxes" }
    ],
    "post-hoc-apply-rules-dry-run": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc apply-rules --dry-run" }
    ],
    "post-hoc-apply-rules": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc apply-rules" }
    ],
    "post-hoc-reseed-inbox-archive-dry-run": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc reseed-inbox-archive --dry-run" }
    ],
    "post-hoc-reseed-inbox-archive": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc reseed-inbox-archive" }
    ],
    "post-hoc-all": [
      { "action": "ssh_run", "vm": "oci-mail",
        "script": "docker exec maddy /usr/local/bin/mail-sieve-subset-post-hoc all" }
    ]
  },
  "proxy": {
    "primary": {
      "domain": "mail.diegonmarcos.com",
      "auth": "two_factor",
      "tls_skip_verify": true,
      "l4_ports": [
        {
          "port": 25,
          "upstream": "oci-mail:25",
          "comment": "SMTP MX plain TCP — design-complete listener; GCP firewall currently blocks public, CF Worker is the active inbound bridge",
          "protocol": "tcp"
        },
        {
          "port": 443,
          "sni": "imap.diegonmarcos.com",
          "upstream": "oci-mail:2993",
          "comment": "IMAPS via SNI on :443 — upstream flipped from Maddy:993 to Stalwart:2993 per aa-sui_tools-stalwart/build.json _doc_l4_ports (Maddy retired)",
          "protocol": "tls"
        },
        {
          "port": 443,
          "sni": "smtps.diegonmarcos.com",
          "upstream": "oci-mail:2465",
          "comment": "SMTPS via SNI on :443 — upstream flipped from Maddy:465 to Stalwart:2465 per aa-sui_tools-stalwart/build.json _doc_l4_ports (Maddy retired)",
          "protocol": "tls"
        }
      ]
    },
    "app_hub": false,
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/maddy",
      "type": "static"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "maddy_data"
    ]
  },
  "ports": {
    "app": 993,
    "smtp": 465,
    "imap": 993
  },
  "users": {
    "admin": {
      "name": "me",
      "pass_env": "ME_PASSWORD"
    },
    "noreply": {
      "name": "no-reply",
      "pass_env": "NOREPLY_PASSWORD",
      "aliases": ["noreply"]
    }
  },
  "containers": {
    "app": {
      "container_name": "maddy",
      "image": "ghcr.io/diegonmarcos/maddy:latest",
      "port": null,
      "_doc_dual_bind": "Phase 4 of public-surface collapse: each port dual-binds on wg0 (10.0.0.3) AND wg-public (10.1.0.3). Maddy is host-network so binds happen inside maddy.conf.tpl via `@LISTEN_<port>@`; flake.nix expands `bind` arrays into space-separated multi-listener prefixes (e.g. `tls://10.0.0.3:993 tls://10.1.0.3:993`). Caddy on oci-analytics reaches mail ports via wg-public; legacy clients on wg0 keep working unchanged.",
      "extra_ports": [
        { "port": 25,  "protocol": "tcp",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "smtp_mx",       "desc": "MX delivery endpoint — dual-bind wg0+wg-public; CF Worker → Caddy → http-to-smtp-proxy-api → SMTP over WG is the public bridge (Phase 5)" },
        { "port": 465, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "smtp_ssl",      "desc": "SMTPS — dual-bind wg0+wg-public, reached via Caddy L4 from oci-analytics" },
        { "port": 993, "protocol": "tls",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "imap_ssl",      "desc": "IMAPS — dual-bind wg0+wg-public, reached via Caddy L4 from oci-analytics" },
        { "port": 143, "protocol": "tcp",      "bind": ["10.0.0.3", "10.1.0.3"], "service": "imap_plain",    "desc": "IMAP plain — dual-bind wg0+wg-public" }
      ],
      "dns": "maddy.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "maddy_data:/data",
        "./dkim:/data/dkim:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "32M"
        }
      },
      "read_only": false,
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/imapsql.db"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "maddy-binaries",
    "dockerfile": "code/amd64/Dockerfile",
    "arch": "amd64",
    "runtime_packages": {
      "apk": "jq sqlite coreutils"
    }
  },
  "upstream_image": "foxcpp/maddy:0.9",
  "oci_relay": {
    "host": "smtp.email.eu-marseille-1.oci.oraclecloud.com",
    "port": "587"
  },
  "build": {
    "headers_enforced": true
  }
}
