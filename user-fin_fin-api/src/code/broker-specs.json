{
  "$schema": "./broker-specs.schema.json",
  "note": "Data-driven broker registry. Interpreted by crates/brokers/brokers-generic. Auth details, OAuth flows, and signed payloads that don't fit this shape live in their own crate (see brokers-alpaca template). Every spec ships a hermetic test fixture.",
  "specs": [
    {
      "id": "zerodha",
      "description": "Zerodha Kite Connect",
      "base_url": "https://api.kite.trade",
      "region": "IN",
      "auth": { "header": "Authorization", "prefix": "token " },
      "endpoints": {
        "place_order": "/orders/regular",
        "cancel_order": "/orders/regular/{id}",
        "get_order": "/orders/{id}",
        "list_orders": "/orders",
        "positions": "/portfolio/positions",
        "balance": "/user/margins"
      },
      "fields": {
        "order_id": "/data/order_id",
        "order_status": "/data/status",
        "cash": "/data/equity/net",
        "equity": "/data/equity/available",
        "positions": "/data/net",
        "position_symbol": "/tradingsymbol",
        "position_qty": "/quantity",
        "position_avg_price": "/average_price"
      },
      "test": {
        "place_order_response": { "status": "success", "data": { "order_id": "250101000000123" } },
        "get_order_response":   { "data": { "order_id": "250101000000123", "status": "COMPLETE" } },
        "positions_response":   { "data": { "net": [{ "tradingsymbol": "INFY", "quantity": 10, "average_price": 1450.25 }] } },
        "balance_response":     { "data": { "equity": { "net": 100000.0, "available": 95000.0 } } }
      }
    },
