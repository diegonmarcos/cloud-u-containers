{
  "name": "kg-graph",
  "enabled": false,
  "description": "SurrealDB Hybrid Knowledge Graph - Infrastructure topology + vector search",
  "category": "data",
  "version": "0.1.0",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/kg-graph",
    "compose_flags": "--build"
  },
  "backup": {
    "enabled": true
  },
  "ports": {
    "app": 8001
  },
  "containers": {
    "app": {
      "container_name": "surrealdb",
      "port": 8001,
      "protocol": "http",
      "db_engine": "surrealdb",
      "image": "ghcr.io/diegonmarcos/kg-graph:latest"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "kg-graph",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "upstream_image": "surrealdb/surrealdb:v2",
  "data_path": "/opt/data/surrealdb",
  "build": {
    "headers_enforced": true
  }
}
