{
  "name": "grist",
  "description": "Grist spreadsheet/database (sheets.diegonmarcos.com)",
  "dns": "grist.app",
  "ports": {
    "app": 3011
  },
  "category": "app",
  "domain": "sheets.diegonmarcos.com",
  "upstream_image": "gristlabs/grist:latest",
  "grist_admin_email": "admin@diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/grist",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "sheets.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "grist_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "grist_app",
      "image": "gristlabs/grist:latest",
      "port": 3011,
      "port_env": "PORT",
      "dns": "grist.app",
      "public": true,
      "proxy": {
        "domain": "sheets.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "grist_data:/persist"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "db_path": "/persist/grist-sessions.db",
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "grist",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "build": {
    "headers_enforced": true
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "display_name": "Grist",
    "description": "Self-hosted spreadsheet and database with REST API.",
    "auth": "api-key"
  }
}
