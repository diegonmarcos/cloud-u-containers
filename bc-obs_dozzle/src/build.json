{
  "name": "dozzle",
  "description": "Dozzle - Real-time Docker log viewer",
  "dns": "dozzle.app",
  "ports": {
    "app": 9999
  },
  "category": "tools",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "logs.diegonmarcos.com",
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "/opt/containers/dozzle",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "dozzle",
    "dockerfile": "Dockerfile"
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/dozzle",
      "auth": "two_factor"
    }
  },
  "containers": {
    "app": {
      "container_name": "dozzle",
      "image": "amir20/dozzle:latest",
      "port": 9999,
      "port_env": "DOZZLE_ADDR",
      "dns": "dozzle.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "app.diegonmarcos.com",
        "base_path": "/dozzle",
        "auth": "two_factor"
      },
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64m"
      },
      "read_only": false
    }
  }
}
