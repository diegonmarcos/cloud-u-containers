{
  "name": "dozzle",
  "description": "Dozzle - Real-time Docker log viewer",
  "category": "tools",
  "domain": "logs.diegonmarcos.com",
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "/opt/containers/dozzle",
    "compose_flags": "--build"
  },
  "ports": {
    "app": 9999
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "upstream": "dozzle.app:9999",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/dozzle"
  }
}
