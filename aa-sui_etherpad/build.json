{
  "name": "etherpad",
  "description": "Etherpad collaborative editor",
  "category": "app",
  "domain": "pad.diegonmarcos.com",
  "ports": {
    "app": 3012,
    "db": 5436
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/etherpad"
  },
  "proxy": {
    "upstream": "etherpad.app:3012",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/etherpad"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
