{
  "name": "filebrowser",
  "taxonomy": {"group": "Cloud Apps", "category": "Data Apps"},
  "description": "FileBrowser web file manager (NEW - not deployed yet)",
  "dns": "filebrowser.mesh.diegonmarcos.com",
  "ports": {
    "app": 3015
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "app.diegonmarcos.com/filebrowser",
  "upstream_image": "filebrowser/filebrowser:latest",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/filebrowser",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/filebrowser",
      "auth": "two_factor",
      "identity": {
        "header": "X-Forwarded-User",
        "bearer": {"claude-admin": "diego"},
        "session": {"me@diegonmarcos.com": "diego"},
        "_doc": "Header auth (#1147): the hub caddy strips any inbound header of this name before forward_auth, sets it only from these tables (Authelia username in Remote-User, or fleet client_id in X-Auth-User), and answers 403 for a validated identity with no row. Mechanism in infra-sec_caddy/src/identity.nix."
      }
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "filebrowser_app",
      "image": "filebrowser/filebrowser:latest",
      "port": 3015,
      "port_env": null,
      "dns": "filebrowser.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "app.diegonmarcos.com",
        "base_path": "/filebrowser",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "filebrowser_data:/srv",
        "filebrowser_db:/database",
        "filebrowser_config:/config"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/filebrowser.db"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "filebrowser",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "tests": {
    "fb-proxy-auth": {
      "cmd": "bash test-fb-proxy-auth.sh",
      "cwd": "src"
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "display_name": "FileBrowser",
    "description": "Web-based file manager with REST API.",
    "auth": "bearer"
  }
}
