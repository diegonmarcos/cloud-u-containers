{
  "name": "ollama-arm",
  "description": "Ollama LLM server (ARM CPU, 7b models)",
  "category": "agi",
  "build": {
    "include_cloud_data": "true"
  },
  "frozen": true,
  "deploy": {
    "host": "oci-apps-2",
    "remote_path": "/opt/containers/ollama-arm",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "ollama-arm"
  },
  "ports": {
    "app": 11434
  },
  "containers": {
    "app": {
      "container_name": "ollama-arm",
      "port": 11434,
      "port_env": "OLLAMA_HOST",
      "port_format": "host",
      "protocol": "http"
    }
  }
}
