    (rate_limiting) {
    # Static assets are exempt from the per-IP `global` zone: one page load
    # (linktree: ~80 icons/images in parallel + SW precache) must never trip it.
    # They get their own, much higher per-IP zone so a flood is still bounded.
    rate_limit {
      zone static {
        match {
          path_regexp `(?i)\.(svg|png|jpe?g|gif|webp|avif|ico|css|js|mjs|map|woff2?|ttf|otf|json|webmanifest|mp4|webm)$`
        }
        key    {remote_host}
        events 3000
        window 1m
      }
      zone global {
        match {
          not path_regexp `(?i)\.(svg|png|jpe?g|gif|webp|avif|ico|css|js|mjs|map|woff2?|ttf|otf|json|webmanifest|mp4|webm)$`
        }
        key    {remote_host}
        events 100
        window 1m
      }
    }
  }

