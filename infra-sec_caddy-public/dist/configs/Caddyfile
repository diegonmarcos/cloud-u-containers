# gh-pages: Landing page + WKD (Web Key Directory for PGP)
diegonmarcos.com, www.diegonmarcos.com {
import security

  import edge_auth /.well-known/acme-challenge/* /.well-known/openpgpkey/* /.well-known/jmap
  handle /.well-known/openpgpkey/* {
  reverse_proxy 10.1.0.2:443
}
handle /.well-known/jmap {
  reverse_proxy https://10.0.0.3:2443 {
    header_up X-Real-IP {http.request.remote.host}
    transport http {
      tls_insecure_skip_verify
    }
  }
}
handle /jmap/* {
  reverse_proxy https://10.0.0.3:2443 {
    header_up X-Real-IP {http.request.remote.host}
    transport http {
      tls_insecure_skip_verify
    }
  }
}
    handle {
      @gh_static path_regexp gh_static `(?i)\.(svg|png|jpe?g|gif|webp|avif|ico|css|js|mjs|map|woff2?|ttf|otf|json|webmanifest|mp4|webm)$`
header @gh_static {
  Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  -Expires
  defer
}
rewrite * /landpage{uri}
reverse_proxy https://diegonmarcos.github.io {
  header_up Host diegonmarcos.github.io
  header_up X-Real-IP {http.request.remote.host}
}
    }
    handle_errors {
      # Geo-fence refusal (#1102): HTML clients get the explanation page, everyone else plain 403.
      @geo_html {
        expression `{err.message} == "geo-restricted"`
        header Accept *text/html*
      }
      handle @geo_html {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store"
        header X-Edge-Geo-Block "1"
        respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Not available in your region</title></head><body style="font-family:system-ui,sans-serif;max-width:34rem;margin:12vh auto;padding:0 1rem;line-height:1.5;color:#222"><h1 style="font-size:1.4rem">Not available in your region</h1><p>Access to this service is limited to clients in Europe and the United States. Your request came from a country outside that list, so it was refused (HTTP 403).</p><p>If you are travelling or on a VPN, connect from an allowed country and try again.</p><p style="font-size:.8rem;color:#666">IP geolocation by DB-IP (db-ip.com), CC BY 4.0.</p></body></html>` 403
      }
      @geo_any expression `{err.message} == "geo-restricted"`
      handle @geo_any {
        header X-Edge-Geo-Block "1"
        respond "Forbidden" 403
      }
      @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
      handle @backend_error {
        # Truthful fallback. A backend error (upstream down/unreachable) must NOT
        # masquerade as 200 — a plain `file_server` serves the error page with 200,
        # a FALSE GREEN that hid genuinely-down services behind the edge
        # (openobserve/news-gdelt/c3-infra-api, 2026-06-23: public probe saw 200
        # wormhole while the service was absent). Serve the page but PRESERVE the
        # real upstream status, and tag the response so probes detect the fallback
        # deterministically instead of guessing from the body.
        header X-Edge-Fallback "1"
        header X-Edge-Upstream-Status "{err.status_code}"
        root * /srv
        rewrite * /error.html
        file_server {
          status {err.status_code}
        }
      }
    }
}

