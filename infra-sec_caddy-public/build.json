{
  "name": "caddy-public",
  "description": "Caddy public-edge L7 allowlist on oci-analytics. Terminates TLS on :8443, serves ONLY the declared-public allowlist (build-caddy-public.json: gh-pages, no-auth subdomains, well-known, explicit public_paths), and FORWARDS everything else to the private hub gcp-proxy over wg-public (10.1.0.2:443). Fail-closed: any host/path not explicitly allowlisted is forwarded to gcp-proxy, whose @wg gate 403s public clients.",
  "dns": "caddy-public.app",
  "category": "sec",
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "/opt/containers/caddy-public",
    "excludes": [
      "logs/"
    ],
    "compose_flags": ""
  },
  "compose": {
    "custom": true
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "caddy_config": {
    "global": {
      "debug": true,
      "admin_bind": "localhost:2019",
      "order": "respond before handle",
      "auto_https": "disable_redirects",
      "https_port": 8443,
      "_doc_wg_bind_ip": "oci-analytics wg0 IP (10.0.0.4). The public edge listens on :8443 (TLS-terminated, fronted by caddy-l4-public on 0.0.0.0:443) and forwards non-allowlisted traffic to gcp-proxy over wg-public (private_forward_upstream = 10.1.0.2:443).",
      "wg_bind_ip": "10.0.0.4"
    },
    "on_demand_tls": {
      "ask_bind": "127.0.0.1:2020",
      "ask_url": "http://127.0.0.1:2020"
    },
    "security_snippets": {
      "security_headers": {
        "hsts_max_age": 31536000,
        "frame_options": "SAMEORIGIN",
        "referrer_policy": "strict-origin-when-cross-origin",
        "permissions_policy": "camera=(), microphone=(), geolocation=()",
        "cors_origin": "*",
        "cors_methods": "GET, POST, OPTIONS",
        "cors_headers": "Authorization, Content-Type",
        "hide_headers": [
          "Server"
        ]
      },
      "rate_limit": {
        "events": 100,
        "window": "1m",
        "key": "{remote_host}",
        "zone": "global"
      },
      "bot_blocker": {
        "user_agents": [
          "sqlmap",
          "nikto",
          "masscan",
          "nmap",
          "zgrab",
          "scrapy",
          "dirbuster",
          "gobuster",
          "nuclei",
          "wfuzz",
          "havij",
          "acunetix",
          "nessus",
          "openvas"
        ]
      },
      "scanner_blocker": {
        "paths": [
          "/wp-admin*",
          "/wp-login*",
          "/xmlrpc.php",
          "/.env",
          "/.git*",
          "/phpmyadmin*",
          "/actuator*",
          "/solr*",
          "/console*",
          "/.aws*",
          "/cgi-bin/*"
        ]
      },
      "request_limits": {
        "max_body": "10MB"
      },
      "ip_block": {
        "cidrs": []
      },
      "access_log": {
        "path": "/var/log/caddy/access.log",
        "format": "json",
        "roll_size": "10mb",
        "roll_keep": 5
      }
    },
    "auth": {
      "authelia_uri": "/api/authz/forward-auth",
      "authelia_copy": [
        "Remote-User",
        "Remote-Groups",
        "Remote-Email",
        "Remote-Name"
      ],
      "introspect_uri": "/auth",
      "introspect_copy": [
        "X-Auth-User",
        "X-Auth-Subject",
        "X-Auth-Email"
      ],
      "ntfy_jwt_pattern": "^Bearer eyJ",
      "ntfy_token_pattern": "^Bearer tk_"
    },
    "error_handler": {
      "status_codes": [
        502,
        503,
        504
      ],
      "error_html": "/srv/error.html"
    },
    "catch_all": {
      "domain": "*.diegonmarcos.com",
      "page": "/srv/error.html"
    },
    "messages": {
      "portless_placeholder": "Portless worker/sidecar — no HTTP endpoint",
      "db_catalog_template": "DB catalog — container={container} engine={engine} port={port} upstream={upstream} path={path} vm={vm}",
      "mcp_hub_fallback": "MCP Hub — use /g-workspace/mcp, /mail-mcp/mcp, /mattermost-mcp/mcp, /c3-infra-mcp/mcp, /c3-services-mcp/mcp, /kg-mcp/mcp",
      "app_hub_fallback": "Not Found"
    }
  },
  "containers": {
    "app": {
      "container_name": "caddy-public",
      "image": "ghcr.io/diegonmarcos/caddy-l4:latest",
      "port": 443,
      "extra_ports": [
        {
          "port": 8443,
          "protocol": "https",
          "monitor": false,
          "_comment": "Internal L7 server — the layer4 :443 mux PROXY-protocols pure-public SNIs here."
        },
        {
          "port": 2019,
          "protocol": "http",
          "monitor": false,
          "_comment": "Admin API bound to localhost:2019 only — local-only by design."
        }
      ],
      "port_env": null,
      "dns": "caddy-public.app",
      "public": true,
      "proxy": {
        "type": "special",
        "comment": "Caddy-public IS the public-edge reverse proxy — allowlist + forward-to-gcp-proxy"
      },
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./Caddyfile:/etc/caddy/Caddyfile:ro",
        "caddy_public_data:/data",
        "caddy_public_config:/config",
        "./logs:/var/log/caddy"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "https"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "caddy-l4",
    "image_tag": "latest",
    "arch": "amd64"
  }
}
