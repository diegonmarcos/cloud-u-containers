{
  "name": "windmill",
  "description": "Windmill workflow orchestration (windmill.diegonmarcos.com)",
  "category": "tools",
  "domain": "windmill.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/windmill"
  },
  "proxy": {
    "upstream": "windmill-app.app:8000",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/windmill"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
