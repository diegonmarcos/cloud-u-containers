{
  "name": "windmill",
  "description": "Windmill workflow orchestration (windmill.diegonmarcos.com)",
  "port": 8000,
  "dns": "windmill-app.app",
  "category": "tools",
  "domain": "windmill.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/windmill"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/windmill",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
