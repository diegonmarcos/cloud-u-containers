{
  "name": "windmill",
  "description": "Windmill workflow orchestration (windmill.diegonmarcos.com)",
  "dns": "windmill-app.app",
  "ports": {
    "app": 8000,
    "db": 5440
  },
  "category": "tools",
  "domain": "windmill.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/windmill"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/windmill",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "windmill-server",
      "image": "ghcr.io/windmill-labs/windmill:main",
      "port": 8000,
      "port_env": null,
      "dns": "windmill-app.app",
      "public": true,
      "proxy": { "domain": "windmill.diegonmarcos.com", "auth": "two_factor" },
      "healthcheck": "curl -f http://localhost:8000/api/version",
      "monitoring": { "tls_check": true },
      "volumes": [
        "windmill-server-data:/tmp/windmill",
        "/var/run/docker.sock:/var/run/docker.sock"
      ],
      "env_file": true,
      "depends_on": ["db"],
      "resources": { "limits": { "memory": "256M", "cpus": "0.5" }, "reservations": { "memory": "128M" } },
      "read_only": false
    },
    "db": {
      "container_name": "windmill-db",
      "image": "postgres:16-alpine",
      "port": 5440,
      "port_env": "PGPORT",
      "dns": "windmill-db.app",
      "public": false,
      "healthcheck": "pg_isready -U windmill -d windmill -p 5440",
      "volumes": [
        "windmill-db-data:/var/lib/postgresql/data"
      ],
      "env_file": true,
      "resources": { "limits": { "memory": "128M" }, "reservations": { "memory": "64M" } },
      "read_only": false,
      "db_user": "windmill",
      "db_name": "windmill"
    },
    "worker": {
      "container_name": "windmill-worker",
      "image": "ghcr.io/windmill-labs/windmill:main",
      "port": null,
      "port_env": null,
      "dns": "windmill-worker.app",
      "public": false,
      "healthcheck": null,
      "volumes": [
        "windmill-worker-data:/tmp/windmill",
        "/var/run/docker.sock:/var/run/docker.sock",
        "/opt/ssh-keys/windmill-worker:/home/windmill/.ssh:ro"
      ],
      "env_file": true,
      "depends_on": ["app"],
      "resources": { "limits": { "memory": "256M", "cpus": "0.5" }, "reservations": { "memory": "128M" } },
      "read_only": false
    }
  }
}
