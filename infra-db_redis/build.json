{
  "name": "redis",
  "description": "In-memory data store",
  "dns": "redis.app",
  "ports": {
    "app": 6379
  },
  "category": "data",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/redis",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "containers": {
    "app": {
      "container_name": "redis",
      "image": "redis:8.10.2-alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0",
      "port": 6379,
      "port_env": null,
      "dns": "redis.app",
      "public": false,
      "proxy": null,
      "healthcheck": "redis-cli -a \"$REDIS_PASSWORD\" --no-auth-warning ping | grep -q PONG",
      "volumes": [
        "/data/redis:/data"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "tcp",
      "db_engine": "redis"
    }
  },
  "backup": {
    "enabled": true,
    "databases": [
      {
        "type": "custom",
        "container": "redis",
        "dump_cmd": "redis-cli BGSAVE && sleep 2 && cat /data/dump.rdb"
      }
    ],
    "volumes": []
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "redis",
    "dockerfile": "Dockerfile",
    "arch": "amd64",
    "labels": {
      "org.opencontainers.image.source": "https://github.com/diegonmarcos/cloud-u-containers/tree/main/infra-db_redis",
      "org.opencontainers.image.licenses": "AGPL-3.0-only",
      "io.diegonmarcos.upstream.source": "https://github.com/redis/redis",
      "io.diegonmarcos.source-offer": "https://github.com/diegonmarcos/cloud-u-containers/blob/main/LICENSING.md#6a-source-offers-839"
    }
  },
  "redis": {
    "maxmemory": "128mb",
    "maxmemory_policy": "allkeys-lru"
  }
}
