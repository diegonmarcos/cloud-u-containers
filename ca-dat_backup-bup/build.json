{
  "name": "backup-bup",
  "enabled": false,
  "description": "Database Backups SSH Server (bup)",
  "category": "data",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/backup-bup",
    "compose_flags": "--build"
  },
  "ports": {
    "app": 2223
  },
  "containers": {
    "app": {
      "container_name": "bup-server",
      "port": 2223,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "backup-bup",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "upstream_image": "alpine:3.20",
  "build": {
    "headers_enforced": true
  }
}
