{
  "name": "google-workspace-mcp",
  "description": "Google Workspace MCP server \u2014 Gmail, Calendar, Drive, Docs, Sheets via HTTP transport",
  "dns": "g-workspace-mcp.app",
  "ports": {
    "app": 3104
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true"
  },
  "docker": {
    "image": "google-workspace-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "cmd": "uv sync --frozen --no-dev --extra disk",
      "entrypoint": "uv run main.py --transport streamable-http --tool-tier complete",
      "base_image": "python:3.11-slim",
      "apt": "curl"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/google-workspace-mcp"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/g-workspace"
    },
    "app_hub": false
  },
  "containers": {
    "app": {
      "container_name": "google-workspace-mcp",
      "image": "ghcr.io/diegonmarcos/google-workspace-mcp:latest",
      "port": 3104,
      "port_env": "PORT",
      "dns": "g-workspace-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/g-workspace"
      },
      "healthcheck": "/health",
      "monitoring": null,
      "volumes": [
        "./.secrets.d/GOOGLE_SERVICE_ACCOUNT_KEY:/run/secrets/service-account-key.json:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
