{
  "name": "quant-lab-full",
  "description": "Full quant stack: Jupyter + Analytics + ML + Risk + NautilusTrader + Postgres",
  "frozen": true,
  "category": "fin",
  "ports": {
    "app": 8890,
    "db": 5437
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/quant-lab-full"
  },
  "containers": {
    "research": {
      "container_name": "quant_full_research",
      "image": "quay.io/jupyter/scipy-notebook:latest",
      "port": 8890,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": "curl -sf http://localhost:8890/api || exit 1",
      "volumes": [
        "./notebooks:/home/jovyan/work",
        "quant_full_shared_data:/home/jovyan/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    },
    "analytics": {
      "container_name": "quant_full_analytics",
      "image": "python:3.12-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "./scripts:/app",
        "quant_full_shared_data:/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    },
    "ml_brain": {
      "container_name": "quant_full_ml",
      "image": "python:3.12-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "./models:/workspace/models",
        "quant_full_shared_data:/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    },
    "risk_manager": {
      "container_name": "quant_full_risk",
      "image": "python:3.12-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "./risk_reports:/reports",
        "quant_full_shared_data:/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    },
    "execution_engine": {
      "container_name": "quant_full_engine",
      "image": "python:3.12-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "volumes": [
        "./strategies:/app/strategies",
        "quant_full_shared_data:/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    },
    "db": {
      "container_name": "quant_full_db",
      "image": "postgres:16-alpine",
      "port": 5437,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB",
      "volumes": [
        "quant_full_pg_data:/var/lib/postgresql/data"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
