{
  "name": "authelia",
  "description": "SSO and 2FA authentication portal",
  "dns": "authelia.app",
  "ports": {
    "app": 9091,
    "redis": 6380
  },
  "category": "sec",
  "domain": "auth.diegonmarcos.com",
  "build": {
    "include_cloud_data": "true"
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/authelia",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "secrets": {
    "jwks_file": "jwks_key.yaml",
    "jwks_dest": "config/oidc_jwks.pem",
    "escape_dollars": true
  },
  "proxy": {
    "primary": {
      "domain": "auth.diegonmarcos.com",
      "auth": "bypass"
    },
    "app_hub": false
  },
  "health": {
    "path": "/api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true
  },
  "containers": {
    "app": {
      "container_name": "authelia",
      "image": "authelia/authelia:4.39.15",
      "port": 9091,
      "port_env": null,
      "dns": "authelia.app",
      "public": true,
      "proxy": {
        "domain": "auth.diegonmarcos.com",
        "auth": "bypass"
      },
      "healthcheck": "/api/health",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "./config:/config"
      ],
      "env_file": true,
      "depends_on": [
        "redis"
      ],
      "resources": null,
      "read_only": false,
      "db_path": "/config/db.sqlite3",
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/var/lib/authelia/db.sqlite3"
        }
      ]
    },
    "redis": {
      "container_name": "authelia-redis",
      "image": "redis:7-bookworm",
      "port": 6380,
      "port_env": null,
      "dns": "authelia-redis.app",
      "public": false,
      "healthcheck": null,
      "volumes": [
        "authelia_redis_data:/data"
      ],
      "env_file": true,
      "resources": null,
      "read_only": false,
      "protocol": "tcp"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "authelia",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  }
}
