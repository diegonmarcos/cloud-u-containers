{
  "name": "authelia",
  "description": "SSO and 2FA authentication portal",
  "category": "sec",
  "domain": "auth.diegonmarcos.com",
  "ports": {
    "app": 9091,
    "redis": 6380
  },
  "build": {
    "include_cloud_data": "true"
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/authelia"
  },
  "secrets": {
    "jwks_file": "jwks_key.yaml",
    "jwks_dest": "config/oidc_jwks.pem",
    "escape_dollars": true
  },
  "proxy": {
    "upstream": "authelia.app:9091",
    "auth": "bypass"
  },
  "health": {
    "path": "/api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
