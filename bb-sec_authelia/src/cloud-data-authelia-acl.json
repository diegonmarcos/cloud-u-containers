{
  "rules": [
    {
      "domain": "auth.diegonmarcos.com",
      "policy": "bypass",
      "service": "authelia"
    },
    {
      "domain": "vault.diegonmarcos.com",
      "policy": "bypass",
      "resources_bypass": ["^/api.*", "^/identity.*", "^/icons.*", "^/notifications.*", "^/attachments.*"],
      "resources_two_factor": ["^/admin.*"],
      "service": "vaultwarden"
    },
    {
      "domain": "db.diegonmarcos.com",
      "policy": "two_factor",
      "resources_bypass": ["^/api/.*"],
      "service": "nocodb"
    },
    {
      "domain": "*.diegonmarcos.com",
      "policy": "two_factor",
      "service": "_default"
    }
  ]
}
