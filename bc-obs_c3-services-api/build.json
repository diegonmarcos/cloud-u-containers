{
  "name": "c3-services-api",
  "enabled": false,
  "description": "C3 Services REST API \u2014 service API gateway Fastify API",
  "dns": "c3-services-api.app",
  "ports": {
    "app": 8082
  },
  "category": "obs",
  "domain": "api.diegonmarcos.com/services",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-services-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-api"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/services",
      "auth": "two_factor",
      "paths": {
        "/docs/json": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/services/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "c3-services-api",
      "image": "ghcr.io/diegonmarcos/c3-services-api:latest",
      "port": 8082,
      "port_env": "PORT",
      "dns": "c3-services-api.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/services",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
