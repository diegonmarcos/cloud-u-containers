{
  "name": "c3-services-api",
  "description": "C3 Services REST API — service API gateway Fastify API",
  "port": 8082,
  "dns": "c3-services-api.app",
  "category": "obs",
  "domain": "api.diegonmarcos.com/services",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-services-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-api"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/services",
      "auth": "two_factor",
      "paths": {
        "/docs/json": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/services/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
