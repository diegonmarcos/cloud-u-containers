{
  "name": "mail-mcp",
  "description": "Mail MCP server \u2014 IMAP/SMTP/Admin via Stalwart REST API",
  "dns": "mail-mcp.app",
  "category": "app",
  "docker": {
    "image": "mail-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/mail-mcp"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/mail-mcp"
    },
    "app_hub": false
  },
  "ports": {
    "app": 3103
  }
}
