{
  "name": "mail-mcp",
  "description": "Mail MCP server \u2014 IMAP/SMTP/Admin via Stalwart REST API",
  "dns": "mail-mcp.app",
  "category": "app",
  "build": {
    "include_cloud_data": "true"
  },
  "docker": {
    "image": "mail-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "npx tsx mcp/index.ts --http",
      "base_image": "node:22-slim",
      "apt": "dnsutils openssh-client"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/mail-mcp"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/mail-mcp"
    },
    "app_hub": false
  },
  "ports": {
    "app": 3103
  },
  "containers": {
    "app": {
      "container_name": "mail-mcp",
      "image": "ghcr.io/diegonmarcos/mail-mcp:latest",
      "port": 3103,
      "port_env": "PORT",
      "dns": "mail-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/mail-mcp"
      },
      "healthcheck": null,
      "monitoring": null,
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
