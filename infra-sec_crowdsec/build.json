{
  "name": "crowdsec",
  "description": "CrowdSec behavioral IDS/IPS engine — DORMANT placeholder (Cloudflare-off fallback). Container runs but detects/remediates nothing: empty acquisition, online API (CAPI) disabled, no bouncers wired.",
  "dns": "crowdsec.app",
  "ports": {
    "lapi": 8088,
    "metrics": 6062
  },
  "category": "sec",
  "domain": "crowdsec.diegonmarcos.com",
  "dormant": true,
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/crowdsec",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "crowdsec.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": false
  },
  "backup": {
    "enabled": false
  },
  "timezone": "Europe/Madrid",
  "containers": {
    "app": {
      "container_name": "crowdsec",
      "image": "crowdsecurity/crowdsec:v1.7.8",
      "port": 8088,
      "port_env": null,
      "dns": "crowdsec.app",
      "public": true,
      "proxy": {
        "domain": "crowdsec.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "cmd",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": false
      },
      "volumes": [
        "crowdsec_config:/etc/crowdsec",
        "crowdsec_data:/var/lib/crowdsec/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "64M"
        }
      },
      "read_only": false,
      "protocol": "http"
    }
  },
  "upstream_image": "crowdsecurity/crowdsec:v1.7.8",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "crowdsec",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "build": {
    "headers_enforced": true
  }
}
