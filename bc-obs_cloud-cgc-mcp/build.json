{
  "name": "cloud-cgc-mcp",
  "description": "Cloud CGC MCP — Code Graph Context: infra knowledge, specs, docs, semantic code search",
  "dns": "cloud-cgc-mcp.app",
  "ports": {
    "app": 3105
  },
  "category": "obs",
  "docker": {
    "image": "cloud-cgc-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "platform": "linux/arm64",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm install --omit=dev",
      "entrypoint": "npx tsx index.ts",
      "base_image": "node:22-slim",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-cgc-mcp",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/cloud-cgc-mcp"
    },
    "app_hub": false
  },
  "build": {
    "include_cloud_data": true,
    "headers_enforced": true
  },
  "runtime": {
    "git_root": "/home/diego/Mounts/Git",
    "data_path": "/data"
  },
  "containers": {
    "app": {
      "container_name": "cloud-cgc-mcp",
      "image": "ghcr.io/diegonmarcos/cloud-cgc-mcp:latest",
      "port": 3105,
      "port_env": "MCP_HTTP_PORT",
      "dns": "cloud-cgc-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/cloud-cgc-mcp"
      },
      "healthcheck": "/mcp",
      "monitoring": null,
      "volumes": [
        "./data:/data:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  }
}
