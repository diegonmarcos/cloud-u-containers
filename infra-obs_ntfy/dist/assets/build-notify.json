  "dedup": {
    "_comment": "Collapse identical `key` within window_secs. First event fires; repeats within the window are suppressed (counted). Keyed by (key, severity). Per-key override in `by_key`.",
    "window_secs": 300,
    "by_key": {}
  },
  "flap": {
    "_comment": "If a key transitions between alerting/recovered N times within window_secs, emit ONE `flapping` warn and mute further transitions until quiet for window_secs.",
    "enabled": true,
    "transitions": 4,
    "window_secs": 900,
    "mute_after_flap_secs": 1800
  },
  "escalation": {
    "_comment": "Unacked alerts escalate. A `warn` unacked for warn_to_crit_secs becomes `crit`; a `crit` unacked for crit_to_page_secs becomes `page`. Ack (via ntfy action button → broker ack endpoint) or recovery resets the ladder. Escalation is evaluated on each broker tick against persisted state.",
    "enabled": true,
    "warn_to_crit_secs": 900,
    "crit_to_page_secs": 1800
  },
  "recovery": {
    "_comment": "When a `recovered`/`*_ok` event arrives for a key that is currently alerting, emit a paired 'resolved' notice to the same channels the alert used, then clear the key's state. Pairing is by `key`.",
    "enabled": true,
    "notice_severity": "info"
  },
  "state": {
    "_comment": "Broker persists dedup/flap/escalation/recovery state to a small local JSON file (append-free, rewritten atomically). sqlite only if query latency ever matters — YAGNI for now.",
    "path": "/var/cache/ntfy/notify-state.json",
    "history_jsonl": "/var/cache/ntfy/notify-history.jsonl",
    "history_max_lines": 5000
  },
  "digest": {
    "_comment": "Daily + weekly rollup posted to ops_reports topic + email. Reads the reports history JSONL written by the tiered reports engine (Phase 1). weekly_day is emitted alongside the daily on that weekday.",
    "enabled": true,
    "daily_time": "08:00",
    "weekly_day": "monday",
    "topic": "ops_reports",
    "email": true,
    "reports_history_jsonl": "/opt/health/history/reports.jsonl"
  },
  "status_page": {
    "_comment": "status.json schema written by the reports engine (Phase 1), consumed by the front status page (PORTAL_DATA). Broker does not write it; the schema lives here as the shared contract. States: green|yellow|red|unknown|stale.",
    "output_path": "/opt/health/status.json",
    "public_url": "https://status.diegonmarcos.com",
    "topic_on_change": "health_endpoints"
  }
