{
  "name": "ntfy",
  "description": "Push notification server",
  "dns": "ntfy.app",
  "category": "tools",
  "domain": "rss.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/ntfy",
    "excludes": [
      "cache"
    ],
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "proxy": {
    "primary": {
      "domain": "rss.diegonmarcos.com",
      "auth": "ntfy-3tier"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "ports": {
    "app": 8090,
    "rss_gateway": 8091
  },
  "timezone": "Europe/Paris",
  "_topics_comment": "Source of truth for ntfy topics. Consumed by: (a) bc-obs_ntfy/src/code/topic-scanner.py (its own runtime topic list), (b) 2_configs/src/engines/parsers/ntfy.ts (publishes configs.ntfy.topics into _cloud-data-consolidated.json), (c) 2_configs/src/engines/cloud-data-config-derive.ts (emits topics into build-mattermost.json so chat-mattermost reads them via its src/build-mattermost.json symlink). Adding a topic = edit this array + rebuild; no separate sync-topics.sh or ntfy-topics.nix to chase.",
  "topics": [
    { "name": "all",                 "category": "universal", "desc": "Every message from every channel" },
    { "name": "dev_commits",         "category": "dev",       "desc": "Push/commit events" },
    { "name": "dev_pull-requests",   "category": "dev",       "desc": "PR open/close/merge events" },
    { "name": "dev_releases",        "category": "dev",       "desc": "Issues, releases, tags, forks" },
    { "name": "deploy_ship",         "category": "deploy",    "desc": "build.sh ship / GHA deploys" },
    { "name": "deploy_containers",   "category": "deploy",    "desc": "Container restarts, image pulls" },
    { "name": "health_mesh",         "category": "health",    "desc": "WireGuard mesh connectivity" },
    { "name": "health_endpoints",    "category": "health",    "desc": "HTTP service endpoint checks" },
    { "name": "health_dns",          "category": "health",    "desc": "DNS resolution checks" },
    { "name": "health_resources",    "category": "health",    "desc": "VM disk/memory/CPU usage" },
    { "name": "health_containers",   "category": "health",    "desc": "Docker container health" },
    { "name": "ops_backups",         "category": "ops",       "desc": "Backup freshness status" },
    { "name": "ops_reports",         "category": "ops",       "desc": "Daily/weekly summaries" },
    { "name": "sec_audit",           "category": "sec",       "desc": "Auth log analysis & brute-force detection" },
    { "name": "sec_tls",             "category": "sec",       "desc": "TLS certificate expiry warnings" },
    { "name": "sec_connections",     "category": "sec",       "desc": "SSH/sudo/connection events across VMs" },
    { "name": "sec_yara",            "category": "sec",       "desc": "YARA malware scanner alerts & status" }
  ],
  "_profiles_comment": "RSS profile groups — each profile is a named set of topic categories resolved at build time by the Nix flake into profiles-config.json. Cloud Mail and any RSS reader subscribe to ONE profile URL instead of N individual topic feeds. Categories: 'topics' key = explicit topic list; 'categories' key = all topics whose category field matches. Add a profile = edit here + rebuild; consumers (rss-gateway sidecar + Cloud Mail app) auto-pick up changes.",
  "profiles": [
    { "id": "security", "title": "Security",  "categories": ["sec"] },
    { "id": "cicd",     "title": "CI/CD",     "categories": ["dev", "deploy"] },
    { "id": "health",   "title": "Health",    "categories": ["health"] },
    { "id": "ops",      "title": "Ops",       "categories": ["ops"] },
    { "id": "all",      "title": "Everything","topics": ["all"] }
  ],
  "backup": {
    "enabled": true
  },
  "containers": {
    "app": {
      "container_name": "ntfy",
      "image": "binwiederhier/ntfy",
      "port": 8090,
      "port_env": null,
      "dns": "ntfy.app",
      "resources": {
        "limits": {
          "memory": "64M"
        },
        "reservations": {
          "memory": "16M"
        }
      },
      "public": true,
      "proxy": {
        "domain": "rss.diegonmarcos.com",
        "auth": "ntfy-3tier"
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./cache:/var/cache/ntfy",
        "./etc:/etc/ntfy"
      ],
      "env_file": true,
      "depends_on": [],
      "read_only": false,
      "db_path": "/var/cache/ntfy/cache.db",
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/var/cache/ntfy/cache.db"
        }
      ]
    },
    "syslog-bridge": {
      "container_name": "syslog-bridge",
      "image": "python:3.11-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./syslog-to-ntfy.py:/app/syslog-to-ntfy.py:ro",
        "./cache:/var/cache/ntfy",
        "/var/log:/var/log:ro"
      ],
      "env_file": false,
      "depends_on": [
        "app"
      ],
      "resources": {
        "limits": {
          "memory": "32M"
        },
        "reservations": {
          "memory": "8M"
        }
      },
      "read_only": false
    },
    "rss-gateway": {
      "container_name": "rss-gateway",
      "image": "python:3.11-slim",
      "port": 8091,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./rss-gateway.py:/app/rss-gateway.py:ro",
        "./configs/profiles-config.json:/etc/ntfy/profiles-config.json:ro"
      ],
      "env_file": false,
      "depends_on": [
        "app"
      ],
      "resources": {
        "limits": {
          "memory": "32M"
        },
        "reservations": {
          "memory": "8M"
        }
      },
      "read_only": false
    },
    "github-rss": {
      "container_name": "github-rss",
      "image": "python:3.11-slim",
      "port": null,
      "port_env": null,
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./github-rss-to-ntfy.py:/app/github-rss-to-ntfy.py:ro",
        "./cache:/var/cache/ntfy"
      ],
      "env_file": false,
      "depends_on": [
        "app"
      ],
      "resources": {
        "limits": {
          "memory": "32M"
        },
        "reservations": {
          "memory": "8M"
        }
      },
      "read_only": false
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "ntfy",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "build": {
    "headers_enforced": true
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/v1",
    "display_name": "ntfy Push Notifications",
    "description": "Push notification server with HTTP POST interface for sending messages to topics.",
    "auth": "bearer"
  }
}
