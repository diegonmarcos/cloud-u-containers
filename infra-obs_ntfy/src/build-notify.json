{
  "_comment": "Enterprise notification routing config. SoT for all producers (load-shedder, journal-ntfy, health-agent, reports). Consumed by notification broker and routing logic in scripts. Changes here take effect on next deploy.",
  "_source": "infra-obs_ntfy/src/build-notify.json",

  "ntfy": {
    "base_url": "https://rss.diegonmarcos.com",
    "wg_base_url": "http://10.0.0.6:8090",
    "timeout_secs": 5
  },

  "severity_levels": {
    "info":  { "priority": 1, "description": "Informational — routine events" },
    "warn":  { "priority": 3, "description": "Warning — investigate soon" },
    "crit":  { "priority": 4, "description": "Critical — action required" },
    "page":  { "priority": 5, "description": "Page — immediate response needed" }
  },

  "topic_routing": {
    "_comment": "Maps (event_category, severity) → ntfy topic. Categories match journal-ntfy.sh route() + load-shedder patterns.",
    "mesh":       { "warn": "health_mesh",      "crit": "health_mesh",      "page": "health_mesh"      },
    "containers": { "warn": "health_containers", "crit": "health_containers", "page": "health_containers" },
    "endpoints":  { "warn": "health_endpoints",  "crit": "health_endpoints",  "page": "health_endpoints"  },
    "resources":  { "warn": "health_resources",  "crit": "health_resources",  "page": "health_resources"  },
    "security":   { "warn": "sec_audit",         "crit": "sec_audit",         "page": "sec_audit"         },
    "tls":        { "warn": "sec_tls",           "crit": "sec_tls",           "page": "sec_tls"           },
    "deploy":     { "warn": "deploy_ship",       "crit": "deploy_ship",       "page": "deploy_ship"       },
    "backups":    { "warn": "ops_backups",       "crit": "ops_backups",       "page": "ops_backups"       }
  },

  "dedup": {
    "window_secs": 300,
    "max_per_window": 1,
    "_comment": "Same (unit, topic) within window_secs is suppressed. Prevents flood on repeated errors."
  },

  "escalation": {
    "enabled": true,
    "warn_to_crit_secs": 900,
    "crit_to_page_secs": 1800,
    "_comment": "Unresolved warn escalates to crit after 15m; crit escalates to page after 30m. Reset on recovery."
  },

  "recovery_notices": {
    "enabled": true,
    "_comment": "When a previously-alerted condition clears, send a resolved notice to the same topic."
  },

  "digest": {
    "daily_time": "08:00",
    "weekly_day": "monday",
    "topic": "ops_reports",
    "_comment": "Daily 08:00 summary and weekly rollup posted to ops_reports. Fed by T2/T3 history JSONL."
  },

  "status_page": {
    "output_path": "/opt/health/status.json",
    "topic_on_change": "health_endpoints",
    "_comment": "Written by tiered reports after each T1/T2 run. Served statically by dashboard-httpd."
  },

  "unit_patterns": {
    "_comment": "Maps systemd unit name patterns to event categories. Used by journal-ntfy.sh route() function.",
    "load-shedder":        "resources",
    "tier1-watchdog":      "resources",
    "wg-quick*":           "mesh",
    "wireguard*":          "mesh",
    "sshd":                "mesh",
    "dropbear":            "mesh",
    "docker*":             "containers",
    "containerd*":         "containers",
    "maddy":               "endpoints",
    "stalwart":            "endpoints",
    "mail-puller*":        "endpoints",
    "caddy":               "endpoints",
    "introspect-proxy":    "endpoints",
    "authelia":            "endpoints",
    "crowdsec":            "security",
    "fail2ban":            "security",
    "dagu*":               "deploy",
    "health-agent":        "resources",
    "evidence-collector*": "resources",
    "fluent-bit":          "resources",
    "log-shipper":         "resources"
  }
}
