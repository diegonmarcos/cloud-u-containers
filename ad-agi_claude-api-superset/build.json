{
  "name": "claude-api-superset",
  "description": "Claude API superset on oci-apps — one polyglot container: OpenAI /v1 + Ollama /api + Anthropic /v1/messages mimic backed by the subscription `claude` CLI (no metered key), with a vendored Headroom (Apache-2.0) compression hop and a savings dashboard. Successor to kg-bridge; usable as a local/remote fallback. Internal WG-only sidecar, never public.",
  "dns": "claude-api-superset.app",
  "ports": {
    "app": 3117,
    "ollama": 11436,
    "headroom": 8788
  },
  "category": "agi",
  "docker": {
    "image": "claude-api-superset",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "platform": "linux/arm64",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "entrypoint": "/app/start.sh",
      "base_image": "python:3.13-slim",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/claude-api-superset",
    "compose_flags": "--pull always --force-recreate"
  },
  "proxy": {
    "app_hub": false
  },
  "runtime": {
    "model": "claude-sonnet-4-6",
    "max_concurrency": 12,
    "call_timeout_ms": 180000,
    "headroom": {
      "enabled": true,
      "savings_profile": "agent-90",
      "min_tokens_to_compress": 250
    }
  },
  "containers": {
    "app": {
      "container_name": "claude-api-superset",
      "image": "ghcr.io/diegonmarcos/claude-api-superset:latest",
      "port": 3117,
      "port_env": "BRIDGE_PORT",
      "dns": "claude-api-superset.app",
      "public": false,
      "healthcheck": "/health",
      "monitoring": null,
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  }
}
