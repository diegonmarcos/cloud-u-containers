{
  "name": "c3-mcp-api",
  "description": "C3 \u2014 Cloud Control Center: MCP server + Fastify API (api.diegonmarcos.com)",
  "category": "sec",
  "domain": "api.diegonmarcos.com/c3-api",
  "docker": {
    "registry": "ghcr.io",
    "image": "diegonmarcos/c3-mcp-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-mcp-api",
    "sequential_restart": "true"
  },
  "build": {
    "include_config_json": "true"
  },
  "secrets": {
    "escape_dollars": "true"
  }
}
