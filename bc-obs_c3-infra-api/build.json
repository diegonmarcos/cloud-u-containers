{
  "name": "c3-infra-api",
  "description": "C3 REST API \u2014 Cloud Control Center Fastify API",
  "dns": "c3-infra-api.app",
  "ports": {
    "app": 8081
  },
  "category": "sec",
  "domain": "api.diegonmarcos.com/c3-api",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-infra-api",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-infra-api"
  },
  "build": {
    "include_cloud_data": "true"
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "primary": {
      "auth": "two_factor",
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/c3-api",
      "paths": {
        "/docs/json": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/c3-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "c3-infra-api",
      "image": "ghcr.io/diegonmarcos/c3-infra-api:latest",
      "port": 8081,
      "port_env": "PORT",
      "dns": "c3-infra-api.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/c3-api",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "/opt/ssh-keys/c3-infra-api:/root/.ssh:ro",
        "/nix/store:/nix/store:ro",
        "/home/ubuntu/.nix-profile/bin:/usr/local/nix-bin:ro",
        "~/.config/gcloud:/root/.config/gcloud",
        "c3_git_repos:/root/git"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
