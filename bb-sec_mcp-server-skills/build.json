{
  "name": "mcp-server-skills",
  "description": "C3 — Cloud Control Center: MCP server + Fastify API (api.diegonmarcos.com)",

  "docker": {
    "registry": "ghcr.io",
    "image": "diegonmarcos/c3-api",
    "dockerfile": "Dockerfile"
  },

  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-api",
    "sequential_restart": "true"
  },

  "build": {
    "include_config_json": "true"
  },

  "secrets": {
    "escape_dollars": "true"
  }
}
