# Copy to secrets.yaml and encrypt with sops (same recipient set as the other services).
AUTH_BROKER_GOOGLE_CLIENT_ID: ""
AUTH_BROKER_GOOGLE_CLIENT_SECRET: ""
AUTH_BROKER_GITHUB_CLIENT_ID: ""
AUTH_BROKER_GITHUB_CLIENT_SECRET: ""
AUTH_BROKER_COOKIE_SECRET: ""        # openssl rand -base64 32 | tr -- '+/' '-_'
_credentials:
  google:
    type: oauth
    url: https://console.cloud.google.com/apis/credentials
    client_id: ""
    client_secret: ""
  github:
    type: oauth
    url: https://github.com/settings/developers
    client_id: ""
    client_secret: ""
  cookie:
    type: token
    token: ""
