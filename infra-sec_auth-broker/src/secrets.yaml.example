# Copy to secrets.yaml and encrypt with sops (same recipient set as the other services).
# GitHub device flow needs NO secret (public GitHub CLI client id in build.json). The web redirect flow uses the owner's
# GitHub OAuth App (client id in build.json): its secret goes below; absent/empty = web leg off, device flow stays.
AUTH_BROKER_GOOGLE_CLIENT_ID: ""      # Google WEB application client (redirects in build.json)
AUTH_BROKER_GOOGLE_CLIENT_SECRET: ""
AUTH_BROKER_GITHUB_APP_CLIENT_SECRET: ""  # GitHub OAuth App secret (callback https://auth.diegonmarcos.com/oauth2/github/callback)
AUTH_BROKER_COOKIE_SECRET: ""        # openssl rand -base64 32 | tr -- '+/' '-_'
_credentials:
  google:
    type: oauth
    url: https://console.cloud.google.com/apis/credentials
    client_id: ""
    client_secret: ""
  cookie:
    type: token
    token: ""
