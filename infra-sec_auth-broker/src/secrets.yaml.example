# Copy to secrets.yaml and encrypt with sops (same recipient set as the other services).
# GitHub needs NO secret: the device flow uses the public GitHub CLI client id kept in build.json.
AUTH_BROKER_GOOGLE_CLIENT_ID: ""      # a "TVs and Limited Input devices" client
AUTH_BROKER_GOOGLE_CLIENT_SECRET: ""
AUTH_BROKER_COOKIE_SECRET: ""        # openssl rand -base64 32 | tr -- '+/' '-_'
_credentials:
  google:
    type: oauth
    url: https://console.cloud.google.com/apis/credentials
    client_id: ""
    client_secret: ""
  cookie:
    type: token
    token: ""
