# OCI Email Delivery fallback relay
# Used while AWS SES is in sandbox mode (production access pending)
fallback_relay = [smtp.email.eu-marseille-1.oci.oraclecloud.com]:587

# Combined SMTP credentials map (AWS primary + OCI fallback)
# Generated by init.sh from .secrets at deploy time
smtp_sasl_password_maps = texthash:/overrides/sasl_multi_passwd
