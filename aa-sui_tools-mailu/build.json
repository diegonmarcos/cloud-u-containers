{
  "name": "mailu",
  "description": "Mailu mail server stack (mail.diegonmarcos.com)",
  "category": "app",
  "domain": "mail.diegonmarcos.com",
  "build": {
    "preserve_symlinks": "true"
  },
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/mailu",
    "sequential_restart": true,
    "excludes": [
      "mail/**",
      "mailqueue/**",
      "data/**",
      "dkim/**",
      "filter/**",
      "redis/**",
      "webmail/**",
      "certs/**"
    ]
  },
  "compose": {
    "pre_hook": "init.sh",
    "post_hook": "setup.sh"
  },
  "proxy": {
    "upstream": "https://mailu.app:8444",
    "auth": "two_factor",
    "tls_skip_verify": true,
    "landing_page": "mymail",
    "l4_ports": [
      {
        "port": 993,
        "upstream": "mailu.app:993"
      },
      {
        "port": 465,
        "upstream": "mailu.app:465"
      },
      {
        "port": 587,
        "upstream": "mailu.app:587"
      }
    ]
  }
}
