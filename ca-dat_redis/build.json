{
  "name": "redis",
  "description": "In-memory data store",
  "dns": "redis.app",
  "ports": {
    "app": 6379
  },
  "category": "data",
  "build": {
    "include_cloud_data": "true"
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/redis",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "containers": {
    "app": {
      "container_name": "redis",
      "image": "redis:alpine",
      "port": 6379,
      "port_env": null,
      "dns": "redis.app",
      "public": false,
      "proxy": null,
      "healthcheck": "redis-cli ping",
      "volumes": [
        "/data/redis:/data"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  },
  "backup": {
    "databases": [
      {
        "type": "custom",
        "container": "redis",
        "dump_cmd": "redis-cli BGSAVE && sleep 2 && cat /data/dump.rdb"
      }
    ],
    "volumes": []
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "redis",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  }
}
