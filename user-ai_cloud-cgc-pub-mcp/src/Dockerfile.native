FROM ghcr.io/diegonmarcos/octocode-fastembed-graphrag-indexed-arm:latest
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates python3 python3-pip && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY code /app
COPY build.json /app/build.json
RUN git config --system --add safe.directory '*' && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y --no-install-recommends nodejs && npm install --omit=dev && pip3 install --break-system-packages --no-cache-dir pylance
RUN id -u appuser >/dev/null 2>&1 || useradd -r -m -u 10001 appuser; chown -R appuser /app
USER appuser
ENV HOME=/home/appuser

LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud-infra"
ENTRYPOINT []
CMD ["npx","tsx","index.ts"]
