{
  "name": "filebrowser",
  "description": "FileBrowser web file manager (NEW - not deployed yet)",
  "category": "app",
  "domain": "files.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/filebrowser"
  },
  "proxy": {
    "upstream": "filebrowser.app:3015",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/filebrowser"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
