{
  "name": "c3-services-mcp-api",
  "description": "C3 Services — Unified service API gateway: MCP server + Fastify API (api.diegonmarcos.com/services)",
  "category": "obs",
  "domain": "api.diegonmarcos.com/services",
  "docker": {
    "registry": "ghcr.io",
    "image": "diegonmarcos/c3-services-mcp-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-mcp-api",
    "sequential_restart": "true"
  },
  "build": {
    "include_config_json": "false"
  },
  "secrets": {
    "escape_dollars": "true"
  }
}
