{
  "name": "rig-agentic-sonn-14bq8",
  "description": "Rig Agentic AI (Heavy) — DeepSeek R1 14B Q8 agent with tool calling via C3 MCP",
  "port": 8091,
  "dns": "rig-agentic-sonn-14bq8.app",
  "category": "agi",
  "version": "0.2.0",
  "ports": {
    "app": 8091
  },
  "containers": {
    "app": {
      "container_name": "rig-agentic-sonn-14bq8",
      "port": 8091,
      "port_env": "RIG_PORT",
      "protocol": "http"
    }
  },
  "rig": {
    "ollama_service": "ollama",
    "ollama_model": "MFDoom/deepseek-r1-tool-calling:14b-qwen-distill-q8_0",
    "c3_api_url": "http://c3-api.app",
    "c3_mcp_url": "http://c3-mcp.app",
    "mattermost_service": "chat-mattermost",
    "mm_bot_mention": "@ollama-14bq8-ai",
    "guardrail_max_turns": 20,
    "self_healing_enabled": true,
    "rust_log": "rig_agentic=info"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "rig-agentic-sonn",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "cmd": "cargo build --release",
      "binary": "target/release/rig-agentic",
      "base_image": "debian:trixie-slim",
      "apt": "curl ca-certificates docker.io"
    }
  },
  "build": {
    "include_cloud_data": "true",
    "extra_copy": [
      "Cargo.toml",
      "Cargo.lock",
      "Dockerfile",
      "src"
    ],
    "headers_enforced": true
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/rig-agentic-sonn-14bq8",
    "compose_flags": "--build"
  }
}
