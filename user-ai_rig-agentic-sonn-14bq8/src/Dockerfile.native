FROM rust:1-bookworm AS native-build
WORKDIR /build
COPY . /build
RUN cargo build --release
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates docker.io && rm -rf /var/lib/apt/lists/*
COPY --from=native-build /build/target/release/rig-agentic /usr/local/bin/rig-agentic
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud"
CMD ["rig-agentic"]
