{
  "name": "c3-infra-mcp-api",
  "description": "C3 — Cloud Control Center: MCP infrastructure server + Fastify API (api.diegonmarcos.com)",
  "category": "sec",
  "domain": "api.diegonmarcos.com/c3-api",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-infra-mcp-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-infra-mcp-api",
    "sequential_restart": "true"
  },
  "build": {
    "include_cloud_data": "true"
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "upstream": "c3-api.app:8081",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "api.diegonmarcos.com",
    "base_path": "/c3-api",
    "paths": {
      "/docs/json": {
        "auth": "public"
      }
    }
  },
  "health": {
    "path": "/c3-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
