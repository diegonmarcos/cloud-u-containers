{
  "name": "smtp-proxy",
  "description": "HTTP-to-SMTP bridge for CF Email Routing (smtp.diegonmarcos.com)",
  "dns": "smtp-proxy.app",
  "category": "app",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "smtp.diegonmarcos.com",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "smtp-proxy",
    "dockerfile": "Dockerfile",
    "arch": "amd64",
    "native_build": {
      "cmd": "cargo build --release",
      "binary": "target/release/smtp-proxy",
      "base_image": "debian:bookworm-slim",
      "apt": "ca-certificates"
    }
  },
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/smtp-proxy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "proxy": {
    "primary": {
      "domain": "smtp.diegonmarcos.com",
      "auth": "none"
    },
    "app_hub": false
  },
  "ports": {
    "app": 8080
  },
  "containers": {
    "app": {
      "container_name": "smtp-proxy",
      "port": 8080,
      "port_env": "LISTEN_PORT",
      "dns": "smtp-proxy.app",
      "public": true,
      "proxy": {
        "domain": "smtp.diegonmarcos.com",
        "auth": "none"
      }
    }
  }
}