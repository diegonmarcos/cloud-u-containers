{
  "name": "smtp-proxy",
  "description": "HTTP-to-SMTP bridge — receives JSON email payloads from CF Worker and translates to SMTP. Public path: api.diegonmarcos.com/smtp-proxy-api/",
  "dns": "smtp-proxy.app",
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "api.diegonmarcos.com/smtp-proxy-api",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "smtp-proxy",
    "dockerfile": "Dockerfile",
    "arch": "amd64",
    "native_build": {
      "cmd": "cargo build --release",
      "binary": "target/release/smtp-proxy",
      "base_image": "debian:bookworm-slim",
      "apt": "ca-certificates"
    }
  },
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/smtp-proxy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/smtp-proxy-api",
      "auth": "bearer"
    },
    "app_hub": false
  },
  "ports": {
    "app": 8080
  },
  "containers": {
    "app": {
      "container_name": "smtp-proxy",
      "port": 8080,
      "port_env": "LISTEN_PORT",
      "dns": "smtp-proxy.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/smtp-proxy-api",
        "auth": "bearer"
      },
      "protocol": "http"
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/smtp-proxy-api",
    "endpoint_count": 1,
    "display_name": "SMTP-Proxy HTTP-to-SMTP Bridge API",
    "description": "POST raw RFC 5322 email body. Translates to SMTP and dual-delivers to maddy:25 + Stalwart:2025 over WG. Used by CF email-forwarder Worker for inbound mail (because CF Workers cannot make outbound TCP/25 connections — port 25 is GCP-blocked end-to-end).",
    "auth": "bearer"
  }
}
