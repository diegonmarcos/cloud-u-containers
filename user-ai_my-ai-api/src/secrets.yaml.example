# my-ai-api secrets (sops-encrypted in production).
#
# Copy this file to src/secrets.yaml, fill in your OpenRouter key, then
# sops-encrypt in place:
#
#   cp src/secrets.yaml.example src/secrets.yaml
#   # edit: OPENROUTER_API_KEY: sk-or-v1-…your-key…
#   sops -e -i src/secrets.yaml            # uses ~/.config/sops/age/keys.txt
#
# The build engine (step_secrets) runs `sops -d` → dist/.secrets and compose
# wires `env_file: dist/.secrets`, so OPENROUTER_API_KEY lands in the
# container env. NEVER commit the unencrypted src/secrets.yaml — only the
# sops-encrypted form (and this example) are safe to commit.
#
# Without src/secrets.yaml the container still comes up, but chat requests
# 502 (OPENROUTER_API_KEY unset) until the secret is wired.

OPENROUTER_API_KEY: sk-or-v1-REPLACE-ME
