{
  "name": "vaultwarden",
  "description": "Bitwarden password manager",
  "category": "mic",
  "domain": "vault.diegonmarcos.com",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/vaultwarden",
    "excludes": [
      "data"
    ]
  },
  "secrets": {
    "escape_dollars": true
  },
  "proxy": {
    "upstream": "vaultwarden.app:8880",
    "auth": "two_factor"
  }
}
