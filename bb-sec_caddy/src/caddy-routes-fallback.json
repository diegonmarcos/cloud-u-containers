{
  "_meta": {
    "description": "Caddy route definitions — consumed by flake.nix to generate Caddyfile",
    "format_version": 2
  },

  "l4_routes": [
    { "port": 993, "upstream": "10.0.0.3:993", "comment": "IMAPS — TLS passthrough to Maddy" },
    { "port": 465, "upstream": "10.0.0.3:465", "comment": "SMTPS — TLS passthrough to Maddy" },
    { "port": 587, "upstream": "10.0.0.3:587", "comment": "SMTP Submission — TCP passthrough to Maddy" }
  ],

  "routes": [
    {
      "domain": "auth.diegonmarcos.com",
      "upstream": "10.0.0.1:9091",
      "auth": "none",
      "comment": "Authelia itself — no forward_auth loop"
    },
    {
      "domain": "cal.diegonmarcos.com",
      "upstream": "10.0.0.6:5232",
      "comment": "Radicale CalDAV/CardDAV"
    },
    {
      "domain": "chat.diegonmarcos.com",
      "upstream": "10.0.0.6:8065",
      "comment": "Mattermost team chat",
      "bypass_paths": ["/api/v4/*"]
    },
    {
      "domain": "photos.diegonmarcos.com",
      "upstream": "10.0.0.6:3013",
      "landing_page": "myphotos",
      "comment": "PhotoPrism"
    },
    {
      "domain": "smtp.diegonmarcos.com",
      "upstream": "10.0.0.3:8080",
      "auth": "none",
      "comment": "HTTP-to-SMTP bridge for CF Email Routing"
    },
    {
      "domain": "workflows.diegonmarcos.com",
      "upstream": "10.0.0.3:8070",
      "comment": "Dagu workflow scheduler"
    },
    {
      "domain": "ide.diegonmarcos.com",
      "upstream": "10.0.0.6:8443",
      "comment": "Code Server IDE"
    },
    {
      "domain": "db.diegonmarcos.com",
      "upstream": "10.0.0.6:8085",
      "comment": "NocoDB"
    },
    {
      "domain": "sheets.diegonmarcos.com",
      "upstream": "10.0.0.6:3011",
      "comment": "Grist Sheets"
    },
    {
      "domain": "vault.diegonmarcos.com",
      "upstream": "10.0.0.1:8880",
      "auth": "none",
      "comment": "Vaultwarden password manager — own auth, Caddy → private backend"
    }
  ],

  "path_routes": [
    {
      "parent_domain": "api.diegonmarcos.com",
      "landing_page": "api",
      "comment": "API hub — path-based routing to backend APIs",
      "paths": [
        {
          "base_path": "/dash",
          "type": "github_pages",
          "github_path": "mcp-api-swagger",
          "redirect_bare": true,
          "comment": "C3 Dashboard from GitHub Pages"
        },
        {
          "base_path": "/c3-api",
          "upstream": "10.0.0.6:8081",
          "public_paths": ["/c3-api/docs/json"],
          "comment": "C3 — Cloud Control Center API"
        },
        {
          "base_path": "/services",
          "upstream": "10.0.0.6:8082",
          "public_paths": ["/services/docs/json"],
          "comment": "C3 Services — Unified Service API Gateway"
        },
        {
          "base_path": "/crawlee",
          "upstream": "10.0.0.6:3000",
          "public_paths": ["/crawlee/openapi.json"],
          "comment": "Crawlee scraping API"
        }
      ]
    },
    {
      "parent_domain": "app.diegonmarcos.com",
      "comment": "App hub — path-based routing",
      "fallback": "respond \"Not Found\" 404",
      "paths": [
        { "base_path": "/windmill", "upstream": "10.0.0.6:8000" },
        { "base_path": "/etherpad", "upstream": "10.0.0.6:3012" },
        { "base_path": "/filebrowser", "upstream": "10.0.0.6:3015" },
        { "base_path": "/hedgedoc", "upstream": "10.0.0.6:3018" },
        { "base_path": "/revealmd", "upstream": "10.0.0.6:3014" },
        { "base_path": "/dozzle", "upstream": "10.0.0.4:9999" },
        { "base_path": "/grafana", "upstream": "10.0.0.6:3016" },
        { "base_path": "/gitea", "upstream": "10.0.0.6:3017" },
        { "base_path": "/crawlee", "upstream": "10.0.0.6:3001" }
      ]
    },
    {
      "parent_domain": "cloud.diegonmarcos.com",
      "comment": "Cloud dashboard + spec viewer",
      "landing_page": "cloud",
      "paths": [
        {
          "base_path": "/spec",
          "upstream": "10.0.0.6:3080",
          "redirect_bare": true,
          "comment": "C3 spec viewer"
        }
      ]
    }
  ],

  "github_pages_proxies": [
    {
      "domain": "diegonmarcos.com, www.diegonmarcos.com",
      "github_path": "landpage",
      "wkd": true,
      "comment": "Landing page + WKD (Web Key Directory for PGP)"
    },
    { "domain": "linktree.diegonmarcos.com", "github_path": "linktree" },
    { "domain": "nexus.diegonmarcos.com", "github_path": "nexus" },
    { "domain": "suite.diegonmarcos.com", "github_path": "suite" },
    { "domain": "maps.diegonmarcos.com", "github_path": "mymaps" }
  ],

  "mcp_routes": [
    {
      "parent_domain": "mcp.diegonmarcos.com",
      "comment": "MCP — Streamable HTTP endpoints for Claude Code MCP clients",
      "fallback_message": "MCP Hub — use /c3-infra-mcp/mcp, /c3-services-mcp/mcp, /mattermost-mcp/mcp, /mail-mcp/mcp, /g-workspace/mcp",
      "endpoints": [
        { "base_path": "/c3-infra-mcp", "upstream": "10.0.0.6:3100" },
        { "base_path": "/c3-services-mcp", "upstream": "10.0.0.6:3101" },
        { "base_path": "/mattermost-mcp", "upstream": "10.0.0.6:3102" },
        { "base_path": "/mail-mcp", "upstream": "10.0.0.6:3103" },
        { "base_path": "/g-workspace", "upstream": "10.0.0.6:3104" }
      ]
    }
  ],

  "redirects": [
    {
      "domain": "webmail.diegonmarcos.com",
      "target": "https://mail.diegonmarcos.com/",
      "comment": "Legacy webmail subdomain → mail hub"
    }
  ],

  "special": {
    "mail": {
      "domain": "mail.diegonmarcos.com",
      "webmail_upstream": "10.0.0.3:8888",
      "landing_page": "mymail",
      "comment": "Mail hub — landing page + /webmail → SnappyMail + /servermail → static info"
    },
    "ntfy": {
      "domain": "rss.diegonmarcos.com",
      "upstream": "10.0.0.1:8090",
      "comment": "ntfy notifications — 3-tier auth: JWT bearer → introspect, tk_ bearer → direct, cookie → authelia"
    },
    "analytics": {
      "domain": "analytics.diegonmarcos.com",
      "comment": "Matomo (public tracking + protected admin) + Umami (path-based)",
      "matomo_upstream": "10.0.0.4:8080",
      "umami_upstream": "10.0.0.4:3000",
      "public_tracking_paths": [
        "/matomo.js", "/matomo.php", "/piwik.js", "/piwik.php",
        "/collect.php", "/api.php", "/track.php", "/js/*"
      ],
      "umami_public_paths": ["/umami/script.js", "/umami/api/send"]
    },
    "proxy_dashboard": {
      "domain": "proxy.diegonmarcos.com",
      "comment": "Infrastructure dashboard (static HTML)"
    }
  },

  "internal_routes": [],

  "auth_upstreams": {}
}
