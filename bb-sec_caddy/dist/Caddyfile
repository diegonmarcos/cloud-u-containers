  # ntfy notifications — 3-tier auth:
  # 1. Authelia JWT (eyJ...) → introspect-proxy → ntfy
  # 2. ntfy native tokens (tk_...) → pass through, ntfy validates internally
  # 3. Browser cookie sessions → Authelia forward_auth → ntfy
  rss.diegonmarcos.com {
import security
import request_limits
    handle /setup {
forward_auth authelia:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
      root * /srv
      rewrite * /ntfy-setup.html
      file_server
    }
    @authelia_jwt header_regexp Authorization "^Bearer eyJ"
    handle @authelia_jwt {
forward_auth introspect-proxy:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
      reverse_proxy ntfy:80
    }
    @ntfy_token header_regexp Authorization "^Bearer tk_"
    handle @ntfy_token {
      reverse_proxy ntfy:80
    }
    handle {
forward_auth authelia:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
      reverse_proxy ntfy:80
    }
    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
    rewrite * /error.html
    file_server
  }
}
  }

