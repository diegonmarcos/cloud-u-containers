  # SPECIAL ROUTES (from special{})
  # ════════════════════════════════════════════════════════════

  # Matomo (public tracking + protected admin) + Umami (path-based)
  analytics.diegonmarcos.com {
import security
import request_limits
    # Public tracking endpoints (no auth — called by portfolio sites)
    @tracking {
      path /matomo.js /matomo.php /piwik.js /piwik.php /collect.php /api.php /track.php /js/*
    }
    handle @tracking {
      reverse_proxy matomo.app:8080
    }

    # Umami Analytics (path-based, strip /umami prefix before proxying)
    @umami_public {
      path /umami/script.js /umami/api/send
    }
    handle @umami_public {
      uri strip_prefix /umami
      reverse_proxy umami.app:3000
    }
    handle_path /umami/* {
      @umami_bearer header Authorization Bearer*
      handle @umami_bearer {
forward_auth introspect-proxy.app:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
        reverse_proxy umami.app:3000
      }
      handle {
forward_auth authelia.app:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
        reverse_proxy umami.app:3000
      }
    }
    @umami_root path /umami
    handle @umami_root {
      redir /umami/ permanent
    }

    # Protected Matomo admin dashboard (catch-all for non-umami, non-tracking)
      @bearer header Authorization Bearer*
  handle @bearer {
forward_auth introspect-proxy.app:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
    reverse_proxy matomo.app:8080
  }
  handle {
forward_auth authelia.app:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
    reverse_proxy matomo.app:8080
  }


    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
    rewrite * /error.html
    file_server
  }
}
  }


  # ntfy notifications — 3-tier auth: JWT bearer → introspect, tk_ bearer → direct, cookie → authelia
  rss.diegonmarcos.com {
import security
import request_limits
    handle /setup {
forward_auth authelia.app:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
      root * /srv
      rewrite * /ntfy-setup.html
      file_server
    }
    @authelia_jwt header_regexp Authorization "^Bearer eyJ"
    handle @authelia_jwt {
forward_auth introspect-proxy.app:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
      reverse_proxy ntfy.app:8090
    }
    @ntfy_token header_regexp Authorization "^Bearer tk_"
    handle @ntfy_token {
      reverse_proxy ntfy.app:8090
    }
    handle {
forward_auth authelia.app:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
      reverse_proxy ntfy.app:8090
    }
    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
    rewrite * /error.html
    file_server
  }
}
  }


