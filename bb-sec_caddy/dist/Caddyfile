    }
    handle_path /mailu-mcp/* {
      reverse_proxy 10.0.0.6:3103 { flush_interval -1 }
    }

    handle {
      respond "MCP Hub — use /c3-mcp/mcp, /c3-services-mcp/mcp, /mattermost-mcp/mcp, /mailu-mcp/mcp" 200
    }
    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
    rewrite * /error.html
