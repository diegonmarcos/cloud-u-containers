  # Mail hub — landing page + /webmail → SnappyMail + /servermail → static info
  mail.diegonmarcos.com {
import security
import request_limits
    # / → landing page (PUBLIC — no auth)
    @root path /
    handle @root {
      rewrite * /mymail{uri}
reverse_proxy https://diegonmarcos.github.io {
  header_up Host diegonmarcos.github.io
}

    }

    # /servermail → Maddy info (PUBLIC — static HTML baked in image)
    handle /servermail/config {
      root * /srv/mail
      rewrite * /servermail-config.html
      file_server
    }
    handle /servermail* {
      root * /srv/mail
      rewrite * /servermail.html
      file_server
    }

    # /webmail → SnappyMail (AUTH, strip prefix so SnappyMail sees /)
    handle_path /webmail/* {
        @bearer header Authorization Bearer*
  handle @bearer {
forward_auth 10.0.0.1:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
    reverse_proxy 10.0.0.3:8888
  }
  handle {
forward_auth 10.0.0.1:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
    reverse_proxy 10.0.0.3:8888
  }

    }
    handle_path /webmail {
        @bearer header Authorization Bearer*
  handle @bearer {
forward_auth 10.0.0.1:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
    reverse_proxy 10.0.0.3:8888
  }
  handle {
forward_auth 10.0.0.1:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
    reverse_proxy 10.0.0.3:8888
  }

    }

    # /snappymail/... → SnappyMail assets (AUTH, no strip — direct proxy)
    handle /snappymail/* {
        @bearer header Authorization Bearer*
  handle @bearer {
forward_auth 10.0.0.1:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
    reverse_proxy 10.0.0.3:8888
  }
  handle {
forward_auth 10.0.0.1:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
    reverse_proxy 10.0.0.3:8888
  }

    }

    # Catch-all → landing page
    handle {
      rewrite * /mymail{uri}
reverse_proxy https://diegonmarcos.github.io {
  header_up Host diegonmarcos.github.io
}

    }

    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
    rewrite * /error.html
    file_server
  }
}
  }


  # Matomo (public tracking + protected admin) + Umami (path-based)
  analytics.diegonmarcos.com {
import security
import request_limits
    # Public tracking endpoints (no auth — called by portfolio sites)
    @tracking {
      path /matomo.js /matomo.php /piwik.js /piwik.php /collect.php /api.php /track.php /js/*
    }
    handle @tracking {
      reverse_proxy 10.0.0.4:8080
    }

    # Umami Analytics (path-based, strip /umami prefix before proxying)
    @umami_public {
      path /umami/script.js /umami/api/send
    }
    handle @umami_public {
      uri strip_prefix /umami
      reverse_proxy 10.0.0.4:3000
    }
    handle_path /umami/* {
      @umami_bearer header Authorization Bearer*
      handle @umami_bearer {
forward_auth 10.0.0.1:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
        reverse_proxy 10.0.0.4:3000
      }
      handle {
forward_auth 10.0.0.1:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
        reverse_proxy 10.0.0.4:3000
      }
    }
    @umami_root path /umami
    handle @umami_root {
      redir /umami/ permanent
    }

    # Protected Matomo admin dashboard (catch-all for non-umami, non-tracking)
      @bearer header Authorization Bearer*
  handle @bearer {
forward_auth 10.0.0.1:4182 {
  method GET
  uri /auth
  copy_headers X-Auth-User X-Auth-Subject X-Auth-Email
}
    reverse_proxy 10.0.0.4:8080
  }
  handle {
forward_auth 10.0.0.1:9091 {
  uri /api/authz/forward-auth
  copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
    reverse_proxy 10.0.0.4:8080
  }


    handle_errors {
  @backend_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
  handle @backend_error {
    root * /srv
