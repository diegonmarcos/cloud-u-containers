  {
    # DNS: all .app upstreams resolved by Hickory DNS (10.0.0.1:53)
    debug
    admin localhost:2019
    order respond before handle

    layer4 {
# IMAPS — TLS passthrough to Stalwart
:993 {
  route {
    proxy {
      upstream stalwart.app:993
    }
  }
}
# SMTPS — TLS passthrough to Stalwart
:465 {
  route {
    proxy {
      upstream stalwart.app:465
    }
  }
}
# SMTP Submission — TCP passthrough to Stalwart
:587 {
  route {
    proxy {
      upstream stalwart.app:587
    }
  }
}
    }

  }

  # ════════════════════════════════════════════════════════════
  # SECURITY SNIPPETS
  # ════════════════════════════════════════════════════════════

  (security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
}

  (rate_limiting) {
  rate_limit {
    zone global {
      key    {remote_host}
      events 100
      window 1m
    }
  }
}

  (block_bots) {
  @bad_bots header_regexp User-Agent "(?i)(sqlmap|nikto|masscan|nmap|zgrab|scrapy|dirbuster|gobuster|nuclei|wfuzz|havij|acunetix|nessus|openvas)"
  respond @bad_bots 403
}

  (block_scanners) {
  @blocked_paths path /wp-admin* /wp-login* /xmlrpc.php /.env /.git* /phpmyadmin* /actuator* /solr* /console* /.aws* /cgi-bin/*
  respond @blocked_paths 404
}

  (request_limits) {
  request_body {
    max_size 10MB
  }
}

  (ip_block) {
  # @blocked_ips remote_ip 192.0.2.0/24
  # respond @blocked_ips 403
}

  (access_log) {
  log {
    output file /var/log/caddy/access.log {
      roll_size 10mb
      roll_keep 5
    }
    format json
  }
}

  (security) {
  import security_headers
  import block_bots
  import block_scanners
  import rate_limiting
  import ip_block
  import access_log
}


