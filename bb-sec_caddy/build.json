{
  "name": "caddy",
  "description": "Caddy reverse proxy (replaces NPM on gcp-proxy + oci-mail)",

  "docker": {
    "registry": "ghcr.io",
    "image": "diegonmarcos/caddy-custom",
    "dockerfile": "Dockerfile.caddy",
    "binary": "/usr/bin/caddy",
    "binary_name": "caddy-binary"
  },

  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/caddy",
    "excludes": ["logs/"]
  },

  "secrets": {
    "escape_dollars": "true"
  }
}
