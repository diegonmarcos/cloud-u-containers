{
  "name": "authelia",
  "description": "SSO and 2FA authentication portal",
  "dns": "authelia.app",
  "ports": {
    "app": 9091,
    "redis": 6380
  },
  "category": "sec",
  "domain": "auth.diegonmarcos.com",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/authelia",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "secrets": {
    "jwks_file": "jwks_key.yaml",
    "jwks_dest": "config/oidc_jwks.pem",
    "escape_dollars": true
  },
  "proxy": {
    "primary": {
      "domain": "auth.diegonmarcos.com",
      "auth": "bypass",
      "oidc_public_paths": [
        "/.well-known/openid-configuration",
        "/api/oidc/token",
        "/jwks.json"
      ],
      "bypass_paths": [
        "/.well-known/openid-configuration",
        "/api/oidc/token",
        "/jwks.json"
      ]
    },
    "app_hub": false
  },
  "health": {
    "path": "/api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true
  },
  "containers": {
    "app": {
      "container_name": "authelia",
      "image": "authelia/authelia:4.39.15",
      "port": 9091,
      "port_env": null,
      "_doc_bind_host": "Caddy (host network, same VM) must dial the container directly on auth-net, NOT the host-published 10.0.0.1:9091 the deriver would otherwise compute from the VM's wg0 IP. Publishing to a WireGuard address makes the host-side hop go through docker-proxy, and that hairpin hangs: every auth.diegonmarcos.com request stalled ~15s and /api/health never answered. The address is pinned in src/compose.nix (auth-net ipv4_address, explicit 172.18.0.0/16 subnet) so it survives recreate. Only the derived Caddy/probe upstream reads this — the published port mapping comes from svc.authelia.ip in compose.nix and is unaffected.",
      "bind_host": "172.18.0.3",
      "dns": "authelia.app",
      "public": true,
      "proxy": {
        "domain": "auth.diegonmarcos.com",
        "auth": "bypass"
      },
      "healthcheck": "/api/health",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "authelia_data:/data",
        "./configs:/config:ro"
      ],
      "env_file": true,
      "depends_on": [
        "redis"
      ],
      "resources": null,
      "read_only": false,
      "db_path": "/data/db.sqlite3",
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/db.sqlite3"
        }
      ]
    },
    "redis": {
      "container_name": "authelia-redis",
      "image": "redis:7-bookworm",
      "port": 6380,
      "port_env": null,
      "dns": "authelia-redis.app",
      "public": false,
      "healthcheck": null,
      "volumes": [
        "authelia_redis_data:/data"
      ],
      "env_file": true,
      "resources": null,
      "read_only": false,
      "protocol": "tcp",
      "db_engine": "redis"
    },
    "postlite": {
      "container_name": "postlite-authelia",
      "image": "ghcr.io/diegonmarcos/postlite:latest",
      "port": null,
      "port_env": null,
      "public": false,
      "healthcheck": null,
      "volumes": [],
      "env_file": false,
      "depends_on": [
        "app"
      ],
      "resources": {
        "reservations": {
          "memory": "16M"
        }
      },
      "read_only": false,
      "protocol": "tcp"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "authelia",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "timezone": "Europe/Madrid",
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "display_name": "Authelia Auth API",
    "description": "OpenID Connect/OAuth2 authorization and 2FA authentication server with WebAuthn support.",
    "auth": "oidc"
  }
}
