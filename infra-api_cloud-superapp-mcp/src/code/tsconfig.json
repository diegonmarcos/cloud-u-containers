{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "lib-api/**/*.ts",
    "lib-mcp/**/*.ts",
    "mcps-apps/**/*.ts",
    "cloud-superapp-mcp/**/*.ts",
    "cloud-superapp-api/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
