{
  "name": "news-gdelt",
  "description": "GDELT News Aggregator — Fastify API with SQLite cache",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/news-gdelt",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "news-gdelt",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "node --experimental-strip-types server.ts",
      "base_image": "node:22-bookworm-slim",
      "apt": "curl ca-certificates python3 build-essential",
      "app_dir": "./code"
    }
  },
  "ports": {
    "app": 3019
  },
  "timezone": "Europe/Paris",
  "category": "tools",
  "health": {
    "path": "/health"
  },
  "containers": {
    "app": {
      "container_name": "news-gdelt",
      "image": "ghcr.io/diegonmarcos/news-gdelt:latest",
      "port": 3019,
      "protocol": "http",
      "port_env": "PORT"
    }
  },
  "build": {
    "headers_enforced": true
  }
}
