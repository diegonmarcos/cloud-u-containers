# ╔══════════════════════════════════════════════════════════════════╗
# ║ cloud-builder x86-apt                                          ║
# ║ ghcr.io/diegonmarcos/cloud-builder-x-deb-apt                    ║
# ║ Source: cb_containers-builders/src/Dockerfile.x86-apt          ║
# ║                                                                ║
# ║ Pure Debian builder — no Nix. Uses apt for all deps.           ║
# ║ Lighter + faster than nixos variant. For CI/CD pipelines.      ║
# ╚══════════════════════════════════════════════════════════════════╝

FROM debian:bookworm-slim

# ── System base ──────────────────────────────────────────────────
RUN apt-get update -qq && for pkg in \
    bash curl wget git git-lfs openssh-client rsync \
    jq sudo ca-certificates gnupg lsb-release \
    make gcc g++ python3 python3-pip \
    nodejs npm \
    unzip xz-utils locales; do \
      apt-get install -y -qq --no-install-recommends "$pkg" 2>/dev/null \
      || echo "[SKIP] $pkg not available"; \
    done \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# ── Docker CLI ───────────────────────────────────────────────────
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# ── sops + age ───────────────────────────────────────────────────
RUN curl -fsSL https://github.com/getsops/sops/releases/download/v3.9.4/sops-v3.9.4.linux.amd64 -o /usr/local/bin/sops \
    && chmod +x /usr/local/bin/sops \
    || echo "[SKIP] sops install failed"
RUN curl -fsSL https://github.com/FiloSottile/age/releases/download/v1.2.1/age-v1.2.1-linux-amd64.tar.gz | tar xz -C /tmp \
    && mv /tmp/age/age /tmp/age/age-keygen /usr/local/bin/ && rm -rf /tmp/age \
    || echo "[SKIP] age install failed"

# ── terraform ────────────────────────────────────────────────────
RUN curl -fsSL https://releases.hashicorp.com/terraform/1.9.8/terraform_1.9.8_linux_amd64.zip -o /tmp/tf.zip \
    && unzip -q /tmp/tf.zip -d /usr/local/bin && rm /tmp/tf.zip \
    || echo "[SKIP] terraform install failed"

# ── gh CLI ───────────────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update -qq && apt-get install -y -qq gh \
    && rm -rf /var/lib/apt/lists/* \
    || echo "[SKIP] gh install failed"

# ── Node modules (tsx, yaml, nunjucks for cloud engine) ──────────
RUN mkdir -p /root/.node_modules && cd /root/.node_modules \
    && npm install --silent tsx yaml nunjucks 2>/dev/null \
    && echo "Node modules installed: $(ls node_modules | wc -l) packages"

# ── Self-documenting ─────────────────────────────────────────────
RUN mkdir -p /opt/cloud-builder
COPY Dockerfile.x86-apt /opt/cloud-builder/Dockerfile
COPY docker/entrypoint.sh /opt/cloud-builder/entrypoint.sh
COPY docker/docker-up.sh /opt/cloud-builder/docker-up.sh
RUN chmod +x /opt/cloud-builder/entrypoint.sh /opt/cloud-builder/docker-up.sh

# ── Labels ───────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="cloud-builder-x-deb-apt"
LABEL org.opencontainers.image.description="cloud-builder — Debian apt CI/CD image (no Nix)"
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/unix"
LABEL diego.image.variant="x86-apt"
LABEL diego.image.ghcr="ghcr.io/diegonmarcos/cloud-builder-x-deb-apt"

ENV LANG=en_US.UTF-8
ENV NODE_PATH=/root/.node_modules/node_modules
ENV PATH="/root/.node_modules/node_modules/.bin:/usr/local/bin:/usr/bin:/bin:/sbin"

WORKDIR /workspace
ENTRYPOINT ["/opt/cloud-builder/entrypoint.sh"]
CMD []
