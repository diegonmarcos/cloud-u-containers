{
  "name": "openobserve",
  "description": "OpenObserve - single-binary observability platform (logs + traces + metrics + RUM). Replaces LGTM stack.",
  "dns": "openobserve.app",
  "ports": {
    "app": 5080
  },
  "category": "tools",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "analytics.diegonmarcos.com/openobserve",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/openobserve",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "upstream_image": "public.ecr.aws/zinclabs/openobserve:v0.14.7",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "openobserve",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "primary": {
      "wg_only": false,
      "type": "path",
      "parent_domain": "analytics.diegonmarcos.com",
      "base_path": "/openobserve",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/healthz"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "openobserve",
      "image": "public.ecr.aws/zinclabs/openobserve:v0.14.7",
      "port": 5080,
      "port_env": "ZO_HTTP_PORT",
      "dns": "openobserve.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "analytics.diegonmarcos.com",
        "base_path": "/openobserve",
        "auth": "two_factor"
      },
      "healthcheck": null,
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "openobserve_data:/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
      },
      "read_only": false,
      "port_format": "colon",
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "parquet",
          "path": "/data"
        }
      ]
    }
  },
  "api": {
    "type": "openapi",
    "spec_path": "/swagger/index.html",
    "base_path": "/api",
    "display_name": "OpenObserve HTTP API",
    "description": "Logs/metrics/traces/RUM ingest + SQL query API. OTLP-compatible. Auth via Bearer tokens (issued by OO admin).",
    "auth": "bearer"
  },
  "lifecycle": {
    "replaces_lgtm": [
      { "action": "compose_down",  "vm": "oci-apps", "path": "/opt/containers/lgtm" },
      { "action": "path_remove",   "vm": "oci-apps", "path": "/opt/containers/lgtm" }
    ],
    "replaces_lgtm_with_volumes": [
      { "action": "compose_down",  "vm": "oci-apps", "path": "/opt/containers/lgtm" },
      { "action": "path_remove",   "vm": "oci-apps", "path": "/opt/containers/lgtm" },
      { "action": "volume_remove", "vm": "oci-apps", "volume": "lgtm_grafana_data" },
      { "action": "volume_remove", "vm": "oci-apps", "volume": "lgtm_loki_data" },
      { "action": "volume_remove", "vm": "oci-apps", "volume": "lgtm_tempo_data" },
      { "action": "volume_remove", "vm": "oci-apps", "volume": "lgtm_mimir_data" }
    ]
  }
}
