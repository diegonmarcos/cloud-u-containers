{
  "name": "nocodb",
  "description": "NocoDB database spreadsheet (nocodb.diegonmarcos.com)",
  "category": "tools",
  "domain": "db.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/home/ubuntu/nocodb"
  },
  "proxy": {
    "upstream": "nocodb.app:8085",
    "auth": "two_factor"
  },
  "health": {
    "path": "/api/v1/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": ["nocodb_data"]
  }
}
