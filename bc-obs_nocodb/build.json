{
  "name": "nocodb",
  "description": "NocoDB database spreadsheet (nocodb.diegonmarcos.com)",
  "dns": "nocodb.app",
  "ports": {
    "app": 8085,
    "db": 5441
  },
  "category": "tools",
  "domain": "db.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/home/ubuntu/nocodb"
  },
  "proxy": {
    "primary": {
      "domain": "db.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/api/v1/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "nocodb_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "nocodb",
      "image": "nocodb/nocodb:latest",
      "port": 8085,
      "port_env": "PORT",
      "dns": "nocodb.app",
      "public": true,
      "proxy": {
        "domain": "db.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/api/v1/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "nocodb_data:/usr/app/data",
        "/mnt/gcloud-sqlite:/sqlite:ro"
      ],
      "env_file": true,
      "depends_on": [
        "db"
      ],
      "resources": null,
      "read_only": false
    },
    "db": {
      "container_name": "nocodb-db",
      "image": "postgres:16-bookworm",
      "port": 5441,
      "port_env": "PGPORT",
      "dns": null,
      "public": false,
      "proxy": null,
      "healthcheck": "cmd",
      "monitoring": null,
      "volumes": [
        "nocodb_postgres:/var/lib/postgresql/data"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "db_user": "nocodb",
      "db_name": "nocodb"
    }
  }
}
