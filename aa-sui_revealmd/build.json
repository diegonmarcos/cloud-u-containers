{
  "name": "revealmd",
  "description": "Reveal.js markdown presentations (NEW - not deployed yet)",
  "port": 3014,
  "dns": "revealmd.app",
  "ports": {"app": 3014},
  "category": "app",
  "domain": "slides.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/revealmd"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/revealmd",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
