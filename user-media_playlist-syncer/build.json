{
  "name": "playlist-syncer",
  "description": "Spotube — bidirectional Spotify <-> YouTube Music playlist sync (playlist.diegonmarcos.com). Self-hosted Soundiiz alternative.",
  "dns": "playlist-syncer.app",
  "ports": {
    "app": 8090
  },
  "category": "app",
  "domain": "playlist.diegonmarcos.com",
  "timezone": "Europe/Madrid",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/playlist-syncer",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "playlist.diegonmarcos.com",
      "auth": "two_factor",
      "bypass_paths": [
        "/api/auth/spotify/callback",
        "/api/auth/youtube/callback"
      ]
    }
  },
  "health": {
    "path": "/api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "strategy": "bup",
    "volumes": [
      "playlist_syncer_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "playlist-syncer",
      "image": "ghcr.io/diegonmarcos/playlist-syncer-binaries:latest",
      "port": 8090,
      "port_env": "PORT",
      "dns": "playlist-syncer.app",
      "public": true,
      "proxy": {
        "domain": "playlist.diegonmarcos.com",
        "auth": "two_factor",
        "bypass_paths": [
          "/api/auth/spotify/callback",
          "/api/auth/youtube/callback"
        ]
      },
      "healthcheck": "/api/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "playlist_syncer_data:/data"
      ],
      "env_file": true,
      "environment": {
        "APP_ENV": "production",
        "PUBLIC_URL": "https://playlist.diegonmarcos.com",
        "DB_PATH": "/data/spotube.db",
        "SESSION_SECURE": "true",
        "LOG_LEVEL": "info"
      },
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "playlist-syncer",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "build_args": {
      "SPOTUBE_REF": "ac67b81f8eb9464db42aca0f26fbfea6e2386784"
    }
  },
  "build": {
    "headers_enforced": true
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "display_name": "Playlist Syncer",
    "description": "Bidirectional Spotify / YouTube Music playlist sync (Spotube fork). REST API + web UI.",
    "auth": "bearer"
  }
}
