{
  "name": "cloud-notes-web",
  "taxonomy": {"group": "Cloud Apps", "category": "Data Apps"},
  "description": "Cloud Notes web: the notes app (Miro + Notion + Obsidian) served as static files at notes.diegonmarcos.com behind the edge gate (Authelia 2FA or fleet Bearer). Built by cloud-u-android ship-cloud-notes.yml (ghcr.io/diegonmarcos/cloud-notes-web).",
  "dns": "cloud-notes-web.mesh.diegonmarcos.com",
  "category": "app",
  "timezone": "Europe/Madrid",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "notes.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-notes-web",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "notes.diegonmarcos.com",
      "auth": "two_factor",
      "identity": {
        "header": "X-Remote-User",
        "bearer": {"claude-admin": "diego"},
        "session": {"me@diegonmarcos.com": "diego"},
        "_doc": "Header auth (#1147): the hub caddy strips any inbound header of this name before forward_auth, sets it only from these tables (Authelia username in Remote-User, or fleet client_id in X-Auth-User), and answers 403 for a validated identity with no row. Mechanism in infra-sec_caddy/src/identity.nix."
      }
    }
  },
  "health": {
    "path": "/healthz"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "ports": {
    "app": 8097
  },
  "containers": {
    "app": {
      "container_name": "cloud-notes-web",
      "image": "ghcr.io/diegonmarcos/cloud-notes-web-binaries:latest",
      "port": 8097,
      "port_env": null,
      "dns": "cloud-notes-web.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "domain": "notes.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/healthz",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "cloud-notes-web-binaries",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "upstream_image": "ghcr.io/diegonmarcos/cloud-notes-web:latest",
  "resources": {
    "mem_reservation": "16M"
  },
  "api": {
    "type": "no-api"
  }
}
