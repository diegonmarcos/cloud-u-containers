{
  "name": "affine",
  "description": "AFFiNE Collaborative Workspace (drive-notes-affine.diegonmarcos.com) — deployed via hedgedoc flake",
  "category": "app",
  "domain": "drive-notes-affine.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/affine"
  },
  "proxy": {
    "upstream": "affine.app:3010",
    "auth": "two_factor",
    "max_upload": "100MB",
    "timeout": "3600s"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": ["affine_data"]
  }
}
