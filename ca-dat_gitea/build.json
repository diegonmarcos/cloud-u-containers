{
  "name": "gitea",
  "description": "Self-hosted Git service",
  "category": "data",
  "domain": "git.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/gitea"
  },
  "proxy": {
    "upstream": "gitea.app:3017",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/gitea"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": ["gitea_data"]
  }
}
