{
  "name": "gitea",
  "description": "Self-hosted Git service",
  "dns": "gitea.app",
  "ports": {
    "app": 3017
  },
  "category": "data",
  "domain": "git.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/gitea"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/gitea",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "gitea_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "gitea",
      "image": "gitea/gitea:latest",
      "port": 3017,
      "port_env": "GITEA__server__HTTP_PORT",
      "dns": "gitea.app",
      "public": true,
      "proxy": { "domain": "git.diegonmarcos.com", "auth": "two_factor" },
      "healthcheck": "curl -f http://localhost:3017/",
      "monitoring": { "tls_check": true },
      "volumes": [
        "gitea_data:/data",
        "/etc/timezone:/etc/timezone:ro",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "env_file": false,
      "resources": null,
      "read_only": false
    }
  }
}
