{
  "name": "gitea",
  "description": "Self-hosted Git service",
  "dns": "gitea.app",
  "ports": {
    "app": 3002
  },
  "category": "data",
  "domain": "git.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/gitea",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "app.diegonmarcos.com",
      "base_path": "/gitea",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "ssh_port": 2222,
  "gitea": {
    "org": "diego",
    "mirrors": {
      "unix": {
        "upstream": "https://github.com/diegonmarcos/unix.git"
      },
      "cloud": {
        "upstream": "https://github.com/diegonmarcos/cloud.git"
      },
      "cloud-data": {
        "upstream": "https://github.com/diegonmarcos/cloud-data.git"
      },
      "front": {
        "upstream": "https://github.com/diegonmarcos/front.git"
      },
      "front-data": {
        "upstream": "https://github.com/diegonmarcos/front-data.git"
      },
      "tools": {
        "upstream": "https://github.com/diegonmarcos/tools.git"
      },
      "vault": {
        "upstream": "https://github.com/diegonmarcos/vault.git",
        "private": true
      }
    },
    "mirror_interval": "1h"
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "gitea_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "gitea",
      "image": "gitea/gitea:latest",
      "port": 3002,
      "port_env": "GITEA__server__HTTP_PORT",
      "dns": "gitea.app",
      "public": true,
      "proxy": {
        "domain": "git.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "curl -f http://localhost:3002/",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "gitea_data:/data",
        "/etc/timezone:/etc/timezone:ro",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "env_file": false,
      "resources": null,
      "read_only": false,
      "db_path": "/data/gitea/gitea.db",
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/data/gitea/gitea.db"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "gitea",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  }
}
