{
  "account": "me@diegonmarcos.com",
  "delivery_strategy": "unified-inbox",
  "generated_by": "_shared/lib/mail-rules.nix",
  "inbox_copy_flags": [
    "\\Seen"
  ],
  "routing_default": "91    📬 Others (fallback)",
  "rules": [
    {
      "folder": "93    🚫 Junk",
      "id": "route.junk.spam_flagged",
      "priority": 30,
      "when": {
        "any_of": [
          {
            "header": "X-Spam-Status",
            "type": "header_contains",
            "values": [
              "Yes"
            ]
          },
          {
            "header": "X-Spam-Flag",
            "type": "header_contains",
            "values": [
              "YES"
            ]
          },
          {
            "header": "X-Microsoft-Antispam-Message-Info",
            "type": "header_contains",
            "values": [
              "spam"
            ]
          },
          {
            "header": "Authentication-Results",
            "type": "header_contains",
            "values": [
              "dmarc=fail",
              "spf=fail"
            ]
          }
        ]
      }
    },
    {
      "folder": "31    🎓 Development & Tech",
      "id": "route.profile.42_school",
      "priority": 50,
