{
  "name": "syncthing",
  "description": "Syncthing file synchronization",
  "category": "mic",
  "domain": "sync.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/syncthing"
  },
  "proxy": {
    "upstream": "syncthing.app:8384",
    "auth": "two_factor"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
