{
  "name": "ollama-arm",
  "enabled": false,
  "archived_at": "2026-07-31",
  "archived_reason": "was already frozen:true; no live container on any reachable VM",
  "description": "Ollama LLM server (ARM CPU, 7b models)",
  "category": "agi",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "frozen": true,
  "deploy": {
    "host": "oci-apps-2",
    "remote_path": "/opt/containers/ollama-arm",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "ollama-arm"
  },
  "ports": {
    "app": 11434
  },
  "containers": {
    "app": {
      "container_name": "ollama-arm",
      "port": 11434,
      "port_env": "OLLAMA_HOST",
      "port_format": "host",
      "protocol": "http"
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api",
    "endpoint_count": 16,
    "display_name": "Ollama LLM API (ARM)",
    "description": "REST API for LLM inference, embeddings, model management on ARM CPU.",
    "auth": "none"
  }
}
