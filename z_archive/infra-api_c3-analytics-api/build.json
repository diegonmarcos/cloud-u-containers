{
  "name": "c3-analytics-api",
  "enabled": false,
  "archived_at": "2026-07-31",
  "archived_reason": "retired project, never deployed, moved to z_archive",
  "description": "Public first-party analytics collector — passthrough proxy to matomo/umami/openobserve",
  "dns": "c3-analytics-api.app",
  "ports": {
    "app": 8085
  },
  "category": "obs",
  "domain": "api.diegonmarcos.com/c3a",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-analytics-api",
    "dockerfile": "Dockerfile",
    "arch": "amd64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev && npx tsx tracker-src/build.ts",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates curl",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/c3-analytics-api"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/c3a",
      "auth": "none"
    }
  },
  "health": {
    "path": "/c3a/healthz"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "c3-analytics-api",
      "image": "ghcr.io/diegonmarcos/c3-analytics-api:latest",
      "port": 8085,
      "port_env": "PORT",
      "dns": "c3-analytics-api.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/c3a",
        "auth": "none"
      },
      "healthcheck": "/healthz",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "backends": {
    "e": {
      "service": "matomo",
      "rewrite_path": "/matomo.php",
      "description": "Matomo Tracking API",
      "methods": ["GET", "POST"]
    },
    "s": {
      "service": "umami",
      "rewrite_path": "/api/send",
      "description": "Umami /api/send",
      "methods": ["POST"]
    },
    "l": {
      "service": "openobserve",
      "rewrite_path": "/api/default/default/_json",
      "description": "OpenObserve _json bulk ingest",
      "methods": ["POST"],
      "auth_header_env": "OPENOBSERVE_AUTHORIZATION"
    }
  },
  "sites": [
    {
      "id": "diegonmarcos-com",
      "origins": [
        "https://diegonmarcos.com",
        "https://www.diegonmarcos.com"
      ],
      "matomo_idsite": null,
      "umami_website_id": null,
      "openobserve_stream": "diegonmarcos-com"
    }
  ],
  "limits": {
    "max_body_bytes": 1048576,
    "max_ingest_lines": 5000,
    "rate_per_ip_per_min": 60,
    "rate_per_sid_per_min": 1000,
    "tracker_cache_seconds": 300,
    "request_timeout_ms": 5000
  },
  "api": {
    "type": "openapi",
    "spec_path": "/c3a/docs/json",
    "base_path": "/c3a",
    "display_name": "C3 Analytics Public Collector",
    "description": "Public passthrough analytics collector. Browsers/sites POST to /c3a/{e|s|l}, file ingest /c3a/f, tracker /c3a/t.js.",
    "auth": "none"
  }
}
