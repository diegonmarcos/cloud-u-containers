{
  "name": "snappymail",
  "description": "SnappyMail webmail client (mail.diegonmarcos.com/webmail)",
  "dns": "snappymail.app",
  "ports": {
    "app": 8888
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/snappymail",
    "excludes": [
      "data/**"
    ],
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "configs/init.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "snappymail-binaries",
    "dockerfile": "code/amd64/Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "_retired_2026-09-03": "webmail.diegonmarcos.com handed off to cloud-webmail (root-fr/jmap-webmail rebrand, native JMAP); SnappyMail retired."
  },
  "containers": {
    "app": {
      "container_name": "snappymail",
      "image": "djmaze/snappymail:latest",
      "port": 8888,
      "port_env": null,
      "dns": "snappymail.app",
      "public": true,
      "proxy": null,
      "healthcheck": "/",
      "monitoring": null,
      "volumes": [
        "./data:/var/lib/snappymail"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_reservation": "16M"
      },
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/var/lib/snappymail"
        }
      ]
    }
  },
  "upstream_image": "djmaze/snappymail:latest",
  "resources": {
    "mem_reservation": "16M"
  }
}
