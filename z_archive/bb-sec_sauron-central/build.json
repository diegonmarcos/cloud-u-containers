{
  "name": "sauron-central",
  "enabled": false,
  "description": "Central Syslog Collector + SIEM API",
  "category": "sec",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/sauron-central",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "sauron-central",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "containers": {
    "syslog": {
      "container_name": "syslog-central",
      "upstream_image": "ghcr.io/axoflow/axosyslog:4.8.1"
    },
    "api": {
      "container_name": "siem-api",
      "upstream_image": "python:3.11-slim"
    }
  },
  "build": {
    "headers_enforced": true
  }
}
