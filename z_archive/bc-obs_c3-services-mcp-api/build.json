{
  "name": "c3-services-mcp-api",
  "description": "C3 Services — Unified service API gateway: MCP server + Fastify API (api.diegonmarcos.com/services)",
  "port": 8082,
  "dns": "c3-services.app",
  "category": "obs",
  "domain": "api.diegonmarcos.com/services",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-services-mcp-api",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-mcp-api",
    "sequential_restart": "true"
  },
  "build": {
    "include_cloud_data": "false"
  },
  "proxy": {
    "upstream": "c3-services.app:8082",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "api.diegonmarcos.com",
    "base_path": "/services",
    "paths": {
      "/docs/json": {
        "auth": "public"
      }
    },
    "additional_routes": [
      {
        "upstream": "c3-services-mcp-api.app:3101",
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/c3-services-mcp"
      }
    ]
  },
  "health": {
    "path": "/services/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
