{
  "name": "sauron-forwarder",
  "description": "Alert forwarding to central sauron",
  "dns": "sauron-forwarder.app",
  "category": "tools",
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "/opt/containers/sauron-forwarder",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "upstream_image": "debian:bookworm-slim",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "sauron-forwarder",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  }
}