{
  "name": "contacts-radicale",
  "description": "Radicale CardDAV server (contacts / address books) — contacts.diegonmarcos.com",
  "dns": "contacts.app",
  "upstream_image": "tomsquest/docker-radicale:latest",
  "ports": {
    "app": 5233
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "contacts.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/contacts-radicale",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "contacts.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/.web/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "contacts-radicale",
      "image": "tomsquest/docker-radicale:latest",
      "port": 5233,
      "port_env": null,
      "dns": "contacts.app",
      "public": true,
      "proxy": {
        "domain": "contacts.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/.web/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./data:/data",
        "./configs/config:/config/config:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/data/collections"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "contacts-radicale",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "api": {
    "type": "custom-protocol",
    "base_path": "/.well-known/carddav",
    "display_name": "Radicale CardDAV Server (Contacts)",
    "description": "WebDAV-based CardDAV server for contact / address-book synchronization.",
    "auth": "basic"
  }
}
