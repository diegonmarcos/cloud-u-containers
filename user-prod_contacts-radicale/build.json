{
  "name": "contacts-radicale",
  "taxonomy": {"group": "Cloud Apps", "category": "Data Apps"},
  "description": "Radicale CardDAV server (contacts / address books) — contacts.diegonmarcos.com",
  "dns": "contacts.mesh.diegonmarcos.com",
  "dns_aliases": ["contacts-radicale.mesh.diegonmarcos.com"],
  "upstream_image": "tomsquest/docker-radicale:latest",
  "ports": {
    "app": 5233
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "contacts.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/contacts-radicale",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "domain": "contacts.diegonmarcos.com",
      "auth": "two_factor",
      "identity": {
        "header": "X-Remote-User",
        "bearer": {"claude-admin": "me@diegonmarcos.com"},
        "session": {"me@diegonmarcos.com": "me@diegonmarcos.com"},
        "_doc": "Header auth (#1147): the hub caddy strips any inbound header of this name before forward_auth, sets it only from these tables (Authelia username in Remote-User, or fleet client_id in X-Auth-User), and answers 403 for a validated identity with no row. Mechanism in infra-sec_caddy/src/identity.nix."
      }
    }
  },
  "health": {
    "path": "/.web/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "contacts-radicale",
      "image": "tomsquest/docker-radicale:latest",
      "port": 5233,
      "port_env": null,
      "dns": "contacts.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "domain": "contacts.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/.web/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./data:/data",
        "./configs/config:/config/config:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/data/collections"
        }
      ]
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "contacts-radicale",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "api": {
    "type": "custom-protocol",
    "base_path": "/.well-known/carddav",
    "display_name": "Radicale CardDAV Server (Contacts)",
    "description": "WebDAV-based CardDAV server for contact / address-book synchronization.",
    "auth": "basic"
  }
}
