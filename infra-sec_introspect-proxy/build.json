{
  "name": "introspect-proxy",
  "description": "OIDC token introspection sidecar for Caddy Bearer auth",
  "dns": "introspect-proxy.app",
  "ports": {
    "app": 4182
  },
  "bind_host": "10.0.0.1",
  "category": "sec",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/introspect-proxy",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "docker": {
    "image": "introspect-proxy",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "amd64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "pip install --no-cache-dir -r requirements.txt",
      "entrypoint": "gunicorn --bind 127.0.0.1:4182 --workers 1 --threads 1 --timeout 120 main:app",
      "base_image": "python:3.11-slim",
      "app_dir": "code"
    }
  },
  "proxy": {
    "app_hub": false
  },
  "containers": {
    "app": {
      "container_name": "introspect-proxy",
      "image": "ghcr.io/diegonmarcos/introspect-proxy:latest",
      "port": 4182,
      "port_env": null,
      "dns": "introspect-proxy.app",
      "public": false,
      "proxy": null,
      "healthcheck": "/health",
      "monitoring": null,
      "volumes": [],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "resources": {
    "mem_reservation": "16M"
  },
  "build": {
    "headers_enforced": true
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/",
    "endpoint_count": 2,
    "display_name": "JWT Introspection Proxy",
    "description": "Validates bearer JWT tokens locally using Authelia JWKS public keys for Caddy forward_auth.",
    "auth": "bearer"
  }
}
