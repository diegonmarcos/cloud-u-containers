{
  "name": "c3-services-mcp",
  "description": "C3 Services MCP Server — service API gateway MCP transport (stdio + HTTP)",
  "dns": "c3-services-mcp.app",
  "ports": {
    "app": 3101
  },
  "category": "obs",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-services-mcp",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates curl"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-mcp",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/c3-services-mcp"
    },
    "app_hub": false
  },
  "runtime": {
    "init": true,
    "pids_limit": 512,
    "_why_init": "proxy-mcp spawns no children, but tini is cheap insurance against future regressions and unblocks Node SIGTERM handling."
  },
  "proxied_mcps": {
    "_note": "URLs resolved at flake build time from cloud-data services{}. Container runs in bridge mode, so 127.0.0.1 will NOT reach host-bound services — we MUST use the WG IP (10.0.0.6) of whichever VM hosts the child MCP.",
    "infra": [
      {
        "name": "cloud-cgc-mcp",
        "service": "cloud-cgc-mcp",
        "path": "/mcp"
      }
    ],
    "user": [
      {
        "name": "mattermost-mcp",
        "service": "mattermost-mcp",
        "path": "/mcp"
      },
      {
        "name": "mail-mcp",
        "service": "mail-mcp",
        "path": "/mcp"
      },
      {
        "name": "google-workspace-mcp",
        "service": "google-workspace-mcp",
        "path": "/mcp"
      }
    ],
    "retry": {
      "initial_ms": 10000,
      "max_ms": 120000,
      "max_retry_state_entries": 32,
      "_why": "Bounded LRU so the retry-state Map can never grow beyond the declared child count (OOM H1 root cause). max_ms caps exponential backoff per child."
    }
  },
  "containers": {
    "app": {
      "container_name": "c3-services-mcp",
      "image": "ghcr.io/diegonmarcos/c3-services-mcp:latest",
      "port": 3101,
      "port_env": "MCP_HTTP_PORT",
      "dns": "c3-services-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/c3-services-mcp"
      },
      "healthcheck": "/mcp",
      "monitoring": null,
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": {
        "mem_limit": "1G",
        "mem_reservation": "128M",
        "pids_limit": 256
      },
      "restart_policy": "unless-stopped",
      "read_only": false,
      "protocol": "http"
    }
  }
}
