{
  "name": "c3-services-mcp",
  "description": "C3 Services MCP Server \u2014 service API gateway MCP transport (stdio + HTTP)",
  "dns": "c3-services-mcp.app",
  "ports": {
    "app": 3101
  },
  "category": "obs",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-services-mcp",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates curl"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-services-mcp"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/c3-services-mcp"
    },
    "app_hub": false
  },
  "containers": {
    "app": {
      "container_name": "c3-services-mcp",
      "image": "ghcr.io/diegonmarcos/c3-services-mcp:latest",
      "port": 3101,
      "port_env": "MCP_HTTP_PORT",
      "dns": "c3-services-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/c3-services-mcp"
      },
      "healthcheck": "/mcp",
      "monitoring": null,
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
