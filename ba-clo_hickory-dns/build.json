{
  "name": "hickory-dns",
  "description": "Internal DNS server for WireGuard mesh (per-service .app zones)",
  "dns": "hickory-dns.app",
  "ports": {
    "dns": 53
  },
  "category": "cloud",
  "domain": "dns.internal",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/hickory-dns",
    "excludes": [
      "config/**"
    ]
  },
  "compose": {
    "custom": true,
    "pre_hook": "init.sh"
  },
  "build": {
    "include_cloud_data": "true"
  },
  "containers": {
    "app": {
      "container_name": "hickory-dns",
      "image": "hickorydns/hickory-dns:latest",
      "port": 53,
      "port_env": null,
      "dns": "hickory-dns.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./config/named.toml:/etc/named.toml:ro",
        "./config/zones:/etc/zones:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M"
      },
      "read_only": false
    }
  }
}
