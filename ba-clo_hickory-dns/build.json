{
  "name": "hickory-dns",
  "description": "Internal DNS server for WireGuard mesh (per-service .app zones)",
  "dns": {
    "zones": [
      "app",
      "db",
      "diegonmarcos.com"
    ],
    "forwarders": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "_records_doc": "Per-zone specific A records emitted BEFORE the wildcard so they win over the catch-all `* IN A <caddy_wg_ip>`. Points WG-mesh clients at the right backend VM in the Phase-4 split-edge topology — Caddy L4 on oci-analytics (10.0.0.4) only handles external TLS termination; internal mesh clients (mail-mcp, reports) want Maddy/Stalwart directly on oci-mail (10.0.0.3).",
    "records": {
      "diegonmarcos.com": [
        { "name": "mail",          "type": "A", "value": "10.0.0.3" },
        { "name": "imap",          "type": "A", "value": "10.0.0.3" },
        { "name": "smtps",         "type": "A", "value": "10.0.0.3" },
        { "name": "smtp",          "type": "A", "value": "10.0.0.3" },
        { "name": "imap-stalwart", "type": "A", "value": "10.0.0.3" },
        { "name": "smtps-stalwart","type": "A", "value": "10.0.0.3" },
        { "name": "mail-stalwart", "type": "A", "value": "10.0.0.3" },
        { "name": "jmap",          "type": "A", "value": "10.0.0.3" }
      ],
      "app": [
        { "name": "maddy",         "type": "A", "value": "10.0.0.3" },
        { "name": "stalwart",      "type": "A", "value": "10.0.0.3" }
      ]
    }
  },
  "ports": {
    "dns": 53
  },
  "category": "cloud",
  "domain": "dns.internal",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/hickory-dns",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "containers": {
    "app": {
      "container_name": "hickory-dns",
      "image": "hickorydns/hickory-dns:latest",
      "port": 53,
      "port_env": null,
      "dns": "hickory-dns.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./named.toml:/etc/named.toml:ro",
        "./zones:/etc/zones:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M"
      },
      "read_only": false,
      "protocol": "udp"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "hickory-dns",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  }
}
