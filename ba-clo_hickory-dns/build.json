{
  "name": "hickory-dns",
  "description": "Internal DNS server for WireGuard mesh (per-service .app zones)",
  "dns": {
    "zones": [
      "app",
      "db"
    ],
    "forwarders": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "ports": {
    "dns": 53
  },
  "category": "cloud",
  "domain": "dns.internal",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/hickory-dns",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true
  },
  "build": {
    "include_cloud_data": "true"
  },
  "containers": {
    "app": {
      "container_name": "hickory-dns",
      "image": "hickorydns/hickory-dns:latest",
      "port": 53,
      "port_env": null,
      "dns": "hickory-dns.app",
      "public": false,
      "proxy": null,
      "healthcheck": null,
      "monitoring": null,
      "volumes": [
        "./named.toml:/etc/named.toml:ro",
        "./zones:/etc/zones:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M"
      },
      "read_only": false,
      "protocol": "udp"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "hickory-dns",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  }
}
