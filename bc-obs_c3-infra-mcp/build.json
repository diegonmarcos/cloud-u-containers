{
  "name": "c3-infra-mcp",
  "description": "C3 MCP Server — Cloud Control Center MCP transport (stdio + HTTP)",
  "port": 3100,
  "dns": "c3-infra-mcp.app",
  "category": "sec",
  "domain": "mcp.diegonmarcos.com/c3-infra-mcp",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-infra-mcp",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/c3-infra-mcp"
  },
  "build": {
    "include_cloud_data": "true"
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "auth": "two_factor",
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/c3-infra-mcp"
    },
    "app_hub": false
  },
  "health": {
    "path": "/mcp"
  }
}
