{
  "_desc": "Matomo -> Umami historical data migration. Data-driven config — never edit the scripts; edit these values only.",
  "source": {
    "service": "matomo",
    "container": "matomo-hybrid",
    "db": {
      "engine": "mariadb",
      "database": "matomo",
      "user": "matomo",
      "password_env": "MATOMO_DB_PASSWORD",
      "table_prefix": "matomo_"
    }
  },
  "target": {
    "service": "umami",
    "container": "umami-db",
    "db": {
      "engine": "postgres",
      "database": "umami",
      "user": "umami",
      "password_env": "DB_PASSWORD"
    },
    "website_id": "937cbde7-5ec2-450c-9d6a-8117423ac12f",
    "hostname": "diegonmarcos.com"
  },
  "strategy": {
    "date_from": "2024-01-01",
    "date_to": "2026-12-31",
    "batch_size": 500,
    "dedupe_key": "matomo_idvisit_idaction_url_server_time"
  },
  "test": {
    "tolerance_pct": 5,
    "tolerance_reason": "Matomo and Umami count bots/spam differently; 5% drift is acceptable."
  }
}
