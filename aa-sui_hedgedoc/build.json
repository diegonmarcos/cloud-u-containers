{
  "name": "hedgedoc",
  "description": "Collaborative markdown editor",
  "category": "app",
  "domain": "doc.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/hedgedoc"
  },
  "proxy": {
    "upstream": "hedgedoc.app:3018",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/hedgedoc"
  },
  "ports": {
    "app": 3018,
    "db": 5439
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
