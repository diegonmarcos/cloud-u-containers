{
  "name": "ntfy",
  "description": "Push notification server",
  "port": 8090,
  "dns": "ntfy.app",
  "category": "tools",
  "domain": "rss.diegonmarcos.com",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/ntfy",
    "excludes": [
      "cache"
    ]
  },
  "proxy": {
    "primary": {
      "domain": "rss.diegonmarcos.com",
      "auth": "ntfy-3tier"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
