{
  "name": "ntfy",
  "description": "Push notification server",
  "category": "tools",
  "domain": "rss.diegonmarcos.com",
  "deploy": {
    "host": "gcp-proxy",
    "remote_path": "/opt/containers/ntfy",
    "excludes": [
      "cache"
    ]
  },
  "proxy": {
    "upstream": "ntfy.app:8090",
    "auth": "ntfy-3tier"
  }
}
