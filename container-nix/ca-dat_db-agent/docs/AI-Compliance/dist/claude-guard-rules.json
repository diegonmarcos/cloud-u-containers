  {"id":11, "tool":"Edit|Write", "field":"file_path", "pattern":"\\.claude/settings\\.json$",                           "level":"critical_block", "message":"Edit source at ~/git/unix/.../dotfiles/claude/settings.json, then build.sh switch"},
