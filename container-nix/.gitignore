# Nix build outputs
result
result-*
**/.result

# Deploy staging directories
.deploy-*
.tmp-*

# Decrypted secrets (NEVER commit)
# Security model:
#   - secrets.yaml (encrypted with SOPS/age) → safe to commit
#   - .secrets (plaintext, generated at deploy) → NEVER commit
#   - .env also ignored to prevent docker-compose auto-loading issues
.env
*/.env
**/.env
.env.*
**/.env.*
*.env.deploy
.secrets
*/.secrets
**/.secrets

# Terraform state (contains secrets)
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.template

# Node
node_modules/
package-lock.json

# Editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
