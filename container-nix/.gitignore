# Nix build outputs
result
result-*

# Deploy staging directories
.deploy-*
.tmp-*

# Decrypted secrets (NEVER commit)
# Security model:
#   - secrets.yaml (encrypted with SOPS/age) → safe to commit
#   - .env (plaintext, generated at deploy) → NEVER commit
.env
*/.env
**/.env
.env.*
**/.env.*
*.env.deploy

# Terraform state (contains secrets)
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.template

# Editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
