# Runtime-only image — built on VM from pre-compiled binary
# Base layers are cached; only the COPY layer changes per deploy
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client curl iputils-ping ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN useradd -m -u 1000 appuser

COPY rust-api-binary /app/rust-api
RUN chown appuser:appuser /app/rust-api && chmod +x /app/rust-api

USER appuser

ENV RUST_API_PORT=8080
ENV RUST_LOG=rust_api=info

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=5s \
    CMD curl -f http://localhost:8080/rust/health || exit 1

CMD ["/app/rust-api"]
