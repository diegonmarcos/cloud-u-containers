{
  "name": "cloud-spec",
  "description": "Unified Cloud Documentation Portal",
  "dns": "c3-spec.app",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-spec",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "cloud.diegonmarcos.com",
      "base_path": "/spec",
      "auth": "two_factor"
    },
    "app_hub": false
  },
  "ports": {
    "app": 3080
  },
  "containers": {
    "app": {
      "container_name": "cloud-spec",
      "image": "busybox:latest",
      "port": 3080,
      "port_env": null,
      "dns": "c3-spec.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "cloud.diegonmarcos.com",
        "base_path": "/spec",
        "auth": "two_factor"
      },
      "healthcheck": null,
      "volumes": [
        "./site:/srv:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "cloud-spec",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "from_image": "busybox:latest"
  },
  "runtime": {
    "_doc_command": "busybox httpd -p HOST:PORT — %WG_IP% substituted by compose.nix from container.bind_host (data-driven from cloud-data resolveBindHost). Keeps host-net listener off 0.0.0.0.",
    "command": "busybox httpd -f -p %WG_IP%:%PORT% -h /srv"
  },
  "build": {
    "headers_enforced": true
  }
}
