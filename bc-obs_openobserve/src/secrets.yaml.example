# OpenObserve secrets schema (plaintext example — DO NOT COMMIT REAL VALUES)
#
# To create the encrypted secrets.yaml, copy this file and fill in real
# values, then sops-encrypt in place:
#
#   cd a_solutions/bc-obs_openobserve/src
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml         # fill in real values
#   sops --encrypt --in-place secrets.yaml
#
# The repo-root .sops.yaml `creation_rules` matches `secrets\.yaml$` and
# encrypts to Diego's age recipient automatically.
#
# Schema: a_solutions/_shared/secrets-schema.md
# Engine wiring: a_solutions/_shared/engine.nix:97-110
#   - .secrets             KEY=VALUE dotenv (env_file in compose)
#   - .secrets.d/<KEY>     mode 0600 per-key files
#   - .secrets.json        single JSON object with all keys

# Bootstrap admin user — OpenObserve creates this on first start.
# Reuse Diego's email; password is the OO web-UI login.
ZO_ROOT_USER_EMAIL: "REPLACE_WITH_EMAIL"
ZO_ROOT_USER_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN"

# Bearer token used by ingest clients (Vector, browser RUM, CLI curls).
# Initially the same as the admin user's auto-issued token; should be
# rotated post-deploy via the OO admin API to an org-scoped write-only
# token, then updated in this sops file. See post-deploy.sh (TODO).
ZO_INGEST_TOKEN: "REPLACE_WITH_BEARER_TOKEN"

# Human-reference metadata — engines filter `_`-prefix top-level keys;
# never reaches the VM. Pairs each KEY=VALUE secret with its origin.
_credentials:
  oo_admin:
    type: password
    url: https://grafana.diegonmarcos.com
    username: me@diegonmarcos.com
    password: REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN
    note: "pairs with ZO_ROOT_USER_PASSWORD; bootstraps admin on first start"
  oo_ingest:
    type: apikey
    url: https://grafana.diegonmarcos.com/api/default
    token: REPLACE_WITH_BEARER_TOKEN
    note: "pairs with ZO_INGEST_TOKEN; rotate to org-scoped write-only token after first start"
