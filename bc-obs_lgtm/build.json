{
  "name": "lgtm",
  "description": "LGTM observability stack (Grafana, Loki, Tempo, Mimir) (NEW - not deployed yet)",
  "category": "tools",
  "domain": "grafana.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/lgtm"
  },
  "proxy": {
    "upstream": "grafana.app:3016",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "app.diegonmarcos.com",
    "base_path": "/grafana"
  },
  "ports": {
    "grafana": 3200,
    "loki": 3110,
    "mimir": 9009,
    "tempo": 3200
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
