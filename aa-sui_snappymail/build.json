{
  "name": "snappymail",
  "description": "SnappyMail webmail client (mail.diegonmarcos.com/webmail)",
  "dns": "snappymail.app",
  "ports": {
    "app": 8888
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "webmail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/snappymail",
    "excludes": [
      "data/**"
    ],
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "init.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "snappymail",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "primary": {
      "domain": "webmail.diegonmarcos.com",
      "auth": "two_factor"
    },
    "mail_hub": {
      "parent_domain": "mail.diegonmarcos.com",
      "base_path": "/snappy",
      "auth": "two_factor",
      "error_redirect": "/",
      "asset_paths": [
        "/snappymail"
      ]
    }
  },
  "containers": {
    "app": {
      "container_name": "snappymail",
      "image": "djmaze/snappymail:latest",
      "port": 8888,
      "port_env": null,
      "dns": "snappymail.app",
      "public": true,
      "proxy": {
        "domain": "webmail.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/",
      "monitoring": null,
      "volumes": [
        "./data:/var/lib/snappymail"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M",
        "mem_reservation": "16M"
      },
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "files",
          "path": "/var/lib/snappymail"
        }
      ]
    }
  },
  "upstream_image": "djmaze/snappymail:latest",
  "resources": {
    "mem_limit": "64M",
    "mem_reservation": "16M"
  }
}
