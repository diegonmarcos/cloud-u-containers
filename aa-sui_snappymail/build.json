{
  "name": "snappymail",
  "description": "SnappyMail webmail client (mail.diegonmarcos.com/webmail)",
  "dns": "snappymail.app",
  "ports": {
    "app": 8888
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "webmail.diegonmarcos.com",
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/snappymail",
    "excludes": [
      "data/**"
    ],
    "compose_flags": "--build"
  },
  "compose": {
    "custom": true,
    "pre_hook": "init.sh"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "snappymail",
    "dockerfile": "Dockerfile",
    "arch": "amd64"
  },
  "proxy": {
    "primary": {
      "domain": "webmail.diegonmarcos.com",
      "auth": "two_factor",
      "landing_page": "mymail"
    }
  },
  "containers": {
    "app": {
      "container_name": "snappymail",
      "image": "djmaze/snappymail:latest",
      "port": 8888,
      "port_env": null,
      "dns": "snappymail.app",
      "public": true,
      "proxy": {
        "domain": "webmail.diegonmarcos.com",
        "auth": "two_factor",
        "landing_page": "mymail"
      },
      "healthcheck": "/",
      "monitoring": null,
      "volumes": [
        "./data:/var/lib/snappymail"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": {
        "mem_limit": "64M",
        "mem_reservation": "16M"
      },
      "read_only": false,
      "protocol": "http"
    }
  }
}
