{
  "name": "snappymail",
  "description": "SnappyMail webmail client (mail.diegonmarcos.com/webmail)",
  "category": "app",
  "domain": "webmail.diegonmarcos.com",
  "ports": {
    "app": 8888
  },
  "deploy": {
    "host": "oci-mail",
    "remote_path": "/opt/containers/snappymail",
    "excludes": ["data/**"]
  },
  "compose": {
    "pre_hook": "init.sh"
  },
  "proxy": {
    "upstream": "snappymail.app:8888",
    "auth": "two_factor",
    "landing_page": "mymail"
  }
}
