{
  "name": "fincept-rs",
  "description": "Fincept Terminal — pure Rust port. Single-binary financial intelligence platform (egui UI, tokio runtime, polars/ndarray analytics, rig-based LLM agents, MCP tool surface).",
  "category": "fin",
  "license": "AGPL-3.0-or-later",
  "upstream": {
    "repo": "https://github.com/Fincept-Corporation/FinceptTerminal",
    "local_path": "../FinceptTerminal",
    "feature_parity_version": "v4.0.2"
  },
  "binary": {
    "name": "fincept",
    "crate": "app"
  },
  "build": {
    "profile": "release",
    "features": [],
    "strip": true
  },
  "test": {
    "workspace": true,
    "parity_dir": "tests/parity",
    "e2e_dir": "tests/e2e",
    "coverage_gate": {
      "enforce_modules_json": true,
      "min_coverage": 70
    }
  },
  "lint": {
    "rustfmt": true,
    "clippy_deny_warnings": true
  },
  "packaging": {
    "linux": {
      "enabled": true,
      "format": "appimage",
      "recipe": "packaging/linux/AppImageBuilder.yml"
    },
    "macos": {
      "enabled": true,
      "format": "dmg",
      "bundle_id": "com.fincept.terminal-rs",
      "deploy_target": "11.0"
    },
    "windows": {
      "enabled": true,
      "format": "nsis",
      "recipe": "packaging/windows/installer.nsi"
    }
  },
  "registry": {
    "modules_json": "modules.json"
  },
  "phase": {
    "current": 10,
    "target": 10,
    "tracker": "docs/MIGRATION.md"
  },
  "secrets": {
    "src": "src/secrets.yaml",
    "dist": "dist/.secrets",
    "escape_dollars": false
  }
}
