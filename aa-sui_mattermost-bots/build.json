{
  "name": "mattermost-bots",
  "description": "Mattermost team chat with ntfy bridge and C3 command bot",
  "category": "app",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/mattermost-bots"
  },
  "compose": {
    "pre_hook": "init-dirs.sh"
  },
  "proxy": {
    "upstream": "mattermost.app:8065",
    "auth": "two_factor",
    "paths": {
      "/api/v4/*": {
        "auth": "bypass"
      }
    }
  },
  "health": {
    "path": "/api/v4/system/ping"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": ["mattermost_data", "mattermost_postgres"]
  }
}
