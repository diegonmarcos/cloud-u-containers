{
  "name": "photos-webhook",
  "description": "PhotoPrism Webhook + S3 Processor",
  "port": 5002,
  "dns": "photos-webhook.app",
  "category": "app",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "photos-webhook",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "type": "app",
      "cmd": "pip install --target=.deps -r requirements.txt",
      "entrypoint": "python webhook.py flask",
      "base_image": "python:3.12-slim",
      "apt": "postgresql-client curl",
      "env": "PYTHONPATH=/app/.deps"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/photos-webhook"
  },
  "backup": {
    "enabled": true
  },
  "containers": {}
}
