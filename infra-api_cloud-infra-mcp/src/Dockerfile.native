FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssh-client iputils-ping curl git python3 python3-pip build-essential dnsutils openssl netcat-openbsd && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY code /app
COPY build.json /app/build.json
RUN A=$(dpkg --print-architecture) && case $A in arm64) S=39f23e7c55ce2c2e502a0b3e070b978bf69135b19246b5b7581dadb94cf2144d;; amd64) S=ea2c9bb2d5017a796b64bf36e605d727accf76a5500014bb12952ce11ae1f932;; *) echo "cloudflared: unsupported arch $A"; exit 1;; esac && curl -fsSL -o /usr/local/bin/cloudflared https://github.com/cloudflare/cloudflared/releases/download/2026.9.2/cloudflared-linux-$A && echo "$S  /usr/local/bin/cloudflared" | sha256sum -c - && chmod 0755 /usr/local/bin/cloudflared && cloudflared --version && pip install --break-system-packages --no-cache-dir oci-cli awscli && npm ci --omit=dev && npm install tsx && ./node_modules/.bin/wrangler --version



LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud-infra"
CMD ["./entrypoint.sh"]
