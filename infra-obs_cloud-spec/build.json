{
  "name": "cloud-spec",
  "description": "Unified Cloud Documentation Portal",
  "dns": "c3-spec.app",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-spec",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "cloud.diegonmarcos.com",
      "base_path": "/spec",
      "auth": "two_factor",
      "extra_paths": [
        {
          "base_path": "/probe",
          "upstream_service": "c3-services-api"
        }
      ]
    },
    "app_hub": false
  },
  "ports": {
    "app": 3080
  },
  "containers": {
    "app": {
      "container_name": "cloud-spec",
      "image": "busybox:latest",
      "port": 3080,
      "port_env": null,
      "dns": "c3-spec.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "cloud.diegonmarcos.com",
        "base_path": "/spec",
        "auth": "two_factor"
      },
      "healthcheck": null,
      "volumes": [
        "./site:/srv:ro"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "cloud-spec",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "from_image": "busybox:latest"
  },
  "runtime": {
    "command": "busybox httpd -f -p %PORT% -h /srv"
  },
  "build": {
    "headers_enforced": true,
    "_deref_comment": "cloud-data.json is PATH-INTERPOLATED in flake.nix (DATA=${./cloud-data.json}) — nix interns that single symlink verbatim (dangling in store), so the engine must dereference src symlinks pre-build. Only services with path-interpolated external symlinks need this.",
    "dereference_symlinks": true
  }
}
