{
  "name": "backup-borg",
  "enabled": false,
  "description": "Media Backups SSH Server (Borg deduplication)",
  "category": "data",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/backup-borg",
    "compose_flags": "--build"
  },
  "ports": {
    "app": 2224
  },
  "containers": {
    "app": {
      "container_name": "borg-server",
      "port": 2224
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "backup-borg",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  }
}
