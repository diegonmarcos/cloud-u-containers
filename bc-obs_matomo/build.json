{
  "name": "matomo",
  "description": "Matomo hybrid analytics (oci-apps)",
  "dns": "matomo.app",
  "category": "tools",
  "build": {
    "include_cloud_data": "true"
  },
  "domain": "analytics.diegonmarcos.com",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "matomo-hybrid",
    "dockerfile": "matomo-hybrid/Dockerfile",
    "arch": "arm64"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/matomo",
    "compose_flags": "--pull always --force-recreate"
  },
  "compose": {
    "custom": true
  },
  "lifecycle": {},
  "proxy": {
    "primary": {
      "domain": "analytics.diegonmarcos.com",
      "auth": "two_factor",
      "paths": {
        "/matomo.js": {
          "auth": "public"
        },
        "/matomo.php": {
          "auth": "public"
        },
        "/piwik.js": {
          "auth": "public"
        },
        "/piwik.php": {
          "auth": "public"
        },
        "/collect.php": {
          "auth": "public"
        },
        "/api.php": {
          "auth": "public"
        },
        "/track.php": {
          "auth": "public"
        },
        "/js/*": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "matomo_data"
    ]
  },
  "containers": {
    "app": {
      "container_name": "matomo-hybrid",
      "image": null,
      "port": 8084,
      "extra_ports": [
        {
          "port": 3306,
          "protocol": "tcp"
        }
      ],
      "port_env": null,
      "dns": "matomo.app",
      "public": true,
      "proxy": {
        "domain": "analytics.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "matomo_matomo_data:/var/www/html",
        "matomo_matomo_db:/var/lib/mysql",
        "matomo_inbox:/inbox"
      ],
      "env_file": false,
      "resources": {
        "limits": {
          "memory": "1024M"
        },
        "reservations": {
          "memory": "64M"
        }
      },
      "read_only": false,
      "dump_cmd": "mysqldump -u matomo matomo",
      "protocol": "http"
    }
  }
}
