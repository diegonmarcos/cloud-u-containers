{
    # Disable auto-HTTPS — this is pure TCP relay, no TLS termination.
    auto_https off
    # Admin API off — no remote control needed for a stateless relay.
    admin off

    layer4 {
        # Public 0.0.0.0:443 ingress for the cloud.
        # oci-analytics is the single public-edge VM; gcp-proxy is fully
        # private (only 51820/udp WG handshake exposed).
        :443 {
            # SNI allowlist: *.diegonmarcos.com subdomains AND the apex.
            # Apex (no leading label) matters for RFC 8620 §2.2 JMAP
            # autoconfig — clients given `me@diegonmarcos.com` look up
            # `https://diegonmarcos.com/.well-known/jmap` and need TLS to
            # complete. The matching apex well_known route is declared in
            # aa-sui_tools-stalwart/build.json::containers.app.proxy.
            # well_known (target_domain: diegonmarcos.com). Without apex
            # here the L4 relay closes the TCP connection before TLS and
            # the autoconfig URL returns SSL_ERROR_SYSCALL.
            # Any other SNI (random scans, mis-resolved CDN, etc.) falls
            # through to no route and gets a TCP RST.
            @sni_diegonmarcos tls sni *.diegonmarcos.com diegonmarcos.com
            route @sni_diegonmarcos {
                # TCP-relay to the gcp-proxy Caddy edge via wg-public.
                # wg-public mesh layout (cloud-data.native.wg_public.peers):
                #   10.1.0.1 = oci-analytics (hub — THIS box; relaying here loops)
                #   10.1.0.2 = gcp-proxy (spoke — Caddy edge, TLS termination)
                #   10.1.0.3 = oci-mail, 10.1.0.4 = oci-apps
                # gcp-proxy at 10.1.0.2:443 owns TLS termination + all
                # path / authelia / forward_auth routing for the whole
                # service catalogue (gitea, vault, api, etc.).
                proxy {
                    upstream 10.1.0.2:443
                }
            }
            # No fallback. Unmatched SNI = TCP closed.
        }

        # ─── Mail protocols: public ingress for Stalwart on oci-mail ───
        # Stalwart listens on non-standard internal ports (2025/2465/2587/
        # 2993/6190 over wg-public 10.1.0.3) so the host's :25/:465/etc.
        # stay free for the public L4 relay. mail.diegonmarcos.com DNS →
        # oci-analytics (this VM); we proxy each well-known mail port to
        # Stalwart's bound port on the wg-public mesh.
        # 2026-06-10: was missing entirely — external clients hit RST on
        # every mail protocol despite Stalwart being up and healthy.
        :25 {
            route {
                proxy {
                    upstream 10.1.0.3:2025
                }
            }
        }
        :465 {
            route {
                proxy {
                    upstream 10.1.0.3:2465
                }
            }
        }
        :993 {
            route {
                proxy {
                    upstream 10.1.0.3:2993
                }
            }
        }
        :4190 {
            route {
                proxy {
                    upstream 10.1.0.3:6190
                }
            }
        }
    }
}
