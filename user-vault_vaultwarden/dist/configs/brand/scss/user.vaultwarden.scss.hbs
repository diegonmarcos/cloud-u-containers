/**** Cloud Vault brand (user.vaultwarden.scss) ****/
/* Own identity so this vault cannot be mistaken for anyone's public Vaultwarden.
   Accent #00BFA5 on #0A0A0A, same padlock mark as the Cloud Vault Android app. */

/* Accent colour: replaces the Bitwarden blue primary scale on every theme. */
html, html.theme_light {
  --color-primary-100: 224 242 241;
  --color-primary-300: 0 150 136;
  --color-primary-600: 0 121 107;
  --color-primary-700: 0 96 85;
}
html.theme_dark, html.theme_nord, html.theme_solarizedDark {
  --color-primary-100: 0 60 52;
  --color-primary-300: 0 150 136;
  --color-primary-600: 0 191 165;
  --color-primary-700: 128 222 205;
}

/* Permanent identity bar on every web vault page: login, unlock, vault, settings. */
body::before {
  content: "Cloud Vault";
  display: block;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 30px;
  z-index: 2147483000;
  background: #0A0A0A;
  color: #00BFA5;
  border-bottom: 2px solid #00BFA5;
  font: 700 14px/28px "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: 0.12em;
  text-align: center;
  pointer-events: none;
}
body {
  padding-top: 32px;
  box-sizing: border-box;
}

/* Logo shown on the login/landing pages (images/logo*.svg are replaced at boot). */
.new-logo-themed {
  background-size: contain;
  background-repeat: no-repeat;
}

/* Collapsed navigation icon: Cloud Vault padlock instead of the upstream shield. */
bit-nav-logo bit-nav-item a:before {
  background-image: url("../images/cloud-vault.svg");
}

/* Hide upstream-branded footer/about links that point at other projects. */
a[href*="github.com/dani-garcia"],
a[href*="bitwarden.com"] {
  display: none !important;
}
/**** END Cloud Vault brand ****/
