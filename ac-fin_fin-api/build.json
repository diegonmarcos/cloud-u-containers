{
  "name": "fin-api",
  "description": "Fincept Terminal backend (fin-api) — REST + WebSocket over DataHub, 35 data connectors, 7 analytics, 17 brokers, 6 investor personas, MCP tools",
  "dns": "fin-api.app",
  "ports": {
    "app": 8340
  },
  "category": "fin",
  "domain": "api.diegonmarcos.com/fin-api",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/fin-api",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": false
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/fin-api",
      "auth": "two_factor",
      "paths": {
        "/health": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/fin-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": false
  },
  "containers": {
    "app": {
      "container_name": "fin-api",
      "image": "ghcr.io/diegonmarcos/fin-api:latest",
      "port": 8340,
      "port_env": "FIN_API_PORT",
      "dns": "fin-api.app",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/fin-api",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [],
      "env_file": false,
      "resources": {
        "limits": {
          "memory": "512M",
          "cpus": "1"
        },
        "reservations": {
          "memory": "128M"
        }
      },
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "fin-api",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "cmd": "cargo build --release --bin fin-api",
      "binary": "target/release/fin-api",
      "base_image": "debian:bookworm-slim",
      "apt": "ca-certificates libssl3 curl",
      "app_dir": "code"
    }
  },
  "build": {
    "headers_enforced": true
  }
}
