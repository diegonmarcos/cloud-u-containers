{
  "name": "code-server",
  "description": "VS Code IDE (ide.diegonmarcos.com)",
  "dns": "code-server.app",
  "ports": {
    "app": 8444
  },
  "category": "app",
  "domain": "ide.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/code-server"
  },
  "proxy": {
    "primary": {
      "domain": "ide.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "code-server",
      "image": "linuxserver/code-server:latest",
      "port": 8444,
      "port_env": null,
      "dns": "code-server.app",
      "public": true,
      "proxy": {
        "domain": "ide.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./config:/config",
        "/home/ubuntu/workspace:/workspace"
      ],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false
    }
  }
}
