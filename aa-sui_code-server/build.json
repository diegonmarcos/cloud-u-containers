{
  "name": "code-server",
  "description": "VS Code IDE (ide.diegonmarcos.com)",
  "ports": {
    "app": 8443
  },
  "category": "app",
  "domain": "ide.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/code-server"
  },
  "proxy": {
    "upstream": "code-server.app:8443",
    "auth": "two_factor"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
