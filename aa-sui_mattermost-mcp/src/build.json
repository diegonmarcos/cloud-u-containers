{
  "name": "mattermost-mcp",
  "description": "Mattermost MCP server \u2014 chat tools via HTTP transport",
  "dns": "mattermost-mcp.app",
  "category": "app",
  "docker": {
    "image": "mattermost-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/mattermost-mcp"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/mattermost-mcp"
    },
    "app_hub": false
  },
  "ports": {
    "app": 3102
  }
}
