{
  "name": "c3-public-api",
  "enabled": true,
  "description": "C3 Public API — single public-edge listener on oci-analytics. Consolidates http-to-smtp-proxy-api (Bearer-gated /mail/*) and c3-analytics-api passthrough (public /analytics/*). Replaces split listeners across gcp-proxy + oci-analytics so gcp-proxy becomes a pure wg0 spoke.",
  "dns": "c3-public-api.app",
  "ports": {
    "app": 8087
  },
  "category": "obs",
  "domain": "api.diegonmarcos.com/c3-public-api",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "c3-public-api",
    "dockerfile": "Dockerfile",
    "arch": "amd64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates curl",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "/opt/containers/c3-public-api",
    "compose_flags": "--build"
  },
  "proxy": {
    "_doc": "Mixed-auth service. Default = Bearer-gated via introspect-proxy (same as c3-infra-api write routes). The /analytics/* and /health, /ready sub-paths are public — declared via paths.{} carve-outs so Caddy's forward_auth skips them. Mirrors the c3-infra-api primary.paths pattern (which carves out /docs/json as auth=public).",
    "primary": {
      "auth": "two_factor",
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/c3-public-api",
      "paths": {
        "/health": { "auth": "public" },
        "/ready": { "auth": "public" },
        "/analytics/": { "auth": "public" }
      }
    }
  },
  "health": {
    "path": "/c3-public-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "c3-public-api",
      "image": "ghcr.io/diegonmarcos/c3-public-api:latest",
      "port": 8087,
      "port_env": "PORT",
      "dns": "c3-public-api.app",
      "public": true,
      "proxy": {
        "auth": "two_factor",
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/c3-public-api",
        "paths": {
          "/health": { "auth": "public" },
          "/ready": { "auth": "public" },
          "/analytics/": { "auth": "public" }
        }
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "mail": {
    "_doc": "JSON-in -> SMTP-out: replicates the aa-sui_tools-http-to-smtp-proxy-api Rust binary contract so the CF Worker does not need any change. Primary delivery to Maddy:25 (MX-style, plain SMTP over WG); shadow delivery to Stalwart:2025 (STARTTLS-capable, fire-and-forget so JMAP clients see the same mail).",
    "primary": {
      "service": "maddy",
      "via": "smtp_mx"
    },
    "shadow": {
      "service": "stalwart",
      "via": "smtp_shadow"
    },
    "helo_domain": "c3-public-api.diegonmarcos.com",
    "default_user_env": "SMTP_USER"
  },
  "backends": {
    "matomo": {
      "service": "matomo",
      "rewrite_path": "/matomo.php",
      "description": "Matomo Tracking API",
      "methods": ["GET", "POST"]
    },
    "umami": {
      "service": "umami",
      "rewrite_path": "/api/send",
      "description": "Umami /api/send",
      "methods": ["POST"]
    },
    "openobserve": {
      "service": "openobserve",
      "rewrite_path": "/api/default/default/_json",
      "description": "OpenObserve _json bulk ingest",
      "methods": ["POST"],
      "auth_header_env": "OPENOBSERVE_AUTHORIZATION"
    }
  },
  "limits": {
    "max_body_bytes": 1048576,
    "max_ingest_lines": 5000,
    "rate_per_ip_per_min": 60,
    "rate_per_sid_per_min": 1000,
    "request_timeout_ms": 5000
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/c3-public-api",
    "endpoint_count": 5,
    "display_name": "C3 Public API",
    "description": "Single public-edge API on oci-analytics. /mail/http-to-smtp (Bearer) bridges CF Worker -> Maddy + Stalwart over WG. /analytics/{matomo|umami|openobserve}/* (public) passes through to first-party analytics backends.",
    "auth": "mixed"
  }
}
