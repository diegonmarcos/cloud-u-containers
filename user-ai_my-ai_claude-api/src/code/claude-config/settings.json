{
  "permissions": {
    "_doc": "2026-09-06: mirrors the fleet SoT decision (cloud-u-linux ae77a8f 'pre-approve the control plane'). Headless `claude -p` cannot answer permission prompts — every unlisted tool call is silently DENIED, which left the 15-agent runner able to read but not write (verified live: Write to /tmp refused). Allow rules bypass the prompt entirely, so the runner gets exactly the control plane: shell, file tools, and the seven MCP servers render-mcp.mjs writes from mcp.tpl.json. NOT --dangerously-skip-permissions: deny rules and hooks (c-pretool-guard-*) stay in force.",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "mcp__cloud-infra",
      "mcp__cloud-cgc-pub-mcp",
      "mcp__cloud-services",
      "mcp__mattermost",
      "mcp__cloud-mail-mcp",
      "mcp__google-workspace",
      "mcp__google-personal"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/a-context-inject-memory.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$HOME\"/.claude/ponytail/hooks/ponytail-activate.js",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/b-context-inject-prompt.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node \"$HOME\"/.claude/ponytail/hooks/ponytail-mode-tracker.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/c-context-inject-pretool.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/c-pretool-guard-blockers.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/c-pretool-guard-warning.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
