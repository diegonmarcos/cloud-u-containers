{
  "name": "crawlee-cloud",
  "description": "Self-hosted Crawlee Cloud — Apify-compatible scraping platform (API + Runner + Dashboard + Scheduler)",
  "ports": {
    "app": 3000,
    "dashboard": 3001,
    "db": 5433,
    "redis": 6380,
    "minio": 9000
  },
  "category": "fin",
  "domain": "api.diegonmarcos.com/crawlee/",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/crawlee-cloud"
  },
  "proxy": {
    "upstream": "crawlee.app:3000",
    "auth": "two_factor",
    "type": "path",
    "parent_domain": "api.diegonmarcos.com",
    "base_path": "/crawlee",
    "paths": {
      "/openapi.json": {
        "auth": "public"
      }
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
