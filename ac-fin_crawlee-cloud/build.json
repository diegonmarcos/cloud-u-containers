{
  "name": "crawlee-cloud",
  "description": "Self-hosted Crawlee Cloud — Apify-compatible scraping platform (API + Runner + Dashboard + Scheduler)",
  "port": 3000,
  "dns": "crawlee.app",
  "category": "fin",
  "domain": "api.diegonmarcos.com/crawlee/",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/crawlee-cloud"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/crawlee",
      "auth": "two_factor",
      "paths": {
        "/openapi.json": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  }
}
