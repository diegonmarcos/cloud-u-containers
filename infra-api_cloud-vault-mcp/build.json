{
  "name": "cloud-vault-mcp",
  "description": "MCP server — READ-ONLY personal data access (vault metadata, identity, comms, media, finance, health)",
  "dns": "vault-mcp.app",
  "category": "data",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "docker": {
    "image": "cloud-vault-mcp",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm install --omit=dev",
      "_cmd_doc": "npm install, not npm ci: this service has no committed package-lock.json.",
      "entrypoint": "node /app/node_modules/tsx/dist/cli.mjs index.ts --http",
      "base_image": "node:22-slim",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-vault-mcp",
    "compose_flags": "--build"
  },
  "proxy": {
    "primary": {
      "streaming": true,
      "type": "path",
      "parent_domain": "mcp.diegonmarcos.com",
      "base_path": "/cloud-vault-mcp",
      "wg_only": true
    },
    "app_hub": false
  },
  "ports": {
    "app": 3111
  },
  "domain": "mcp.diegonmarcos.com",
  "containers": {
    "app": {
      "container_name": "cloud-vault-mcp",
      "image": "ghcr.io/diegonmarcos/cloud-vault-mcp:latest",
      "port": 3111,
      "port_env": "PORT",
      "dns": "vault-mcp.app",
      "public": true,
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "mcp.diegonmarcos.com",
        "base_path": "/cloud-vault-mcp"
      },
      "healthcheck": null,
      "monitoring": null,
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "mcp": {
    "transport": "streamable-http",
    "endpoint_path": "/mcp",
    "tools_count": 17,
    "resources_count": 0,
    "prompts_count": 0,
    "display_name": "Cloud Vault MCP",
    "description": "READ-ONLY personal data access: vault metadata, identity docs, communications, media, finance, health (redacted).",
    "auth": "none",
    "sdk": "@modelcontextprotocol/sdk@^1.12.0"
  }
}
